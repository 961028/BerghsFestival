---
import Layout from "../layouts/Layout.astro";

import type { CollectionEntry } from "astro:content";
import { z } from "astro/zod";
import { reference } from "astro:content";

import WpImage from "../components/elements/WpImage.astro";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const ScheduleSchema = z.array(
    z.object({
        day: z.string(),
        events: z.array(
            z
                .object({
                    start_time: z.string(),
                    title: z.string(),
                    image: z.preprocess(
                        (v) => (v === false || v === 0 ? null : v),
                        z.coerce
                            .string()
                            .nullable()
                            .transform((v) =>
                                v ? reference("media").nullable().parse(v) : null,
                            ),
                    ),
                    description: z.string().nullable().optional(),
                })
                .transform((data) => ({
                    startTime: data.start_time,
                    title: data.title,
                    image: data.image ?? null,
                    description: data.description ?? null,
                })),
        ),
    }),
);

const GroupsSchema = z.array(
    z
        .object({
            title: z.string(),
            layout: z.enum(["music", "installations", "food"]),
            description: z.string().transform((val) => ({ html: val })),
            items: z.array(
                z.object({
                    name: z.string(),
                    image: z.coerce
                        .string()
                        .transform((val) =>
                            reference("media").nullable().parse(val),
                        ),
                    description: z.string().transform((val) => ({ html: val })),
                    url: z.string().optional(),
                }),
            ),
        })
        .transform((val) => ({
            ...val,
            slug: z.string().slugify().parse(val.title),
        })),
);

const { page } = Astro.props;

const { title, acf } = page;

const schedule = ScheduleSchema.parse(acf.schedule);
const groups = GroupsSchema.parse(acf.groups);

const tabs = [
    { id: "schedule", label: "Schedule" },
    ...groups.map((g) => ({ id: g.slug, label: g.title })),
];
---

<Layout title={title}>
    <h1 class="page-title">{title}</h1>

    <!-- Tab bar -->
    <nav class="tab-bar" role="tablist">
        {
            tabs.map((tab, i) => (
                <button
                    role="tab"
                    class="tab"
                    data-tab={tab.id}
                    aria-selected={i === 0 ? "true" : "false"}
                    aria-controls={`panel-${tab.id}`}
                    id={`tab-${tab.id}`}
                >
                    {tab.label}
                </button>
            ))
        }
    </nav>

    <!-- Schedule panel -->
    <section
        id="panel-schedule"
        role="tabpanel"
        aria-labelledby="tab-schedule"
        class="tab-panel"
    >
        <div class="day-toggle" role="group" aria-label="Select day">
            {
                schedule.map((dayData, i) => (
                    <button
                        class="day-pill"
                        data-day={i}
                        aria-pressed={i === 0 ? "true" : "false"}
                    >
                        {dayData.day}
                    </button>
                ))
            }
        </div>

        {
            schedule.map((dayData, dayIndex) => (
                <div class="schedule-day" data-day-panel={dayIndex}>
                    <ul class="schedule-events">
                        {dayData.events.map((event) =>
                            event.image && event.description ? (
                                <li class="schedule-row schedule-row--rich">
                                    <div class="row-divider" />
                                    <span class="row-time">{event.startTime}</span>
                                    <div class="row-body">
                                        <div class="row-text">
                                            <p class="row-artist">{event.title}</p>
                                            <p class="row-description">
                                                {event.description}
                                            </p>
                                        </div>
                                        <WpImage
                                            class="row-image"
                                            image={event.image}
                                            width={140}
                                            height={140}
                                        />
                                    </div>
                                </li>
                            ) : (
                                <li class="schedule-row schedule-row--sparse">
                                    <div class="row-divider" />
                                    <span class="row-time">{event.startTime}</span>
                                    <p class="row-title">{event.title}</p>
                                </li>
                            ),
                        )}
                    </ul>
                </div>
            ))
        }
    </section>

    <!-- Group panels (Installations, Food & drink) -->
    {
        groups.map((group) => (
            <section
                id={`panel-${group.slug}`}
                role="tabpanel"
                aria-labelledby={`tab-${group.slug}`}
                class="tab-panel"
                hidden
            >
                <div class="group-intro" set:html={group.description.html} />

                {group.layout === "music" && (
                    <ul class="music-list">
                        {group.items.map((item) => (
                            <li class="music-item">
                                {item.image && (
                                    <WpImage
                                        class="music-image"
                                        image={item.image}
                                        width={1200}
                                        height={800}
                                    />
                                )}
                                <p class="music-name">{item.name}</p>
                                <div
                                    class="music-description"
                                    set:html={item.description.html}
                                />
                            </li>
                        ))}
                    </ul>
                )}
                {group.layout === "installations" && (
                    <ul class="installations-list">
                        {group.items.map((item) => (
                            <li class="installation-item">
                                {item.image && (
                                    <WpImage
                                        class="installation-image"
                                        image={item.image}
                                        width={1200}
                                        height={600}
                                    />
                                )}
                                <p class="installation-name">{item.name}</p>
                                <div
                                    class="installation-description"
                                    set:html={item.description.html}
                                />
                            </li>
                        ))}
                    </ul>
                )}
                {group.layout === "food" && (
                    <ul class="food-grid">
                        {group.items.map((item) => (
                            <li class="food-card">
                                {item.image && (
                                    <WpImage
                                        class="food-card-image"
                                        image={item.image}
                                        width={600}
                                        height={300}
                                    />
                                )}
                                <div class="food-card-body">
                                    <p class="food-card-name">{item.name}</p>
                                    <div
                                        class="food-card-description"
                                        set:html={item.description.html}
                                    />
                                </div>
                            </li>
                        ))}
                    </ul>
                )}
            </section>
        ))
    }
</Layout>

<script>
    // Tab switching
    const tabs = document.querySelectorAll<HTMLButtonElement>("[role='tab']");
    const panels = document.querySelectorAll<HTMLElement>("[role='tabpanel']");

    function selectTab(tabId: string) {
        tabs.forEach((t) => {
            t.setAttribute("aria-selected", String(t.dataset.tab === tabId));
        });
        panels.forEach((p) => {
            p.hidden = p.id !== `panel-${tabId}`;
        });
    }

    tabs.forEach((tab) => {
        tab.addEventListener("click", () => selectTab(tab.dataset.tab!));
    });

    // Day toggle
    const dayPills = document.querySelectorAll<HTMLButtonElement>("[data-day]");
    const dayPanels =
        document.querySelectorAll<HTMLElement>("[data-day-panel]");

    function selectDay(dayIndex: number) {
        dayPills.forEach((p) => {
            p.setAttribute(
                "aria-pressed",
                String(Number(p.dataset.day) === dayIndex),
            );
        });
        dayPanels.forEach((p) => {
            p.hidden = Number(p.dataset.dayPanel) !== dayIndex;
        });
    }

    dayPills.forEach((pill) => {
        pill.addEventListener("click", () =>
            selectDay(Number(pill.dataset.day)),
        );
    });

    // Default day: Saturday (day 6) → index 1, otherwise → index 0.
    // Dev convenience: toggle by even/odd minute so both states are testable.
    const now = new Date();
    const isDevTest = true; // set to false before going to production
    const defaultDay = isDevTest
        ? now.getMinutes() % 2 === 0
            ? 0
            : 1
        : now.getDay() === 6
          ? 1
          : 0;

    selectDay(defaultDay);
</script>

<style>
    .page-title {
        font-size: var(--font-size-xxl);
        font-weight: var(--font-weight-bold);
        margin-bottom: var(--space-md);
    }

    /* Tab bar */
    .tab-bar {
        display: flex;
        border-bottom: var(--border-default);
        margin-bottom: var(--space-lg);
    }

    .tab {
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        padding: var(--space-xs) var(--space-sm);
        font-size: var(--font-size-base);
        font-family: inherit;
        cursor: pointer;
        color: var(--color-text-secondary);
        margin-bottom: -1px;
        white-space: nowrap;
    }

    .tab[aria-selected="true"] {
        font-weight: var(--font-weight-semibold);
        border-bottom-color: var(--color-text);
        color: var(--color-text);
    }

    @media (any-hover: hover) and (any-pointer: fine) {
        .tab:hover:not([aria-selected="true"]) {
            opacity: 0.7;
        }
    }

    /* Tab panels */
    .tab-panel[hidden] {
        display: none;
    }

    /* Day toggle */
    .day-toggle {
        display: flex;
        gap: var(--space-xs);
        margin-bottom: var(--space-md);
    }

    .day-pill {
        background: none;
        border: var(--border-default);
        border-radius: var(--border-radius-pill);
        padding: 0.25rem var(--space-sm);
        font-size: var(--font-size-sm);
        font-family: inherit;
        cursor: pointer;
        color: var(--color-text-secondary);
    }

    .day-pill[aria-pressed="true"] {
        background: var(--color-text);
        color: var(--color-bg);
        border-color: var(--color-text);
    }

    /* Schedule day panels */
    .schedule-day[hidden] {
        display: none;
    }

    .schedule-events {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /* Shared row */
    .schedule-row {
        position: relative;
        padding-top: var(--space-sm);
        padding-bottom: var(--space-sm);
    }

    .row-divider {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 0;
        border-top: 0.5px solid var(--color-border);
    }

    .row-time {
        position: absolute;
        top: -0.6em;
        left: 0;
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-semibold);
        color: var(--color-text-secondary);
        background: var(--color-bg);
        padding-right: 0.625rem;
        line-height: 1.2;
    }

    /* Sparse row */
    .schedule-row--sparse .row-title {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-semibold);
        margin: 0.5rem 0 0;
    }

    /* Rich row */
    .schedule-row--rich .row-body {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
        margin-top: 0.5rem;
    }

    .row-text {
        flex: 1;
    }

    .row-artist {
        font-size: var(--font-size-md);
        font-weight: var(--font-weight-semibold);
        margin: 0 0 0.375rem;
    }

    .row-description {
        font-size: var(--font-size-sm);
        color: var(--color-text-secondary);
        line-height: 1.5;
        margin: 0;
    }

    .row-image {
        flex-shrink: 0;
        width: 140px;
        height: 140px;
        object-fit: cover;
        border-radius: var(--border-radius-lg);
        display: block;
    }

    /* Group intro */
    .group-intro {
        font-size: var(--font-size-sm);
        color: var(--color-text-secondary);
        max-width: 40rem;
        margin-bottom: var(--space-md);
    }

    /* Installations */
    .installations-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }

    .installation-image {
        display: block;
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-radius: var(--border-radius-lg);
    }

    .installation-name {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-semibold);
        margin: 0.5rem 0 0.25rem;
    }

    .installation-description {
        font-size: var(--font-size-xs);
        color: var(--color-text-secondary);
        margin: 0;
    }

    /* Music */
    .music-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }

    .music-image {
        display: block;
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-radius: var(--border-radius-lg);
    }

    .music-name {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-semibold);
        margin: 0.5rem 0 0.25rem;
    }

    .music-description {
        font-size: var(--font-size-xs);
        color: var(--color-text-secondary);
        margin: 0;
    }

    /* Food & drink */
    .food-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
    }

    .food-card {
        border: 0.5px solid var(--color-border);
        border-radius: var(--border-radius-lg);
        overflow: hidden;
    }

    .food-card-image {
        display: block;
        width: 100%;
        height: 100px;
        object-fit: cover;
    }

    .food-card-body {
        padding: 0.625rem;
    }

    .food-card-name {
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
        margin: 0 0 0.25rem;
    }

    .food-card-description {
        font-size: var(--font-size-xs);
        color: var(--color-text-secondary);
        margin: 0;
    }
</style>
