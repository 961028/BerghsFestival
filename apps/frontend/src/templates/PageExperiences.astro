---
import Layout from "../layouts/Layout.astro";

import type { CollectionEntry } from "astro:content";
import { z } from "astro/zod";

import WpImage from "../components/elements/WpImage.astro";
import MusicList from "../components/experiences/MusicList.astro";
import InstallationsList from "../components/experiences/InstallationsList.astro";
import { nullableIntReference } from "../lib/schema";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const ScheduleSchema = z.array(
    z.object({
        day: z.string(),
        events: z.array(
            z
                .object({
                    start_time: z.string(),
                    title: z.string(),
                    image: nullableIntReference("media"),
                    description: z.string().nullable().optional(),
                })
                .transform((data) => ({
                    startTime: data.start_time,
                    title: data.title,
                    image: data.image ?? null,
                    description: data.description ?? null,
                })),
        ),
    }),
);

const GroupsSchema = z.array(
    z
        .object({
            title: z.string(),
            slug: z.string().optional(),
            layout: z.enum(["music", "installations", "food"]),
            description: z.string().transform((val) => ({ html: val })),
            items: z.array(
                z.object({
                    name: z.string(),
                    image: nullableIntReference("media"),
                    description: z.string().transform((val) => ({ html: val })),
                    url: z.string().optional(),
                }),
            ),
        })
        .transform((val) => ({
            ...val,
            slug: val.slug || z.string().slugify().parse(val.title),
        })),
);

const { page } = Astro.props;

const { title, acf } = page;

const schedule = ScheduleSchema.parse(acf.schedule);
const groups = GroupsSchema.parse(acf.groups);

const sections = [
    { id: "schedule", label: "Schedule" },
    ...groups.map((g) => ({ id: g.slug, label: g.title })),
];
---

<Layout title={title}>
    <nav aria-label="Page sections">
        {
            sections.map((s, i) => (
                <a
                    href={`#${s.id}`}
                    aria-current={i === 0 ? "true" : undefined}
                >
                    {s.label}
                </a>
            ))
        }
    </nav>

    <!-- Schedule -->
    <section id="schedule">
        <div role="group" aria-label="Select day">
            {
                schedule.map((dayData, i) => (
                    <button
                        data-day={i}
                        aria-pressed={i === 0 ? "true" : "false"}
                    >
                        {dayData.day}
                    </button>
                ))
            }
        </div>

        {
            schedule.map((dayData, dayIndex) => (
                <div data-day-panel={dayIndex} hidden>
                    <ul>
                        {dayData.events.map((event) =>
                            event.image && event.description ? (
                                <li data-rich>
                                    <span>{event.startTime}</span>
                                    <div>
                                        <div>
                                            <p>{event.title}</p>
                                            <p>{event.description}</p>
                                        </div>
                                        <WpImage
                                            image={event.image}
                                            width={140}
                                            height={140}
                                            alt={event.title}
                                        />
                                    </div>
                                </li>
                            ) : (
                                <li>
                                    <span>{event.startTime}</span>
                                    <p>{event.title}</p>
                                </li>
                            ),
                        )}
                    </ul>
                </div>
            ))
        }
    </section>

    <!-- Group sections -->
    {
        groups.map((group) => (
            <section id={group.slug}>
                <div set:html={group.description.html} />

                {group.layout === "music" && <MusicList items={group.items} />}
                {group.layout === "installations" && (
                    <InstallationsList items={group.items} />
                )}
                {group.layout === "food" && (
                    <ul>
                        {group.items.map((item) => (
                            <li>
                                {item.image && (
                                    <WpImage
                                        image={item.image}
                                        width={600}
                                        height={300}
                                        alt={item.name}
                                    />
                                )}
                                <div>
                                    <p>{item.name}</p>
                                    <div set:html={item.description.html} />
                                </div>
                            </li>
                        ))}
                    </ul>
                )}
            </section>
        ))
    }
</Layout>

<script>
    // Day toggle
    const dayPills = document.querySelectorAll<HTMLButtonElement>("[data-day]");
    const dayPanels =
        document.querySelectorAll<HTMLElement>("[data-day-panel]");

    function selectDay(dayIndex: number) {
        dayPills.forEach((p) => {
            p.setAttribute(
                "aria-pressed",
                String(Number(p.dataset.day) === dayIndex),
            );
        });
        dayPanels.forEach((p) => {
            p.hidden = Number(p.dataset.dayPanel) !== dayIndex;
        });
    }

    dayPills.forEach((pill) => {
        pill.addEventListener("click", () =>
            selectDay(Number(pill.dataset.day)),
        );
    });

    // Default day: Saturday (day 6) → index 1, otherwise → index 0.
    const defaultDay = new Date().getDay() === 6 ? 1 : 0;

    selectDay(defaultDay);

    // Active anchor nav link — mirrors site nav aria-current="page" pattern
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(
        "nav[aria-label='Page sections'] a",
    );
    const sections = document.querySelectorAll<HTMLElement>("section[id]");

    const observer = new IntersectionObserver(
        (entries) => {
            for (const entry of entries) {
                if (entry.isIntersecting) {
                    navLinks.forEach((link) => {
                        const active =
                            link.getAttribute("href") === `#${entry.target.id}`;
                        if (active) {
                            link.setAttribute("aria-current", "true");
                        } else {
                            link.removeAttribute("aria-current");
                        }
                    });
                }
            }
        },
        { rootMargin: "-30% 0px -60% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
</script>

<style>
    /* Anchor nav */
    nav {
        --nav-height: 3rem;
        display: flex;
        gap: var(--space-xs);
        border-block-end: var(--border-default);
        margin-block-end: var(--space-lg);
        background: var(--color-bg);
        position: sticky;
        top: 0;
        z-index: 10;
        padding-block-start: var(--space-md);
    }

    @media (width < 48rem) {
        nav {
            flex-direction: column;
            gap: 0;
        }
    }

    nav a {
        padding: var(--space-xs) var(--space-sm);
        font-size: var(--font-size-base);
        color: inherit;
        white-space: nowrap;
        text-decoration: none;
    }

    nav a[aria-current="true"] {
        background: var(--color-accent-2);
        color: var(--color-text);
        font-weight: var(--font-weight-bold);
    }

    /* Sections */
    section {
        scroll-margin-top: var(--nav-height, 3rem);
        margin-block-end: var(--space-xl);
    }

    /* Day toggle */
    [role="group"] {
        display: flex;
        gap: var(--space-xs);
        margin-block-end: var(--space-md);
    }

    [role="group"] button {
        appearance: none;
        background: none;
        border: none;
        padding: var(--space-xxs) var(--space-sm);
        font-size: var(--font-size-xs);
        font-family: inherit;
        color: inherit;
        cursor: pointer;
    }

    [role="group"] button[aria-pressed="true"] {
        background: var(--color-accent-3);
        color: var(--color-text);
    }

    /* Schedule rows */
    [data-day-panel] ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    [data-day-panel] li {
        --time-col: 4rem;
        display: grid;
        grid-template-columns: var(--time-col) 1fr;
        gap: var(--space-xs);
        padding-block: var(--space-sm);
        border-block-start: var(--border-default);
    }

    [data-day-panel] li span {
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-bold);
        color: var(--color-text-muted);
        padding-block-start: 0.2em;
        line-height: var(--line-height-tight);
    }

    [data-day-panel] li p {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-bold);
        margin: 0;
    }

    /* Rich row */
    [data-day-panel] li[data-rich] > div {
        display: flex;
        align-items: flex-start;
        gap: var(--space-md);
    }

    [data-day-panel] li[data-rich] > div > div {
        flex: 1;
    }

    [data-day-panel] li[data-rich] p:first-child {
        font-size: var(--font-size-base);
        margin-block-end: var(--space-xs);
    }

    [data-day-panel] li[data-rich] p:last-child {
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-normal);
        color: var(--color-text-muted);
        line-height: 1.6;
        margin: 0;
    }

    [data-day-panel] li[data-rich] :global(img) {
        flex-shrink: 0;
        width: clamp(5rem, 20%, 8.75rem);
        aspect-ratio: 1;
        object-fit: cover;
        display: block;
    }

    /* Group intro */
    section > div:first-child {
        font-size: var(--font-size-xs);
        color: var(--color-text-muted);
        max-width: var(--prose-width);
        margin-block-end: var(--space-md);
    }

    /* Food & drink */
    section > ul {
        --food-col-min: 12rem;
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(
            auto-fill,
            minmax(min(100%, var(--food-col-min)), 1fr)
        );
        gap: var(--space-xs);
    }

    section > ul li {
        border: var(--border-default);
        overflow: hidden;
    }

    section > ul li :global(img) {
        display: block;
        width: 100%;
        aspect-ratio: 2 / 1;
        object-fit: cover;
    }

    section > ul li > div {
        padding: var(--space-xs);
    }

    section > ul li p {
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-bold);
        margin-block-end: var(--space-xxs);
    }

    section > ul li div > div {
        font-size: var(--font-size-xs);
        color: var(--color-text-muted);
        margin: 0;
    }
</style>
