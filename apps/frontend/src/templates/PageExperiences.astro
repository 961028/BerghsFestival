---
import Layout from "../layouts/Layout.astro";

import type { CollectionEntry } from "astro:content";
import { z } from "astro/zod";

import WpImage from "../components/elements/WpImage.astro";
import { reference } from "astro:content";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const ScheduleSchema = z.array(
    z.object({
        day: z.string(),
        events: z.array(
            z
                .object({
                    start_time: z.string(),
                    title: z.string(),
                })
                .transform((data) => ({
                    startTime: data.start_time,
                    title: data.title,
                })),
        ),
    }),
);

const GroupsSchema = z.array(
    z
        .object({
            title: z.string(),
            description: z.string().transform((val) => ({ html: val })),
            items: z.array(
                z.object({
                    name: z.string(),
                    image: z.coerce
                        .string()
                        .transform((val) =>
                            reference("media").nullable().parse(val),
                        ),
                    description: z.string().transform((val) => ({ html: val })),
                    url: z.string().optional(),
                }),
            ),
        })
        .transform((val) => ({
            ...val,
            slug: z.string().slugify().parse(val.title),
        })),
);

const { page } = Astro.props;

const { title, content, acf } = page;

const schedule = ScheduleSchema.parse(acf.schedule);

const groups = GroupsSchema.parse(acf.groups);
---

<Layout title={title}>
    <h1 class="page-title">{title}</h1>

    <div class="page-content" set:html={content.html} />

    <h2>Schedule</h2>

    <ul class="schedule">
        {
            schedule.map(({ day, events }) => (
                <li class="schedule-day">
                    <h3 class="schedule-day-heading">{day}</h3>
                    <ul class="schedule-events">
                        {events.map((event) => (
                            <li class="schedule-event">
                                {event.startTime} - {event.title}
                            </li>
                        ))}
                    </ul>
                </li>
            ))
        }
    </ul>

    <h2>Groups</h2>

    <nav class="tabs" role="tablist">
        {
            groups.map((group, i) => (
                <button
                    role="tab"
                    class="tab"
                    data-tab={group.slug}
                    aria-selected={i === 0 ? "true" : "false"}
                >
                    {group.title}
                </button>
            ))
        }
    </nav>

    <ul class="groups" id="groups-list">
        {
            groups.map((group) => (
                <li class="group" data-group={group.slug}>
                    <h3 class="group-title">{group.title}</h3>

                    <div
                        class="group-content"
                        set:html={group.description.html}
                    />

                    <ul class="group-items">
                        {group.items.map((item) => (
                            <li class="group-item">
                                <h4>{item.name}</h4>

                                {item.image && (
                                    <WpImage
                                        class="group-item-image"
                                        image={item.image}
                                    />
                                )}

                                <div
                                    class="group-item-description"
                                    set:html={item.description.html}
                                />

                                {item.url && (
                                    <a href={item.url} target="_blank">
                                        {item.url}
                                    </a>
                                )}
                            </li>
                        ))}
                    </ul>
                </li>
            ))
        }
    </ul>
</Layout>

<script>
    const tabs = document.querySelectorAll<HTMLButtonElement>("[data-tab]");
    const groups = document.querySelectorAll<HTMLLIElement>(
        "#groups-list .group",
    );

    tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
            const selected = tab.dataset.tab!;

            tabs.forEach((t) => t.setAttribute("aria-selected", "false"));
            tab.setAttribute("aria-selected", "true");

            groups.forEach((group) => {
                const slug = group.dataset.group ?? "";
                group.hidden = selected !== "all" && slug !== selected;
            });
        });
    });
</script>

<style>
    .page-title {
        font-size: var(--font-size-xxl);
        font-weight: var(--font-weight-bold);
        margin-bottom: var(--space-sm);
    }

    .page-content {
        font-size: var(--font-size-xl);
        line-height: var(--line-height-base);
    }

    .tabs {
        display: flex;
        gap: 0;
        margin-bottom: var(--space-md);
        border-bottom: var(--border-default);
    }

    .tab {
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        padding: var(--space-xs) var(--space-sm);
        font-size: var(--font-size-base);
        font-family: inherit;
        cursor: pointer;
        color: var(--color-text);
        margin-bottom: -1px;
        white-space: nowrap;
    }

    .tab[aria-selected="true"] {
        font-weight: var(--font-weight-bold);
        border-bottom-color: var(--color-text);
    }

    .tab:hover:not([aria-selected="true"]) {
        opacity: 0.6;
    }

    .groups li[hidden] {
        display: none;
    }

    .group-item-image {
        display: block;
        max-width: 100%;
        height: auto;
    }
</style>
