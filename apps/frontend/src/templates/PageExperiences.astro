---
import Layout from "../layouts/Layout.astro";

import type { CollectionEntry } from "astro:content";
import { z } from "astro/zod";
import { reference } from "astro:content";

import WpImage from "../components/elements/WpImage.astro";
import MusicList from "../components/experiences/MusicList.astro";
import InstallationsList from "../components/experiences/InstallationsList.astro";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const ScheduleSchema = z.array(
    z.object({
        day: z.string(),
        events: z.array(
            z
                .object({
                    start_time: z.string(),
                    title: z.string(),
                    image: z.preprocess(
                        (v) => (v === false || v === 0 ? null : v),
                        z.coerce
                            .string()
                            .nullable()
                            .transform((v) =>
                                v ? reference("media").nullable().parse(v) : null,
                            ),
                    ),
                    description: z.string().nullable().optional(),
                })
                .transform((data) => ({
                    startTime: data.start_time,
                    title: data.title,
                    image: data.image ?? null,
                    description: data.description ?? null,
                })),
        ),
    }),
);

const GroupsSchema = z.array(
    z
        .object({
            title: z.string(),
            layout: z.enum(["music", "installations", "food"]),
            description: z.string().transform((val) => ({ html: val })),
            items: z.array(
                z.object({
                    name: z.string(),
                    image: z.coerce
                        .string()
                        .transform((val) =>
                            reference("media").nullable().parse(val),
                        ),
                    description: z.string().transform((val) => ({ html: val })),
                    url: z.string().optional(),
                }),
            ),
        })
        .transform((val) => ({
            ...val,
            slug: z.string().slugify().parse(val.title),
        })),
);

const { page } = Astro.props;

const { title, acf } = page;

const schedule = ScheduleSchema.parse(acf.schedule);
const groups = GroupsSchema.parse(acf.groups);

const tabs = [
    { id: "schedule", label: "Schedule" },
    ...groups.map((g) => ({ id: g.slug, label: g.title })),
];
---

<Layout title={title}>
    <h1 class="page-title">{title}</h1>

    <!-- Tab bar -->
    <nav role="tablist">
        {
            tabs.map((tab, i) => (
                <button
                    role="tab"
                    data-tab={tab.id}
                    aria-selected={i === 0 ? "true" : "false"}
                    aria-controls={`panel-${tab.id}`}
                    id={`tab-${tab.id}`}
                >
                    {tab.label}
                </button>
            ))
        }
    </nav>

    <!-- Schedule panel -->
    <section
        id="panel-schedule"
        role="tabpanel"
        aria-labelledby="tab-schedule"
    >
        <div role="group" aria-label="Select day">
            {
                schedule.map((dayData, i) => (
                    <button
                        data-day={i}
                        aria-pressed={i === 0 ? "true" : "false"}
                    >
                        {dayData.day}
                    </button>
                ))
            }
        </div>

        {
            schedule.map((dayData, dayIndex) => (
                <div data-day-panel={dayIndex}>
                    <ul>
                        {dayData.events.map((event) =>
                            event.image && event.description ? (
                                <li data-rich>
                                    <span>{event.startTime}</span>
                                    <div>
                                        <div>
                                            <p>{event.title}</p>
                                            <p>{event.description}</p>
                                        </div>
                                        <WpImage
                                            image={event.image}
                                            width={140}
                                            height={140}
                                            alt={event.title}
                                        />
                                    </div>
                                </li>
                            ) : (
                                <li>
                                    <span>{event.startTime}</span>
                                    <p>{event.title}</p>
                                </li>
                            ),
                        )}
                    </ul>
                </div>
            ))
        }
    </section>

    <!-- Group panels (Installations, Food & drink) -->
    {
        groups.map((group) => (
            <section
                id={`panel-${group.slug}`}
                role="tabpanel"
                aria-labelledby={`tab-${group.slug}`}
                hidden
            >
                <div set:html={group.description.html} />

                {group.layout === "music" && (
                    <MusicList items={group.items} />
                )}
                {group.layout === "installations" && (
                    <InstallationsList items={group.items} />
                )}
                {group.layout === "food" && (
                    <ul>
                        {group.items.map((item) => (
                            <li>
                                {item.image && (
                                    <WpImage
                                        image={item.image}
                                        width={600}
                                        height={300}
                                        alt={item.name}
                                    />
                                )}
                                <div>
                                    <p>{item.name}</p>
                                    <div set:html={item.description.html} />
                                </div>
                            </li>
                        ))}
                    </ul>
                )}
            </section>
        ))
    }
</Layout>

<script>
    // Tab switching
    const tabs = document.querySelectorAll<HTMLButtonElement>("[role='tab']");
    const panels = document.querySelectorAll<HTMLElement>("[role='tabpanel']");

    function selectTab(tabId: string) {
        tabs.forEach((t) => {
            t.setAttribute("aria-selected", String(t.dataset.tab === tabId));
        });
        panels.forEach((p) => {
            p.hidden = p.id !== `panel-${tabId}`;
        });
    }

    tabs.forEach((tab) => {
        tab.addEventListener("click", () => selectTab(tab.dataset.tab!));
    });

    // Day toggle
    const dayPills = document.querySelectorAll<HTMLButtonElement>("[data-day]");
    const dayPanels =
        document.querySelectorAll<HTMLElement>("[data-day-panel]");

    function selectDay(dayIndex: number) {
        dayPills.forEach((p) => {
            p.setAttribute(
                "aria-pressed",
                String(Number(p.dataset.day) === dayIndex),
            );
        });
        dayPanels.forEach((p) => {
            p.hidden = Number(p.dataset.dayPanel) !== dayIndex;
        });
    }

    dayPills.forEach((pill) => {
        pill.addEventListener("click", () =>
            selectDay(Number(pill.dataset.day)),
        );
    });

    // Default day: Saturday (day 6) → index 1, otherwise → index 0.
    // Dev convenience: toggle by even/odd minute so both states are testable.
    const now = new Date();
    const isDevTest = true; // set to false before going to production
    const defaultDay = isDevTest
        ? now.getMinutes() % 2 === 0
            ? 0
            : 1
        : now.getDay() === 6
          ? 1
          : 0;

    selectDay(defaultDay);
</script>

<style>
    /* Tab bar */
    nav[role="tablist"] {
        display: flex;
        border-block-end: var(--border-default);
        margin-block-end: var(--space-lg);
    }

    [role="tab"] {
        background: none;
        border: none;
        border-block-end: 2px solid transparent;
        padding: var(--space-xs) var(--space-sm);
        font-size: var(--font-size-base);
        font-family: inherit;
        color: var(--color-text-secondary);
        margin-block-end: -1px;
        white-space: nowrap;
    }

    [role="tab"][aria-selected="true"] {
        font-weight: var(--font-weight-semibold);
        border-block-end-color: var(--color-text);
        color: var(--color-text);
    }

    @media (any-hover: hover) and (any-pointer: fine) {
        [role="tab"]:hover:not([aria-selected="true"]) {
            opacity: 0.7;
        }
    }

    /* Day toggle */
    [role="group"] {
        display: flex;
        gap: var(--space-xs);
        margin-block-end: var(--space-md);
    }

    [role="group"] button {
        background: none;
        border: var(--border-default);
        border-radius: var(--border-radius-pill);
        padding: var(--space-xxs) var(--space-sm);
        font-size: var(--font-size-sm);
        font-family: inherit;
        color: var(--color-text-secondary);
    }

    [role="group"] button[aria-pressed="true"] {
        background: var(--color-text);
        color: var(--color-bg);
        border-color: var(--color-text);
    }

    /* Schedule rows */
    [data-day-panel] ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    [data-day-panel] li {
        --time-col: 4rem;
        display: grid;
        grid-template-columns: var(--time-col) 1fr;
        gap: var(--space-xs);
        padding-block: var(--space-sm);
        border-block-start: var(--border-default);
    }

    [data-day-panel] li span {
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-semibold);
        color: var(--color-text-secondary);
        padding-block-start: 0.2em;
        line-height: var(--line-height-tight);
    }

    [data-day-panel] li p {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-semibold);
        margin: 0;
    }

    /* Rich row */
    [data-day-panel] li[data-rich] > div {
        display: flex;
        align-items: flex-start;
        gap: var(--space-md);
    }

    [data-day-panel] li[data-rich] > div > div {
        flex: 1;
    }

    [data-day-panel] li[data-rich] p:first-child {
        font-size: var(--font-size-md);
        margin-block-end: var(--space-xs);
    }

    [data-day-panel] li[data-rich] p:last-child {
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-normal);
        color: var(--color-text-secondary);
        line-height: var(--line-height-loose);
        margin: 0;
    }

    [data-day-panel] li[data-rich] :global(img) {
        flex-shrink: 0;
        width: clamp(5rem, 20%, 8.75rem);
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: var(--border-radius-lg);
        display: block;
    }

    /* Group intro */
    [role="tabpanel"] > div:first-child {
        font-size: var(--font-size-sm);
        color: var(--color-text-secondary);
        max-width: var(--prose-width);
        margin-block-end: var(--space-md);
    }

    /* Food & drink */
    [role="tabpanel"] > ul {
        --food-col-min: 12rem;
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--food-col-min)), 1fr));
        gap: var(--space-xs);
    }

    [role="tabpanel"] > ul li {
        border: var(--border-default);
        border-radius: var(--border-radius-lg);
        overflow: hidden;
    }

    [role="tabpanel"] > ul li :global(img) {
        display: block;
        width: 100%;
        aspect-ratio: 2 / 1;
        object-fit: cover;
    }

    [role="tabpanel"] > ul li > div {
        padding: var(--space-xs);
    }

    [role="tabpanel"] > ul li p {
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
        margin-block-end: var(--space-xxs);
    }

    [role="tabpanel"] > ul li div > div {
        font-size: var(--font-size-xs);
        color: var(--color-text-secondary);
        margin: 0;
    }
</style>
