---
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import WpImage from "../components/elements/WpImage.astro";
import { getFoodPage } from "../lib/experience-pages";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const { page } = Astro.props;

const data = await getFoodPage();

if (!data) {
    throw new Error("Food & drink page is missing — create a page using the Food & drink template.");
}
---

<Layout
    title={page.title}
    metaDescription={page.metaDescription}
    ogImage={page.image}
    ctaCompact
>
    <h1 class="page-title" data-scramble>{page.title}</h1>

    <section>
        {data.description && (
            <div class="section-body intro" set:html={data.description.html} />
        )}

        <ul class="food-list">
            {data.items.map((item) => (
                <li>
                    {item.image && (
                        <WpImage
                            image={item.image}
                            width={600}
                            height={600}
                            alt={item.name}
                        />
                    )}
                    <div>
                        <p>{item.name}</p>
                        {item.location && (
                            <p class="meta">{item.location}</p>
                        )}
                        <div set:html={item.description.html} />
                    </div>
                </li>
            ))}
        </ul>
    </section>
</Layout>

<style>
    section {
        padding-block-end: var(--space-xl);
    }

    .intro {
        margin-block-end: var(--space-xl);
    }

    .food-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-md);
    }

    @media (min-width: 30rem) {
        .food-list {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 48rem) {
        .food-list {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .food-list li {
        border: var(--border-default);
        overflow: hidden;
    }

    .food-list li :global(img) {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
        object-fit: cover;
    }

    .food-list li > div {
        padding: var(--space-sm);
    }

    .food-list li p {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        line-height: var(--line-height-tight);
        letter-spacing: var(--letter-spacing-tight);
        margin-block-end: var(--space-xs);
    }

    .food-list li .meta {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-normal);
        color: var(--color-text-muted);
        text-transform: lowercase;
    }

    .food-list li div > div {
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
        color: var(--color-text-muted);
        margin: 0;
    }
</style>
