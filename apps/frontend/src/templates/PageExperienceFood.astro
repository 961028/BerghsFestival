---
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import FoodList from "../components/experiences/FoodList.astro";
import PageIntro from "../components/site/PageIntro.astro";
import { getFoodPage } from "../lib/experience-pages";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const { page } = Astro.props;

const data = await getFoodPage();

if (!data) {
    throw new Error("Food & drink page is missing — create a page using the Food & drink template.");
}
---

<Layout
    title={page.title}
    metaDescription={page.metaDescription}
    ogImage={page.image}
>
    <PageIntro title={page.title} descriptionHtml={data.description?.html} />

    <FoodList items={data.items} />
</Layout>
