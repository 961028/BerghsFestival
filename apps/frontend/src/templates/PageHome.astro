---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const { page } = Astro.props;
const { title } = page;

const homeData = (await getCollection("home"))[0].data;

// TODO: pull from CMS
const festivalDays = [
    { abbr: "FRI", num: "23 MAY", hours: "12:00 – 01:00" },
    { abbr: "SAT", num: "24 MAY", hours: "12:00 – 17:00" },
];

// Opening: Friday exhibition start
const openingDate = new Date("2026-05-23T12:00:00");
---

<Layout title={title} metaTitle={homeData.metaTitle || undefined}>
    <!-- ── Hero ───────────────────────────────────────────────────── -->
    <section class="hero" aria-label="Hero">
        <video
            class="hero-video"
            id="js-hero-video"
            loop
            muted
            playsinline
            aria-hidden="true"
        >
            <source src="/videos/hero.mp4" type="video/mp4" />
        </video>

        <div class="hero-panel">
            <ol class="schedule-days" role="list">
                {
                    festivalDays.map((day) => (
                        <li class="schedule-day">
                            <div class="schedule-headline">
                                <span class="schedule-abbr" data-scramble>
                                    {day.abbr}
                                </span>
                                <span class="schedule-num" data-scramble>
                                    {day.num}
                                </span>
                            </div>
                            <span class="schedule-hours" data-scramble>
                                {day.hours}
                            </span>
                        </li>
                    ))
                }
            </ol>

            <div class="hero-footer">
                <p
                    class="countdown"
                    aria-live="polite"
                    aria-label="Countdown to festival opening"
                >
                    <span id="js-countdown">--</span>
                </p>
                <span class="hero-stats">150 students — 50 projects</span>
            </div>
        </div>
    </section>

    <!-- ── About ──────────────────────────────────────────────────── -->
    <section class="about" aria-labelledby="about-heading">
        <h2 class="section-label" id="about-heading" data-scramble>ABOUT</h2>
        <div class="about-body" set:html={homeData.about.html} />
    </section>

    <!-- ── Manifest ────────────────────────────────────────────────── -->
    <section class="manifest" aria-labelledby="manifest-heading">
        <h2 class="section-label" id="manifest-heading" data-scramble>
            MANIFEST
        </h2>
        <div class="manifest-body" set:html={homeData.manifest.html} />
    </section>
</Layout>

<script define:vars={{ openingDateISO: openingDate.toISOString() }}>
    const target = new Date(openingDateISO);
    const el = document.getElementById("js-countdown");

    function pad(n) {
        return String(n).padStart(2, "0");
    }

    function tick() {
        if (!el) return;
        const diff = target - Date.now();

        if (diff <= 0) {
            el.closest(".countdown").textContent = "OPEN NOW";
            return;
        }

        const totalSeconds = Math.floor(diff / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        let text;
        if (days > 0)
            text = `OPENS IN ${days}D ${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
        else text = `OPENS IN ${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;

        el.textContent = text;
    }

    tick();
    setInterval(tick, 1000);
</script>

<script>
    const video = document.getElementById("js-hero-video") as HTMLVideoElement | null;
    if (video && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        video.play();
    }
</script>

<style>
    /* Remove main's padding so the hero touches all wrapper edges */
    :global([data-region="main"]:has(.hero)) {
        padding: 0;
    }

    /* ── Hero ──────────────────────────────────────────────────────── */

    .hero {
        display: grid;
        grid-template-rows: 1fr auto;
        width: 100%;
        height: calc(
            100dvh - var(--header-height, 0px) - var(--cta-height, 0px)
        );
        overflow: hidden;
    }

    .hero-video {
        min-height: 0;
        width: 100%;
        object-fit: fill;
        display: block;
    }

    .hero-panel {
        container-type: inline-size;
        background: var(--color-bg);
        border-block-start: var(--border-default);
    }

    /* ── Hero footer (countdown + stats) ──────────────────────────── */

    .hero-footer {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-xxs);
        padding-block: var(--space-xs);
        border-block-start: var(--border-default);
        font-size: var(--font-size-xs);
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        font-weight: var(--font-weight-normal);
        text-transform: uppercase;
    }

    @container (min-width: 30rem) {
        .hero-footer {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            gap: 0;
        }
    }

    .countdown {
        margin: 0;
    }

    .hero-stats {
        white-space: nowrap;
    }

    /* ── Schedule ──────────────────────────────────────────────────── */

    .schedule-days {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1px;
        background: var(--color-border);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .schedule-day {
        display: grid;
        align-items: flex-start;
        gap: var(--space-xs);
        padding-block: var(--space-sm);
        background: var(--color-bg);
    }

    .schedule-headline {
        display: flex;
        align-items: baseline;
        gap: 14px; /* intentional fixed gap — optical spacing between abbr and number */
        line-height: var(--line-height-tight);
    }

    .schedule-abbr {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: -0.03em;
    }

    .schedule-num {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: -0.04em;
        color: var(--color-text-muted);
    }

    .schedule-hours {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: -0.03em;
        font-variant-numeric: tabular-nums;
        color: var(--color-text-muted);
    }

    /* Within each day: abbr+date | hours side by side */
    @container (min-width: 24rem) {
        .schedule-day {
            display: flex;
            align-items: center;
            gap: var(--space-lg);
        }
    }

    /* Two days side by side at 50/50 */
    @container (min-width: 48rem) {
        .schedule-days {
            grid-template-columns: 1fr 1fr;
        }

        .schedule-day:last-child {
            justify-content: flex-end;
        }
    }

    /* ── Section labels ───────────────────────────────────────────── */

    .section-label {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
        color: var(--color-text-muted);
        margin: 0;
    }

    /* ── Content sections (manifest + about) ──────────────────────── */

    .manifest,
    .about {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-md) 0;
        align-items: start;
        padding-block: var(--space-xl);
        border-block-start: var(--border-default);
    }

    @container (min-width: 40rem) {
        .section-label {
            writing-mode: vertical-lr;
            rotate: 180deg;
            place-self: start;
            /* Offset half-leading of adjacent prose (line-height 1.4, font-size 1.125rem) */
            translate: 0 0.75rem;
        }

        .manifest,
        .about {
            grid-template-columns: auto 1fr;
            gap: 0 var(--space-xl);
        }
    }

    .manifest-body,
    .about-body {
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
        max-width: var(--prose-width);
    }
</style>
