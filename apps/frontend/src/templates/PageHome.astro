---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const { page } = Astro.props;
const { title } = page;

const homeData = (await getCollection("home"))[0].data;

// TODO: pull from CMS
const festivalDays = [
    { abbr: "FRI", num: "23 MAY", hours: "12:00 – 01:00" },
    { abbr: "SAT", num: "24 MAY", hours: "12:00 – 17:00" },
];

// Opening: Friday exhibition start
const openingDate = new Date("2026-05-23T12:00:00");
---

<Layout title={title}>
    <!-- ── Hero ───────────────────────────────────────────────────── -->
    <section class="hero" aria-label="Hero">
        <video
            class="hero-video"
            autoplay
            loop
            muted
            playsinline
            aria-hidden="true"
        >
            <source src="/videos/hero.mp4" type="video/mp4" />
        </video>

        <div class="hero-panel">
            <ol class="schedule-days" role="list">
                {festivalDays.map((day) => (
                    <li class="schedule-day">
                        <div class="schedule-headline">
                            <span class="schedule-abbr" data-scramble>{day.abbr}</span>
                            <span class="schedule-num" data-scramble>{day.num}</span>
                        </div>
                        <span class="schedule-hours" data-scramble>{day.hours}</span>
                    </li>
                ))}
            </ol>

            <div class="hero-footer">
                <p class="countdown" aria-live="polite" aria-label="Countdown to festival opening">
                    <span id="js-countdown">--</span>
                </p>
                <span class="hero-stats">150 students — 50 projects</span>
            </div>

        </div>
    </section>

    <!-- ── About ──────────────────────────────────────────────────── -->
    <section class="about" aria-labelledby="about-heading">
        <h2 class="section-label" id="about-heading" data-scramble>ABOUT</h2>
        <div class="about-body" set:html={homeData.about.html} />
    </section>

    <!-- ── Manifest ────────────────────────────────────────────────── -->
    <section class="manifest" aria-labelledby="manifest-heading">
        <h2 class="section-label" id="manifest-heading" data-scramble>MANIFEST</h2>
        <div class="manifest-body" set:html={homeData.manifest.html} />
    </section>
</Layout>

<script define:vars={{ openingDateISO: openingDate.toISOString() }}>
    const target = new Date(openingDateISO);
    const el = document.getElementById("js-countdown");

    function pad(n) {
        return String(n).padStart(2, "0");
    }

    function tick() {
        if (!el) return;
        const diff = target - Date.now();

        if (diff <= 0) {
            el.closest(".countdown").textContent = "OPEN NOW";
            return;
        }

        const totalSeconds = Math.floor(diff / 1000);
        const days    = Math.floor(totalSeconds / 86400);
        const hours   = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        let text;
        if (days > 0) text = `OPENS IN ${days}D ${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
        else          text = `OPENS IN ${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;

        el.textContent = text;
    }

    tick();
    setInterval(tick, 1000);
</script>

<style>
    /* Remove main's padding so the hero touches all wrapper edges */
    :global([data-region="main"]:has(.hero)) {
        padding: 0;
    }

    /* ── Hero ──────────────────────────────────────────────────────── */

    .hero {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: calc(100dvh - var(--header-height, 0px) - var(--cta-height, 0px));
        overflow: hidden;
    }

    .hero-video {
        flex: 1 1 0;
        min-height: 0;
        width: 100%;
        object-fit: fill;
        display: block;
    }

    .hero-panel {
        flex: 0 0 auto;
        background: var(--color-bg);
        border-block-start: var(--border-default);
    }

    /* ── Hero footer (countdown + stats) ──────────────────────────── */

    .hero-footer {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-xxs);
        padding-block: var(--space-xs);
        border-block-start: var(--border-default);
        font-size: var(--font-size-xs);
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        font-weight: var(--font-weight-normal);
        text-transform: uppercase;
    }

    @media (min-width: 48rem) {
        .hero-footer {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            gap: 0;
        }
    }

    .countdown {
        margin: 0;
    }

    .hero-stats {
        white-space: nowrap;
    }

    /* ── Schedule ──────────────────────────────────────────────────── */

    .schedule-days {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .schedule-day {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-xs);
        padding-block: var(--space-sm);
        border-block-end: var(--border-default);
    }

    .schedule-headline {
        display: flex;
        align-items: baseline;
        gap: 14px; /* intentional fixed gap — optical spacing between abbr and number */
        line-height: var(--line-height-tight);
    }

    .schedule-abbr {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: -0.03em;
    }

    .schedule-num {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: -0.04em;
        color: var(--color-text-muted);
    }

    .schedule-hours {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: -0.03em;
        font-variant-numeric: tabular-nums;
        color: var(--color-text-muted);
    }

    @media (min-width: 48rem) {
        .schedule-days {
            display: grid;
            grid-template-columns: max-content 1fr;
        }

        .schedule-day {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: subgrid;
            flex-direction: unset;
            align-items: center;
            gap: var(--space-lg);
        }
    }

    /* ── Section labels ───────────────────────────────────────────── */

    .section-label {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
        color: var(--color-text-muted);
        margin: 0;
    }

    @media (min-width: 48rem) {
        .section-label {
            writing-mode: vertical-rl;
            rotate: 180deg;
            place-self: start;
        }
    }

    /* ── Content sections (manifest + about) ──────────────────────── */

    .manifest,
    .about {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-md) 0;
        align-items: start;
        padding-block: var(--space-xl);
        border-block-start: var(--border-default);
    }

    @media (min-width: 48rem) {
        .manifest,
        .about {
            grid-template-columns: auto 1fr;
            gap: 0 var(--space-xl);
        }
    }

    .manifest-body,
    .about-body {
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
        max-width: var(--prose-width);
    }
</style>
