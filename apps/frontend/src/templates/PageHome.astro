---
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const { page } = Astro.props;
const { title } = page;

// TODO: pull from CMS
const festivalDays = [
    { abbr: "FRI", num: "23", hours: "12:00 – 01:00" },
    { abbr: "SAT", num: "24", hours: "12:00 – 17:00" },
];

const festivalMeta = {
    dates:    "MAY 23, 24 – 2026",
    location: "BOBERGSGATAN 48",
};

// Opening: Friday exhibition start
const openingDate = new Date("2026-05-23T12:00:00");
---

<Layout title={title}>
    <!-- ── Hero ───────────────────────────────────────────────────── -->
    <section class="hero" aria-label="Hero">
        <video
            class="hero-video"
            autoplay
            loop
            muted
            playsinline
            aria-hidden="true"
        >
            <source src="/videos/fuckitblinkande.mp4" type="video/mp4" />
        </video>

        <div class="hero-panel">
            <p class="countdown" aria-live="polite" aria-label="Countdown to festival opening">
                <span id="js-countdown">--</span>
            </p>

            <ol class="schedule-days" role="list">
                {festivalDays.map((day) => (
                    <li class="schedule-day">
                        <div class="schedule-headline">
                            <span class="schedule-abbr">{day.abbr}</span>
                            <span class="schedule-num">{day.num}</span>
                        </div>
                        <span class="schedule-hours">{day.hours}</span>
                    </li>
                ))}
            </ol>

            <div class="schedule-meta">
                <span>{festivalMeta.dates}</span>
                <span>{festivalMeta.location}</span>
            </div>
        </div>
    </section>

    <!-- ── Manifest ────────────────────────────────────────────────── -->
    <section class="manifest" aria-labelledby="manifest-heading">
        <span class="section-label" id="manifest-heading">MANIFEST</span>
        <div class="manifest-body">
            <!-- TODO: wire in manifest copy from CMS -->
        </div>
    </section>

    <!-- ── About ──────────────────────────────────────────────────── -->
    <section class="about" aria-labelledby="about-heading">
        <span class="section-label" id="about-heading">ABOUT</span>
        <div class="about-body">
            <!-- TODO: wire in real about copy from CMS -->
        </div>
    </section>
</Layout>

<script define:vars={{ openingDateISO: openingDate.toISOString() }}>
    const target = new Date(openingDateISO);
    const el = document.getElementById("js-countdown");

    function pad(n) {
        return String(n).padStart(2, "0");
    }

    function tick() {
        if (!el) return;
        const diff = target - Date.now();

        if (diff <= 0) {
            el.closest(".countdown").textContent = "OPEN NOW";
            return;
        }

        const totalSeconds = Math.floor(diff / 1000);
        const days    = Math.floor(totalSeconds / 86400);
        const hours   = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        let text;
        if (days > 0) text = `OPENS IN ${days}D ${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
        else          text = `OPENS IN ${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;

        el.textContent = text;
    }

    tick();
    setInterval(tick, 1000);
</script>

<style>
    /* Remove main's padding so the hero touches all wrapper edges */
    :global([data-region="main"]:has(.hero)) {
        padding: 0;
    }

    /* ── Hero ──────────────────────────────────────────────────────── */

    .hero {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: calc(100dvh - var(--header-height, 0px) - var(--cta-height, 0px));
        overflow: hidden;
    }

    .hero-video {
        flex: 1 1 0;
        min-height: 0;
        width: 100%;
        object-fit: cover;
        object-position: center center;
        display: block;
    }

    .hero-panel {
        flex: 0 0 auto;
        background: var(--color-bg);
        border-block-start: var(--border-default);
    }

    /* ── Countdown ─────────────────────────────────────────────────── */

    .countdown {
        margin: 0;
        padding: var(--space-xs) var(--site-padding-inline);
        font-size: var(--font-size-xs);
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        font-weight: var(--font-weight-normal);
        text-transform: uppercase;
        border-block-end: var(--border-default);
    }

    /* ── Schedule ──────────────────────────────────────────────────── */

    .schedule-days {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .schedule-day {
        display: flex;
        align-items: center;
        gap: var(--space-lg);
        padding: var(--space-sm) var(--site-padding-inline);
        border-block-end: var(--border-default);
    }

    .schedule-headline {
        display: flex;
        align-items: baseline;
        gap: 14px; /* intentional fixed gap — optical spacing between abbr and number */
        line-height: var(--line-height-tight);
    }

    .schedule-abbr {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: -0.03em;
    }

    .schedule-num {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: -0.04em;
        color: var(--color-text-muted);
    }

    .schedule-hours {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: -0.03em;
        font-variant-numeric: tabular-nums;
        color: var(--color-text-muted);
    }

    @media (min-width: 48rem) {
        .schedule-days {
            display: grid;
            grid-template-columns: max-content 1fr;
        }

        .schedule-day {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: subgrid;
            align-items: center;
        }
    }

    /* ── Meta (dates + location) ───────────────────────────────────── */

    .schedule-meta {
        display: flex;
        gap: var(--space-lg);
        padding: var(--space-xs) var(--site-padding-inline);
        font-size: var(--font-size-xs);
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        text-transform: uppercase;
    }

    /* ── Manifest ──────────────────────────────────────────────────── */

    .manifest {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0 var(--space-xl);
        align-items: start;
        padding: var(--space-xl) var(--site-padding-inline);
        border-block-end: var(--border-default);
    }

    .manifest-body {
        font-size: var(--font-size-lg);
        line-height: var(--line-height-base);
        max-width: var(--prose-width);
    }

    /* ── About ─────────────────────────────────────────────────────── */

    .about {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0 var(--space-xl);
        align-items: start;
        padding: var(--space-xl) var(--site-padding-inline);
    }
</style>
