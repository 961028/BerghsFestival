---
import type { CollectionEntry } from "astro:content";
import { z } from "astro/zod";
import Layout from "../layouts/Layout.astro";

const SectionsSchema = z
    .array(
        z
            .object({
                title: z.string(),
                content: z.string().transform((val) => ({ html: val })),
            })
            .transform((value) => ({
                ...value,
                slug: z.string().slugify().parse(value.title),
            })),
    )
    .catch([]);

const OpeningDateSchema = z.coerce.date().nullable().catch(null);

const FestivalDaysSchema = z
    .array(
        z.object({
            abbr: z.string(),
            date: z.string(),
            hours: z.string(),
        }),
    )
    .catch([]);

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const { page } = Astro.props;
const { title, acf } = page;

const sections = SectionsSchema.parse(acf.sections);
const openingDate = OpeningDateSchema.parse(acf.opening_date);
const festivalDays = FestivalDaysSchema.parse(acf.festival_days);
---

<Layout title={title}>
    <!-- ── Hero ───────────────────────────────────────────────────── -->
    <section class="hero" aria-labelledby="hero-heading">
        <h1 id="hero-heading" class="visually-hidden">
            Berghs Festival 2026 (Friction Festival) - Dates and Schedule
        </h1>
        <video
            class="hero-video"
            id="js-hero-video"
            loop
            muted
            playsinline
            aria-hidden="true"
        >
            <source src="/videos/hero.mp4" type="video/mp4" />
        </video>

        <div class="hero-panel">
            <ol class="schedule-days">
                {
                    festivalDays.map((day) => (
                        <li class="schedule-day">
                            <div class="schedule-headline">
                                <span class="schedule-abbr" data-scramble>
                                    {day.abbr}
                                </span>
                                <span class="schedule-num" data-scramble>
                                    {day.date}
                                </span>
                            </div>
                            <span class="schedule-hours" data-scramble>
                                {day.hours}
                            </span>
                        </li>
                    ))
                }
            </ol>

            <div class="hero-footer">
                <p
                    class="countdown"
                    aria-live="polite"
                    aria-label="Countdown to festival opening"
                >
                    <span id="js-countdown">--</span>
                </p>
                <span class="hero-stats">142 students — 22 projects</span>
            </div>
        </div>
    </section>

    {
        sections.map((section) => (
            <section class="section" aria-labelledby={section.slug}>
                <h2 class="section-label" id={section.slug} data-scramble>
                    {section.title}
                </h2>

                <div class="section-body" set:html={section.content.html} />
            </section>
        ))
    }
</Layout>

<script define:vars={{ openingDateStr: openingDate?.toISOString() }}>
    if (!openingDateStr) {
        return;
    }

    const target = new Date(openingDateStr);
    const el = document.getElementById("js-countdown");

    function pad(n) {
        return String(n).padStart(2, "0");
    }

    function tick() {
        if (!el) return;
        const diff = target - Date.now();

        if (diff <= 0) {
            el.closest(".countdown").textContent = "OPEN NOW";
            return;
        }

        const totalSeconds = Math.floor(diff / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        let text;
        if (days > 0) {
            text = `OPENS IN ${days}D ${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
        } else {
            text = `OPENS IN ${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
        }

        el.textContent = text;
    }

    tick();
    setInterval(tick, 1000);
</script>

<script>
    const video = document.getElementById(
        "js-hero-video",
    ) as HTMLVideoElement | null;
    if (
        video &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
        video.play();
    }
</script>

<style>
    /* Remove main's padding so the hero touches all wrapper edges */
    :global([data-region="main"]:has(.hero)) {
        padding: 0;
    }

    /* ── Hero ──────────────────────────────────────────────────────── */

    .hero {
        display: grid;
        grid-template-rows: 1fr auto;
        width: 100%;
        height: calc(
            100dvh - var(--header-height, 0px) - var(--cta-height, 0px)
        );
        overflow: hidden;
    }

    .hero-video {
        min-height: 0;
        width: 100%;
        height: 100%;
        object-fit: fill;
        display: block;
    }

    .hero-panel {
        container-type: inline-size;
        background: var(--color-bg);
        border-block-start: var(--border-default);
    }

    /* ── Hero footer (countdown + stats) ──────────────────────────── */

    .hero-footer {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-xxs);
        padding-block: var(--space-xs);
        border-block-start: var(--border-default);
        font-size: var(--font-size-xs);
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        font-weight: var(--font-weight-normal);
        text-transform: uppercase;
    }

    @container (min-width: 35rem) {
        .hero-footer {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            gap: 0;
        }
    }

    .countdown {
        margin: 0;
    }

    .hero-stats {
        white-space: nowrap;
    }

    /* ── Schedule ──────────────────────────────────────────────────── */

    .schedule-days {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1px;
        background: var(--color-border);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .schedule-day {
        display: grid;
        align-items: flex-start;
        gap: var(--space-xs);
        padding-block: var(--space-sm);
        background: var(--color-bg);
    }

    .schedule-headline {
        display: flex;
        align-items: baseline;
        gap: var(--space-md);
        line-height: var(--line-height-tight);
    }

    .schedule-abbr {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: -0.03em;
    }

    .schedule-num {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: -0.04em;
        color: var(--color-text-muted);
    }

    .schedule-hours {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: -0.03em;
        font-variant-numeric: tabular-nums;
        color: var(--color-text-muted);
    }

    /* Within each day: abbr+date | hours side by side */
    @container (min-width: 28rem) {
        .schedule-day {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
    }

    /* Two days side by side at 50/50 */
    @container (min-width: 55rem) {
        .schedule-days {
            grid-template-columns: 1fr 1fr;
        }

        .schedule-day {
            padding-inline: var(--space-md);
        }

        .schedule-day:first-child {
            padding-inline-start: 0;
        }

        .schedule-day:last-child {
            justify-content: space-between;
            padding-inline-end: 0;
        }
    }

    /* ── Section labels ───────────────────────────────────────────── */

    .section-label {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
        color: var(--color-text-muted);
        margin: 0;
    }

    /* ── Content sections ─────────────────────────────────────────── */

    .section {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-md) 0;
        align-items: start;
        padding-block: var(--space-xl);
        border-block-start: var(--border-default);
    }

    @container (min-width: 36rem) {
        .section-label {
            writing-mode: vertical-lr;
            rotate: 180deg;
            place-self: start;
            /* Offset half-leading of adjacent prose (line-height 1.4, font-size 1.125rem) */
            translate: 0 0.75rem;
        }

        .section {
            grid-template-columns: auto 1fr;
            gap: 0 var(--space-xl);
        }
    }

    .section-body {
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
        max-width: var(--prose-width);
    }
</style>
