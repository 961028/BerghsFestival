---
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const { page } = Astro.props;
const { title } = page;
---

<Layout title={title}>
    <div class="hero">
        <video
            class="hero-video"
            autoplay
            loop
            muted
            playsinline
            aria-hidden="true"
        >
            <!-- TODO: replace with real video asset -->
            <source src="https://www.w3schools.com/html/mov_bbb.mp4" type="video/mp4" />
        </video>
    </div>

    <h1 class="page-title">{title}</h1>
</Layout>

<style>
    /* Remove main's padding so the hero touches all wrapper edges */
    :global([data-region="main"]:has(.hero)) {
        padding: 0;
    }

    .hero {
        width: 100%;
        height: calc(85dvh - var(--header-height, 0px));
        overflow: hidden;
    }

    .hero-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .page-title {
        padding: var(--space-xl) var(--site-padding-inline) 0;
    }
</style>
