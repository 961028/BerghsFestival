---
import type { CollectionEntry } from "astro:content";
import { z } from "astro/zod";
import Layout from "../layouts/Layout.astro";
import { nullableIntReference } from "../lib/schema";
import HeroMedia from "../components/home/HeroMedia.astro";

const HeroSchema = z
    .object({
        hero_video: z
            .object({
                url: z.string().nonempty(),
                mime_type: z.string(),
                width: z.int().positive().optional(),
                height: z.int().positive().optional(),
            })
            .nullable()
            .catch(null),
        hero_image: nullableIntReference("media"),
    })
    .transform((value) => ({
        video: value.hero_video,
        image: value.hero_image,
    }));

const SectionsSchema = z
    .array(
        z
            .object({
                title: z.string(),
                content: z.string().transform((val) => ({ html: val })),
            })
            .transform((value) => ({
                ...value,
                slug: z.string().slugify().parse(value.title),
            })),
    )
    .catch([]);

const OpeningDateSchema = z.coerce.date().nullable().catch(null);

const FestivalDaysSchema = z
    .array(
        z.object({
            abbr: z.string(),
            date: z.string(),
            hours: z.string(),
        }),
    )
    .catch([]);

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const { page } = Astro.props;
const { title, metaDescription, image, acf } = page;

const hero = HeroSchema.parse(acf);
const sections = SectionsSchema.parse(acf.sections);
const openingDate = OpeningDateSchema.parse(acf.opening_date);
const festivalDays = FestivalDaysSchema.parse(acf.festival_days);
const studentCount = acf.student_count as number | undefined;
const projectCount = acf.project_count as number | undefined;
---

<Layout title="" metaDescription={metaDescription} ogImage={image}>
    <!-- ── Hero ───────────────────────────────────────────────────── -->
    <section class="hero" aria-labelledby="hero-heading">
        <h1 id="hero-heading" class="visually-hidden">
            {title}
        </h1>

        <HeroMedia
            video={hero.video === null
                ? null
                : {
                      src: hero.video.url,
                      mimeType: hero.video.mime_type,
                      width: hero.video.width,
                      height: hero.video.height,
                  }}
            image={hero.image}
        />

        <div class="hero-panel">
            <ol class="schedule-days">
                {
                    festivalDays.map((day) => (
                        <li class="schedule-day">
                            <div class="schedule-headline">
                                <span class="schedule-abbr" data-scramble>
                                    {day.abbr}
                                </span>
                                <span class="schedule-num" data-scramble>
                                    {day.date}
                                </span>
                            </div>
                            <span class="schedule-hours" data-scramble>
                                {day.hours}
                            </span>
                        </li>
                    ))
                }
            </ol>

            <div class="hero-footer">
                <p
                    class="countdown"
                    aria-live="polite"
                    aria-label="Countdown to festival opening"
                >
                    <span id="js-countdown">--</span>
                </p>
                {
                    (studentCount || projectCount) && (
                        <span class="hero-stats">
                            {studentCount && `${studentCount} students`}
                            {studentCount && projectCount && " — "}
                            {projectCount && `${projectCount} projects`}
                        </span>
                    )
                }
            </div>
        </div>
    </section>

    {
        sections.map((section) => (
            <section class="section" aria-labelledby={section.slug}>
                <h2 class="section-label" id={section.slug} data-scramble>
                    {section.title}
                </h2>

                <div class="section-body" set:html={section.content.html} />
            </section>
        ))
    }
</Layout>

<script define:vars={{ openingDateStr: openingDate?.toISOString() }}>
    if (!openingDateStr) {
        return;
    }

    const target = new Date(openingDateStr);
    const el = document.getElementById("js-countdown");

    function pad(n) {
        return String(n).padStart(2, "0");
    }

    function tick() {
        if (!el) return;
        const diff = target - Date.now();

        if (diff <= 0) {
            el.closest(".countdown").textContent = "OPEN NOW";
            return;
        }

        const totalSeconds = Math.floor(diff / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        let text;
        if (days > 0) {
            text = `OPENS IN ${days}D ${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
        } else {
            text = `OPENS IN ${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
        }

        el.textContent = text;
    }

    tick();
    setInterval(tick, 1000);
</script>

<style>
    /* Remove main's padding so the hero touches all wrapper edges */
    :global([data-region="main"]:has(.hero)) {
        padding: 0;
    }

    /* ── Hero ──────────────────────────────────────────────────────── */

    .hero {
        display: grid;
        grid-template-rows: 1fr auto;
        width: 100%;
        height: calc(100dvh - var(--header-height) - 1px - var(--cta-height));
    }

    .hero > :global(.hero-media) {
        position: relative;
        overflow: hidden;
        min-height: 0;
    }

    .hero-panel {
        background: var(--color-ink);
        border-block-start: var(--border);
    }

    /* ── Hero footer (countdown + stats) ──────────────────────────── */

    .hero-footer {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-xxs);
        padding-block: var(--space-xs);
        border-block-start: var(--border);
        font-size: var(--font-size-xs);
        letter-spacing: var(--letter-spacing-label);
        color: var(--color-paper);
        font-weight: var(--font-weight-normal);
        text-transform: uppercase;
    }

    /* 38rem: countdown + stats side by side */
    @media (min-width: 38rem) {
        .hero-footer {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            gap: 0;
        }
    }

    .countdown {
        margin: 0;
    }

    /* ── Schedule ──────────────────────────────────────────────────── */

    .schedule-days {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1px;
        background: var(--color-paper);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .schedule-day {
        display: grid;
        align-items: flex-start;
        padding-block: var(--space-xs);
        background: var(--color-ink);
    }

    .schedule-headline {
        display: flex;
        align-items: baseline;
        gap: var(--space-sm);
        line-height: var(--line-height-tight);
    }

    .schedule-abbr {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: var(--letter-spacing-tight);
    }

    .schedule-num {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: var(--letter-spacing-tight);
        color: var(--color-paper);
    }

    .schedule-hours {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: var(--letter-spacing-tight);
        font-variant-numeric: tabular-nums;
        color: var(--color-paper);
    }

    /* Schedule days go inline earlier — the content is short enough */
    @media (min-width: 24rem) {
        .schedule-day {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
    }

    /* Desktop: restore larger block padding */
    @media (min-width: 64rem) {
        .schedule-day {
            padding-block: var(--space-sm);
        }
    }

    /* Tablet: two days side by side */
    @media (min-width: 56rem) {
        .schedule-days {
            grid-template-columns: 1fr 1fr;
        }

        .schedule-day {
            padding-inline: var(--space-md);
        }

        .schedule-day:first-child {
            padding-inline-start: 0;
        }

        .schedule-day:last-child {
            justify-content: space-between;
            padding-inline-end: 0;
        }
    }

    /* ── Section labels ───────────────────────────────────────────── */

    .section-label {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
        color: var(--color-paper);
        margin: 0;
    }

    /* ── Content sections ─────────────────────────────────────────── */

    .section {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-md) 0;
        align-items: start;
        padding-block: var(--space-xl);
        border-block-start: var(--border);
    }

    /* Tablet: section label goes vertical alongside content */
    @media (min-width: 56rem) {
        .section-label {
            writing-mode: vertical-lr;
            rotate: 180deg;
            place-self: start;
            /* Offset half-leading of adjacent prose (line-height 1.4, font-size 1.125rem) */
            translate: 0 0.75rem;
        }

        .section {
            grid-template-columns: auto 1fr;
            gap: 0 var(--space-xl);
        }
    }
</style>
