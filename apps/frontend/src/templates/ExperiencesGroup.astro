---
import type { Group } from "../lib/experiences";

import WpImage from "../components/elements/WpImage.astro";
import MusicList from "../components/experiences/MusicList.astro";
import InstallationsList from "../components/experiences/InstallationsList.astro";

interface Props {
    group: Group;
}

const { group } = Astro.props;
---

<section>
    <div class="section-body intro" set:html={group.description.html} />

    {group.layout === "music" && <MusicList items={group.items} />}
    {group.layout === "installations" && (
        <InstallationsList items={group.items} />
    )}
    {group.layout === "food" && (
        <ul class="food-list">
            {group.items.map((item) => (
                <li>
                    {item.image && (
                        <WpImage
                            image={item.image}
                            width={600}
                            height={600}
                            alt={item.name}
                        />
                    )}
                    <div>
                        <p>{item.name}</p>
                        <div set:html={item.description.html} />
                    </div>
                </li>
            ))}
        </ul>
    )}
</section>

<style>
    section {
        padding-block-end: var(--space-xl);
    }

    .intro {
        margin-block-end: var(--space-md);
    }

    /* ── Food & drink ─────────────────────────────────────────────── */
    .food-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-md);
    }

    @media (min-width: 30rem) {
        .food-list {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 48rem) {
        .food-list {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .food-list li {
        border: var(--border-default);
        overflow: hidden;
    }

    .food-list li :global(img) {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
        object-fit: cover;
    }

    .food-list li > div {
        padding: var(--space-sm);
    }

    .food-list li p {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        line-height: var(--line-height-tight);
        letter-spacing: var(--letter-spacing-tight);
        margin-block-end: var(--space-xs);
    }

    .food-list li div > div {
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
        color: var(--color-text-muted);
        margin: 0;
    }
</style>
