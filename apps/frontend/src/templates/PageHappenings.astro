---
import Layout from "../layouts/Layout.astro";

import type { PageHappeningsData } from "../content.config";
import WpImage from "../components/elements/WpImage.astro";

type Props = {
    page: PageHappeningsData;
};

const { page } = Astro.props;

const { title, content, schedule, groups } = page;
---

<Layout title={title}>
    <h1>{title}</h1>

    <div set:html={content.html} />

    <h2>Schedule</h2>

    <ul class="schedule">
        {
            schedule.map(({ day, events }) => (
                <li class="schedule-day">
                    <h3 class="schedule-day-heading">{day}</h3>
                    <ul class="schedule-events">
                        {events.map((event) => (
                            <li class="schedule-event">
                                {event.startTime} - {event.title}
                            </li>
                        ))}
                    </ul>
                </li>
            ))
        }
    </ul>

    <h2>Groups</h2>

    <ul class="groups">
        {
            groups.map((group) => (
                <li class="group">
                    <h3 class="group-title">{group.title}</h3>

                    <div
                        class="group-content"
                        set:html={group.description.html}
                    />

                    <ul class="group-items">
                        {group.items.map((item) => (
                            <li class="group-item">
                                <h4>{item.name}</h4>

                                {item.image && (
                                    <WpImage
                                        class="group-item-image"
                                        image={item.image}
                                    />
                                )}

                                <div
                                    class="group-item-description"
                                    set:html={item.description.html}
                                />
                            </li>
                        ))}
                    </ul>
                </li>
            ))
        }
    </ul>
</Layout>
