---
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getSchedulePage } from "../lib/experience-pages";
import Svg from "../components/elements/Svg.astro";
import PageIntro from "../components/site/PageIntro.astro";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const { page } = Astro.props;

const data = await getSchedulePage();

if (!data) {
    throw new Error(
        "Schedule page is missing — create a page using the Schedule template.",
    );
}

const { schedule } = data;
---

<Layout
    title={page.title}
    metaDescription={page.metaDescription}
    ogImage={page.image}
    ctaCompact
>
    <PageIntro
        title={page.title}
        descriptionHtml={data.page.data.content?.html}
    />

    <section>
        {
            schedule.map((dayData, dayIndex) => (
                <div id={`day-${dayIndex}`} class="day-panel">
                    <ol class="day-toggle" role="list">
                        {schedule.map((d, i) => (
                            <li>
                                <a
                                    data-day={i}
                                    href={`#day-${i}`}
                                    aria-current={
                                        i === dayIndex ? "true" : "false"
                                    }
                                >
                                    {d.date && (
                                        <span class="toggle-date">
                                            {d.date}
                                        </span>
                                    )}
                                    {d.day}
                                </a>
                            </li>
                        ))}
                    </ol>
                    <ul>
                        {dayData.events.map((event) => (
                            <li>
                                {event.href ? (
                                    <a class="event-row" href={event.href}>
                                        <span class="time">
                                            {event.startTime}
                                        </span>
                                        <p class="title">{event.title}</p>
                                        <span class="event-icon">
                                            <Svg name="chevron-right" alt="" />
                                        </span>
                                    </a>
                                ) : (
                                    <div class="event-row">
                                        <span class="time">
                                            {event.startTime}
                                        </span>
                                        <p class="title">{event.title}</p>
                                    </div>
                                )}
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </section>
</Layout>

<script>
    import { makeColorPicker, CYCLE_INTERVAL_MS } from "../scripts/accents";

    const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;
    const nextAccent = makeColorPicker(2);

    document.querySelectorAll<HTMLElement>("[data-day]").forEach((link) => {
        let timer: ReturnType<typeof setInterval>;
        link.addEventListener("mouseenter", () => {
            link.style.color = nextAccent();
            if (!reducedMotion) {
                timer = setInterval(() => {
                    link.style.color = nextAccent();
                }, CYCLE_INTERVAL_MS);
            }
        });
        link.addEventListener("mouseleave", () => {
            clearInterval(timer);
            link.style.color = "";
        });
    });

    document
        .querySelectorAll<HTMLElement>(".day-panel li:has(a.event-row)")
        .forEach((li) => {
            const title = li.querySelector<HTMLElement>(".title");
            const time = li.querySelector<HTMLElement>(".time");
            const icon = li.querySelector<HTMLElement>(".event-icon");
            let timer: ReturnType<typeof setInterval>;

            li.addEventListener("mouseenter", () => {
                const color = nextAccent();
                if (title) title.style.color = color;
                if (time) time.style.color = color;
                if (icon) icon.style.background = color;
                if (!reducedMotion) {
                    timer = setInterval(() => {
                        const c = nextAccent();
                        if (title) title.style.color = c;
                        if (time) time.style.color = c;
                        if (icon) icon.style.background = c;
                    }, CYCLE_INTERVAL_MS);
                }
            });
            li.addEventListener("mouseleave", () => {
                clearInterval(timer);
                if (title) title.style.color = "";
                if (time) time.style.color = "";
                if (icon) icon.style.background = "";
            });
        });

    // On Saturday, jump to day-1 if no anchor already in URL.
    if (!window.location.hash && new Date().getDay() === 6) {
        document.getElementById("day-1")?.scrollIntoView();
    }
</script>

<style>
    section {
        padding-block-end: var(--space-xl);
    }

    .day-toggle {
        display: flex;
        list-style: none;
        margin: 0;
        padding: 0;
        position: sticky;
        top: var(--header-height);
        z-index: 50;
        background: var(--color-bg);
        border-block-end: var(--border-default);
    }

    .day-toggle li {
        flex: 1;
        container-type: inline-size;
    }

    .day-toggle a {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: var(--space-sm);
        width: 100%;
        padding: var(--space-sm) var(--space-sm);
        font-size: 12cqi;
        white-space: nowrap;
        font-family: inherit;
        line-height: var(--line-height-tight);
        color: var(--color-text-muted);
        text-align: center;
        text-transform: uppercase;
        text-decoration: none;
    }

    .toggle-date {
        color: inherit;
    }

    .day-toggle a[aria-current="true"] {
        background: var(--color-text-on-bg);
        color: var(--color-text);
        font-weight: var(--font-weight-bold);
    }

    .day-panel {
        scroll-margin-top: calc(var(--header-height) + 3.5rem);
    }

    .day-panel + .day-panel {
        margin-block-start: var(--space-xl);
    }

    .day-panel ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .day-panel li {
        border-block-start: var(--border-default);
    }

    .day-panel ul li:first-child {
        border-block-start: none;
    }

    .day-panel li:has(a.event-row):hover :global(.event-icon) {
        color: var(--color-text);
    }

    .event-row {
        display: grid;
        grid-template-columns: var(--schedule-time-col) 1fr;
        gap: var(--space-md);
        padding-block: var(--space-md);
        align-items: center;
        position: relative;
    }

    .time {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-light);
        color: var(--color-text-muted);
        line-height: var(--line-height-tight);
        letter-spacing: var(--letter-spacing-tight);
        font-variant-numeric: tabular-nums;
    }

    .title {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-bold);
        line-height: var(--line-height-tight);
        min-width: 0;
        margin: 0;
    }

    @media (min-width: 40rem) {
        .time,
        .title {
            font-size: var(--font-size-lg);
        }
    }

    a.event-row {
        text-decoration: none;
        color: inherit;
    }

    .event-icon {
        color: var(--color-text-muted);
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        width: calc(var(--space-md) * 1.75);
        height: calc(var(--space-md) * 1.75);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    @media (min-width: 40rem) {
        .event-icon {
            width: calc(var(--space-md) * 2.5);
            height: calc(var(--space-md) * 2.5);
        }
    }

    .event-icon :global(svg) {
        width: 1rem;
        height: 1rem;
    }

    @media (min-width: 40rem) {
        .event-icon :global(svg) {
            width: 1.25rem;
            height: 1.25rem;
        }
    }
</style>
