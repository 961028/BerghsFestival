---
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getSchedulePage } from "../lib/experience-pages";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const { page } = Astro.props;

const data = await getSchedulePage();

if (!data) {
    throw new Error("Schedule page is missing — create a page using the Schedule template.");
}

const { description, schedule } = data;
---

<Layout
    title={page.title}
    metaDescription={page.metaDescription}
    ogImage={page.image}
    ctaCompact
>
    <h1 class="page-title" data-scramble>{page.title}</h1>

    <section>
        {description && (
            <div class="section-body intro" set:html={description.html} />
        )}

        <ol class="day-toggle" role="group" aria-label="Select day">
            {
                schedule.map((dayData, i) => (
                    <li>
                        <button
                            data-day={i}
                            aria-pressed={i === 0 ? "true" : "false"}
                        >
                            {dayData.day}
                        </button>
                    </li>
                ))
            }
        </ol>

        {
            schedule.map((dayData, dayIndex) => (
                <div data-day-panel={dayIndex} hidden>
                    <ul>
                        {dayData.events.map((event) => (
                            <li>
                                <span class="time">{event.startTime}</span>
                                <div class="event">
                                    <p class="title">{event.title}</p>
                                    {event.description && (
                                        <p class="description">
                                            {event.description}
                                        </p>
                                    )}
                                </div>
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </section>
</Layout>

<script>
    const dayPills = document.querySelectorAll<HTMLButtonElement>("[data-day]");
    const dayPanels =
        document.querySelectorAll<HTMLElement>("[data-day-panel]");

    function selectDay(dayIndex: number) {
        dayPills.forEach((p) => {
            p.setAttribute(
                "aria-pressed",
                String(Number(p.dataset.day) === dayIndex),
            );
        });
        dayPanels.forEach((p) => {
            p.hidden = Number(p.dataset.dayPanel) !== dayIndex;
        });
    }

    dayPills.forEach((pill) => {
        pill.addEventListener("click", () =>
            selectDay(Number(pill.dataset.day)),
        );
    });

    // Default day: Saturday (day 6) → index 1, otherwise → index 0.
    const defaultDay = new Date().getDay() === 6 ? 1 : 0;

    selectDay(defaultDay);
</script>

<style>
    section {
        padding-block-end: var(--space-xl);
    }

    .intro {
        margin-block-end: var(--space-md);
    }

    .day-toggle {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 1fr;
        list-style: none;
        margin: 0;
        padding: 0;
        position: sticky;
        top: var(--header-height);
        z-index: 50;
        background: var(--color-bg);
        border-block-end: var(--border-default);
    }

    .day-toggle button {
        appearance: none;
        background: none;
        border: none;
        width: 100%;
        padding: var(--space-sm) var(--space-xs);
        font-size: var(--font-size-base);
        font-family: inherit;
        line-height: var(--line-height-tight);
        color: var(--color-text-muted);
        cursor: pointer;
        text-align: center;
        text-transform: lowercase;
    }

    .day-toggle button[aria-pressed="true"] {
        background: var(--color-text-on-bg);
        color: var(--color-text);
        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
    }

    [data-day-panel] ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    [data-day-panel] li {
        display: grid;
        grid-template-columns: var(--schedule-time-col) 1fr;
        gap: var(--space-md);
        padding-block: var(--space-md);
        border-block-start: var(--border-default);
    }

    @media (min-width: 64rem) {
        [data-day-panel] li {
            padding-block: var(--space-lg);
        }
    }

    .time {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        color: var(--color-text-muted);
        line-height: var(--line-height-tight);
        letter-spacing: var(--letter-spacing-tight);
        font-variant-numeric: tabular-nums;
    }

    .event {
        display: flex;
        flex-direction: column;
        gap: var(--space-xxs);
        min-width: 0;
    }

    .title {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-bold);
        line-height: var(--line-height-tight);
    }

    .description {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-normal);
        line-height: var(--line-height-base);
        color: var(--color-text-muted);
    }
</style>
