---
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getSchedulePage } from "../lib/experience-pages";
import Svg from "../components/elements/Svg.astro";
import PageIntro from "../components/site/PageIntro.astro";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const { page } = Astro.props;

const data = await getSchedulePage();

if (!data) {
    throw new Error(
        "Schedule page is missing — create a page using the Schedule template.",
    );
}

const { schedule } = data;
---

<Layout
    title={page.title}
    metaDescription={page.metaDescription}
    ogImage={page.image}
    ctaCompact
>
    <PageIntro
        title={page.title}
        descriptionHtml={data.page.data.content?.html}
    />

    <section aria-labelledby="page-title">
        <div
            class="day-toggle"
            role="tablist"
            aria-label="Festival days"
        >
            {schedule.map((d, i) => (
                <div class="day-tab-cell" role="presentation">
                    <button
                        type="button"
                        role="tab"
                        id={`day-tab-${i}`}
                        aria-controls={`day-${i}`}
                        aria-selected={i === 0 ? "true" : "false"}
                        tabindex={i === 0 ? 0 : -1}
                    >
                        {d.day}
                    </button>
                </div>
            ))}
        </div>
        {
            schedule.map((dayData, dayIndex) => (
                <div
                    id={`day-${dayIndex}`}
                    class="day-panel"
                    role="tabpanel"
                    aria-labelledby={`day-tab-${dayIndex}`}
                    tabindex="0"
                    hidden={dayIndex !== 0}
                >
                    <ul role="list">
                        {dayData.events.map((event) => (
                            <li>
                                {event.href ? (
                                    <a class="event-row" href={event.href}>
                                        <span class="time">
                                            {event.startTime}
                                        </span>
                                        <p class="title">{event.title}</p>
                                        <span class="event-icon">
                                            <Svg name="chevron-right" alt="" />
                                        </span>
                                    </a>
                                ) : (
                                    <div class="event-row">
                                        <span class="time">
                                            {event.startTime}
                                        </span>
                                        <p class="title">{event.title}</p>
                                    </div>
                                )}
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </section>
</Layout>

<script>
    import { attachAccentCycle, makeColorPicker } from "../scripts/accents";

    const nextAccent = makeColorPicker(2);

    const dayTabs = Array.from(
        document.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
    );
    const dayPanels = Array.from(
        document.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
    );

    function selectDay(index: number, focus = false) {
        dayTabs.forEach((tab, i) => {
            const selected = i === index;
            tab.setAttribute("aria-selected", selected ? "true" : "false");
            tab.tabIndex = selected ? 0 : -1;
            if (selected && focus) tab.focus();
        });
        dayPanels.forEach((panel, i) => {
            panel.hidden = i !== index;
        });
    }

    dayTabs.forEach((tab, index) => {
        attachAccentCycle(tab, (c) => (tab.style.color = c), nextAccent);
        tab.addEventListener("click", () => selectDay(index));
        tab.addEventListener("keydown", (e) => {
            const last = dayTabs.length - 1;
            let next = -1;
            switch (e.key) {
                case "ArrowRight":
                    next = index === last ? 0 : index + 1;
                    break;
                case "ArrowLeft":
                    next = index === 0 ? last : index - 1;
                    break;
                case "Home":
                    next = 0;
                    break;
                case "End":
                    next = last;
                    break;
                default:
                    return;
            }
            e.preventDefault();
            selectDay(next, true);
        });
    });

    document
        .querySelectorAll<HTMLElement>(".day-panel li:has(a.event-row)")
        .forEach((li) => {
            const title = li.querySelector<HTMLElement>(".title");
            const time = li.querySelector<HTMLElement>(".time");
            const icon = li.querySelector<HTMLElement>(".event-icon");
            attachAccentCycle(
                li,
                (c) => {
                    if (title) title.style.color = c;
                    if (time) time.style.color = c;
                    if (icon) icon.style.background = c;
                },
                nextAccent,
            );
        });

    if (
        !window.location.hash &&
        new Date().getDay() === 6 &&
        dayPanels.length > 1
    ) {
        selectDay(1);
    }
</script>

<style>
    section {
        padding-block-end: var(--space-xl);
    }

    .day-toggle {
        display: flex;
        position: sticky;
        top: var(--header-height);
        z-index: 50;
        background: var(--color-ink);
        border-block-end: var(--border);
    }

    .day-tab-cell {
        flex: 1;
        container-type: inline-size;
    }

    .day-toggle button {
        width: 100%;
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: var(--space-sm);
        padding: var(--space-sm) var(--space-sm);
        font-size: 16cqi;
        white-space: nowrap;
        font-family: inherit;
        line-height: var(--line-height-tight);
        color: var(--color-paper);
        text-align: center;
        text-transform: uppercase;
        background: transparent;
        border: 0;
        cursor: pointer;
    }

    .day-toggle button[aria-selected="true"] {
        background: var(--color-paper);
        color: var(--color-ink);
        font-weight: var(--font-weight-bold);
    }

    .day-panel {
        scroll-margin-top: calc(var(--header-height) + 3.5rem);
    }

    .day-panel:focus-visible {
        outline: none;
    }

    .day-panel ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .day-panel li {
        border-block-start: var(--border);
    }

    .day-panel ul li:first-child {
        border-block-start: none;
    }

    .day-panel li:has(a.event-row):hover :global(.event-icon) {
        color: var(--color-ink);
    }

    .event-row {
        display: grid;
        grid-template-columns: var(--schedule-time-col) 1fr;
        gap: var(--space-md);
        padding-block: var(--space-md);
        align-items: center;
        position: relative;
    }

    .time {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-light);
        color: var(--color-paper);
        line-height: var(--line-height-tight);
        letter-spacing: var(--letter-spacing-tight);
        font-variant-numeric: tabular-nums;
    }

    .title {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-bold);
        line-height: var(--line-height-tight);
        min-width: 0;
        margin: 0;
    }

    @media (min-width: 40rem) {
        .time,
        .title {
            font-size: var(--font-size-lg);
        }
    }

    a.event-row {
        text-decoration: none;
        color: inherit;
    }

    .event-icon {
        color: var(--color-paper);
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        width: calc(var(--space-md) * 1.75);
        height: calc(var(--space-md) * 1.75);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    @media (min-width: 40rem) {
        .event-icon {
            width: calc(var(--space-md) * 2.5);
            height: calc(var(--space-md) * 2.5);
        }
    }

    .event-icon :global(svg) {
        width: 1rem;
        height: 1rem;
    }

    @media (min-width: 40rem) {
        .event-icon :global(svg) {
            width: 1.25rem;
            height: 1.25rem;
        }
    }
</style>
