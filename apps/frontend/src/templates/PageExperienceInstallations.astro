---
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import InstallationsList from "../components/experiences/InstallationsList.astro";
import PageIntro from "../components/site/PageIntro.astro";
import { getInstallationsPage } from "../lib/experience-pages";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const { page } = Astro.props;

const data = await getInstallationsPage();

if (!data) {
    throw new Error(
        "Installations page is missing — create a page using the Installations template.",
    );
}
---

<Layout
    title={page.title}
    metaDescription={page.metaDescription}
    ogImage={page.image}
    ctaCompact
>
    <PageIntro title={page.title} descriptionHtml={data.description?.html} />

    <InstallationsList items={data.items} />
</Layout>
