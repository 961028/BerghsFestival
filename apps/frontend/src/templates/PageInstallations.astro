---
import Layout from "../layouts/Layout.astro";

import type { CollectionEntry } from "astro:content";
import { z } from "astro/zod";

import WpImage from "../components/elements/WpImage.astro";
import { reference } from "astro:content";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const GroupsSchema = z.array(
    z.object({
        title: z.string(),
        description: z.string().transform((val) => ({ html: val })),
        items: z.array(
            z.object({
                name: z.string(),
                image: z.coerce
                    .string()
                    .transform((val) =>
                        reference("media").nullable().parse(val),
                    ),
                description: z.string().transform((val) => ({ html: val })),
            }),
        ),
    }),
);

const { page } = Astro.props;

const { title, content, acf } = page;

const groups = GroupsSchema.parse(acf.groups);
---

<Layout title={title}>
    <h1>{title}</h1>

    <div set:html={content.html} />

    <h2>Groups</h2>

    <ul class="groups">
        {
            groups.map((group) => (
                <li class="group">
                    <h3 class="group-title">{group.title}</h3>

                    <div
                        class="group-content"
                        set:html={group.description.html}
                    />

                    <ul class="group-items">
                        {group.items.map((item) => (
                            <li class="group-item">
                                <h4>{item.name}</h4>

                                {item.image && (
                                    <WpImage
                                        class="group-item-image"
                                        image={item.image}
                                    />
                                )}

                                <div
                                    class="group-item-description"
                                    set:html={item.description.html}
                                />
                            </li>
                        ))}
                    </ul>
                </li>
            ))
        }
    </ul>
</Layout>
