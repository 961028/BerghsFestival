---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/elements/ProjectCard.astro";
import PageIntro from "../components/site/PageIntro.astro";
import { shuffle } from "es-toolkit";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

type Project = CollectionEntry<"projects">["data"];

const CLASS_TO_INDIVIDUAL_GROUP_TITLE: Record<string, string> = {
    CE: "AI Content Engineering Projects",
    GM: "Growth Marketing Projects",
    CD: "YOU Projects",
} as const;

const { page } = Astro.props;

const projects = shuffle(
    (await getCollection("projects")).map((entry) => entry.data),
);

const groupProjects = projects.filter((p) => p.type === "regular");
const individualProjects = projects.filter((p) => p.type !== "regular");

const classToIndividualProjects: Record<string, Project[]> = {};

individualProjects.forEach((project) => {
    const projectClass = project.teamMembers[0]?.class;

    if (projectClass && CLASS_TO_INDIVIDUAL_GROUP_TITLE[projectClass]) {
        classToIndividualProjects[projectClass] ??= [];
        classToIndividualProjects[projectClass].push(project);
    } else {
        classToIndividualProjects["other"] ??= [];
        classToIndividualProjects["other"].push(project);
    }
});

const individualSections: { heading: string; projects: Project[] }[] =
    Object.entries(classToIndividualProjects).map(
        ([projectClass, projects]) => ({
            heading:
                CLASS_TO_INDIVIDUAL_GROUP_TITLE[projectClass] ||
                "Other Individual Projects",
            projects,
        }),
    );
---

<Layout
    title={page.title}
    metaDescription={page.metaDescription}
    ogImage={page.image}
>
    <PageIntro title={page.title} descriptionHtml={page.content.html} />

    <div>
        <div class="filters" role="tablist" aria-label="Filter projects">
            <div class="btn-cell">
                <button
                    type="button"
                    role="tab"
                    id="filter-tab-group"
                    class="btn"
                    data-color-hover
                    aria-controls="filter-panel-group"
                    aria-selected="true"
                    tabindex="0"
                >
                    <span class="label-short" aria-hidden="true">Groups</span>
                    <span class="label-full">Group projects</span>
                </button>
            </div>
            <div class="btn-cell">
                <button
                    type="button"
                    role="tab"
                    id="filter-tab-individual"
                    class="btn"
                    data-color-hover
                    aria-controls="filter-panel-individual"
                    aria-selected="false"
                    tabindex="-1"
                >
                    <span class="label-short" aria-hidden="true"
                        >Individuals</span
                    >
                    <span class="label-full">Individual projects</span>
                </button>
            </div>
        </div>

        <div
            id="filter-panel-group"
            role="tabpanel"
            aria-labelledby="filter-tab-group"
        >
            <ul class="grid">
                {
                    groupProjects.map((project) => (
                        <li>
                            <ProjectCard project={project} />
                        </li>
                    ))
                }
            </ul>
        </div>

        <div
            id="filter-panel-individual"
            role="tabpanel"
            aria-labelledby="filter-tab-individual"
            hidden
        >
            {
                individualSections.map((section, i) => (
                    <section
                        class="individual-section"
                        aria-labelledby={`individual-section-${i}`}
                    >
                        <h2
                            id={`individual-section-${i}`}
                            class="section-heading"
                        >
                            {section.heading}
                        </h2>
                        <ul class="grid">
                            {section.projects.map((project) => (
                                <li>
                                    <ProjectCard project={project} />
                                </li>
                            ))}
                        </ul>
                    </section>
                ))
            }
        </div>
    </div>
</Layout>

<script>
    import { attachRgbSplit } from "../scripts/accents";

    const tabs = Array.from(
        document.querySelectorAll<HTMLButtonElement>('.filters [role="tab"]'),
    );
    const panels = tabs.map((tab) =>
        document.getElementById(tab.getAttribute("aria-controls")!),
    );

    function selectTab(index: number, focus = false) {
        tabs.forEach((tab, i) => {
            const selected = i === index;
            tab.setAttribute("aria-selected", selected ? "true" : "false");
            tab.tabIndex = selected ? 0 : -1;
            if (selected && focus) tab.focus();
        });
        panels.forEach((panel, i) => {
            if (panel) panel.hidden = i !== index;
        });
    }

    tabs.forEach((tab, index) => {
        attachRgbSplit(tab);
        tab.addEventListener("click", () => {
            selectTab(index);
        });
        tab.addEventListener("keydown", (e) => {
            const last = tabs.length - 1;
            let next = -1;
            switch (e.key) {
                case "ArrowRight":
                    next = index === last ? 0 : index + 1;
                    break;
                case "ArrowLeft":
                    next = index === 0 ? last : index - 1;
                    break;
                case "Home":
                    next = 0;
                    break;
                case "End":
                    next = last;
                    break;
                default:
                    return;
            }
            e.preventDefault();
            selectTab(next, true);
        });
    });
</script>

<style>
    .filters {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin-block-end: var(--space-lg);
    }

    .btn-cell {
        display: flex;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: var(--color-paper);
        color: var(--color-ink);
        font-family: inherit;
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-caps-lg);
        padding: var(--space-sm) var(--space-md);
        border: 0;
        cursor: pointer;
        min-block-size: max(44px, 2em);
        line-height: var(--line-height-none);
        white-space: nowrap;
    }

    .label-short {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    @media (max-width: 40rem) {
        .btn-cell {
            flex: 1;
            container-type: inline-size;
        }

        .btn {
            width: 100%;
            padding: var(--space-xs) var(--space-sm);
            font-size: clamp(0.875rem, 12cqi, var(--font-size-lg));
        }

        .label-full {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
        }

        .label-short {
            position: static;
            width: auto;
            height: auto;
            overflow: visible;
            clip-path: none;
            white-space: nowrap;
        }
    }

    .btn[aria-selected="false"] {
        background-color: transparent;
        color: var(--color-paper);
    }

    @media (forced-colors: active) {
        .btn[aria-selected="true"] {
            outline: 2px solid LinkText;
            outline-offset: -2px;
        }
    }

    .individual-section {
        margin-block-end: var(--space-xl);
    }

    .individual-section:last-child {
        margin-block-end: 0;
    }

    .section-heading {
        margin-block-end: var(--space-sm);
    }

    .grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-lg) var(--space-lg);
    }

    @media (min-width: 40rem) {
        .grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    .grid > li[hidden] {
        display: none;
    }

    [data-view][hidden] {
        display: none;
    }
</style>
