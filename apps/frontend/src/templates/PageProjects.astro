---
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/elements/ProjectCard.astro";
import PageIntro from "../components/site/PageIntro.astro";
import { getProjectsPage } from "../lib/experience-pages";

type Props = {
    page: CollectionEntry<"pages">["data"];
};

const { page } = Astro.props;

const data = await getProjectsPage();

if (!data) {
    throw new Error(
        "Projects page is missing — create a page using the Projects template.",
    );
}

const groupProjects = data.projects.filter((p) => p.type === "group");
const individualProjects = data.projects.filter(
    (p) => p.type === "individual",
);

const INDIVIDUAL_GROUPS = [
    { heading: "Content engineering projects", classes: ["Content Engineering"] },
    { heading: "Growth marketing projects", classes: ["Growth Marketing"] },
    { heading: "YOU projects", classes: ["Communication Design"] },
] as const;

const matchedClasses = new Set<string>(
    INDIVIDUAL_GROUPS.flatMap((g) => g.classes),
);

const individualSections = [
    ...INDIVIDUAL_GROUPS.map((group) => ({
        heading: group.heading,
        projects: individualProjects.filter((p) =>
            group.classes.includes(p.teamMembers[0]?.class ?? ""),
        ),
    })),
    {
        heading: "Other individual projects",
        projects: individualProjects.filter(
            (p) => !matchedClasses.has(p.teamMembers[0]?.class ?? ""),
        ),
    },
].filter((section) => section.projects.length > 0);
---

<Layout
    title={page.title}
    metaDescription={page.metaDescription}
    ogImage={page.image}
    ctaCompact
>
    <PageIntro title={page.title} descriptionHtml={data.description?.html} />

    <section>
        <div class="filters" role="group" aria-label="Filter projects">
            <button class="btn" data-filter="group" aria-pressed="true">
                Group projects
            </button>
            <button class="btn" data-filter="individual" aria-pressed="false">
                Individual projects
            </button>
        </div>

        <div data-view="group">
            <ul class="grid">
                {
                    groupProjects.map((project) => (
                        <li>
                            <ProjectCard
                                company={project.company}
                                image={project.image}
                                teamMembers={project.teamMembers}
                                href={`/projects/${project.slug}`}
                            />
                        </li>
                    ))
                }
            </ul>
        </div>

        <div data-view="individual" hidden>
            {
                individualSections.map((section) => (
                    <section class="individual-section">
                        <h2 class="section-heading">{section.heading}</h2>
                        <ul class="grid">
                            {section.projects.map((project) => (
                                <li>
                                    <ProjectCard
                                        company={project.company}
                                        image={project.image}
                                        teamMembers={project.teamMembers}
                                        href={`/projects/${project.slug}`}
                                    />
                                </li>
                            ))}
                        </ul>
                    </section>
                ))
            }
        </div>
    </section>
</Layout>

<script>
    const buttons =
        document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const views = document.querySelectorAll<HTMLElement>("[data-view]");

    const applyFilter = (filterType: string | undefined) => {
        views.forEach((view) => {
            view.hidden = view.dataset.view !== filterType;
        });
    };

    buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
            if (btn.getAttribute("aria-pressed") === "true") return;
            buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
            btn.setAttribute("aria-pressed", "true");
            applyFilter(btn.dataset.filter);
        });
    });
</script>

<style>
    section {
        padding-block-end: var(--space-xl);
    }

    .filters {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin-block-end: var(--space-md);
    }

    .btn {
        display: inline-flex;
        align-items: center;
        background-color: var(--color-paper);
        color: var(--color-ink);
        font-family: inherit;
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-bold);
        padding: var(--space-sm) var(--space-md);
        border: 0;
        cursor: pointer;
        min-block-size: max(44px, 2em);
        line-height: 1;
    }

    .btn[aria-pressed="false"] {
        background-color: transparent;
        color: var(--color-paper);
        border: var(--border);
    }

    @media (any-hover: hover) and (any-pointer: fine) {
        .btn[aria-pressed="false"]:hover {
            background-color: var(--color-paper);
            color: var(--color-ink);
        }
    }

    .grid {
        --col-min: 20rem;
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(
            auto-fill,
            minmax(min(100%, var(--col-min)), 1fr)
        );
        gap: var(--space-md) var(--space-lg);
    }

    .grid > li[hidden] {
        display: none;
    }

    [data-view][hidden] {
        display: none;
    }

    .individual-section + .individual-section {
        margin-block-start: var(--space-xl);
    }

    .section-heading {
        margin: 0 0 var(--space-md);
    }
</style>
