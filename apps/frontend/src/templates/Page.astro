---
import type { CollectionEntry } from 'astro:content'
import Layout from '../layouts/Layout.astro';

type Props = {
    page: CollectionEntry<"pages">,
};

const { page } = Astro.props;

const { title, content } = page.data;
---

<Layout title={title}>
	<h1>{title}</h1>

	<div set:html={content.html} />
</Layout>
