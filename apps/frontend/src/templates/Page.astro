---
import type { PageDefaultData } from "../content.config";

import Layout from "../layouts/Layout.astro";

type Props = {
    page: PageDefaultData;
};

const { page } = Astro.props;

const { title, content } = page;
---

<Layout title={title}>
    <h1>{title}</h1>

    <div set:html={content.html} />
</Layout>
