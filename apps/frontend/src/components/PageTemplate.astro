---
import type { CollectionEntry } from "astro:content";

import PageDefault from "../templates/Page.astro";
import PageAbout from "../templates/PageAbout.astro";
import PageExperiences from "../templates/PageExperiences.astro";

interface Props {
    page: CollectionEntry<"pages">;
}

const SLUG_TO_TEMPLATE = {
    "page-about.php": PageAbout,
    "page-experiences.php": PageExperiences,
};

function isValidTemplate(
    slug: string | null,
): slug is keyof typeof SLUG_TO_TEMPLATE {
    return slug !== null && slug in SLUG_TO_TEMPLATE;
}

const page = Astro.props.page.data;

const Template = isValidTemplate(page.template)
    ? SLUG_TO_TEMPLATE[page.template]
    : PageDefault;
---

<Template page={page} />
