---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

import PageDefault from "../templates/Page.astro";
import PageAboutBerghs from "../templates/PageAboutBerghs.astro";
import PageExperiences from "../templates/PageExperiences.astro";
import PageHome from "../templates/PageHome.astro";

interface Props {
    page: CollectionEntry<"pages">;
}

const settings = (await getCollection("settings"))[0].data;
const page = Astro.props.page.data;

const isFrontPage = settings.pageOnFront?.id === page.id;
---

{isFrontPage ? (
    <PageHome page={page} />
) : page.template === "page-about-berghs.php" ? (
    <PageAboutBerghs page={page} />
) : page.template === "page-experiences.php" ? (
    <PageExperiences page={page} />
) : (
    <PageDefault page={page} />
)}
