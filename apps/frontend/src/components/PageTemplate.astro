---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

import PageDefault from "../templates/Page.astro";
import PageAboutBerghs from "../templates/PageAboutBerghs.astro";
import PageHome from "../templates/PageHome.astro";
import PageSchedule from "../templates/PageSchedule.astro";
import PageExperienceMusic from "../templates/PageExperienceMusic.astro";
import PageExperienceInstallations from "../templates/PageExperienceInstallations.astro";
import PageExperienceFood from "../templates/PageExperienceFood.astro";
import PageProjects from "../templates/PageProjects.astro";

interface Props {
    page: CollectionEntry<"pages">;
}

const SLUG_TO_TEMPLATE = {
    "page-about-berghs.php": PageAboutBerghs,
    "page-schedule.php": PageSchedule,
    "page-experience-music.php": PageExperienceMusic,
    "page-experience-installations.php": PageExperienceInstallations,
    "page-experience-food.php": PageExperienceFood,
    "page-projects.php": PageProjects,
};

function isValidTemplate(
    slug: string | null,
): slug is keyof typeof SLUG_TO_TEMPLATE {
    return slug !== null && slug in SLUG_TO_TEMPLATE;
}

const settings = (await getCollection("settings"))[0].data;
const page = Astro.props.page.data;

const isFrontPage = settings.pageOnFront?.id === page.id;

const Template = isFrontPage
    ? PageHome
    : isValidTemplate(page.template)
      ? SLUG_TO_TEMPLATE[page.template]
      : PageDefault;
---

<Template page={page} />
