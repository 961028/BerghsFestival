---
import { getCollection } from "astro:content";
import { z } from "astro/zod";

type Props = {
    compact?: boolean;
};

const { compact = false } = Astro.props;

const RegistrationUrlSchema = z.string().optional().catch(undefined);
const RegisterLabelSchema = z
    .string()
    .transform((v) => v.trim())
    .refine((v) => v.length > 0)
    .catch("Register now");

const FestivalDaysSchema = z
    .array(
        z.object({
            abbr: z.string(),
            date: z.string(),
            hours: z.string(),
        }),
    )
    .catch([]);

const settings = (await getCollection("settings"))[0].data;
const pages = await getCollection("pages");
const homePage = pages.find((p) => settings.pageOnFront?.id === p.data.id);
const acf = homePage?.data.acf;

const registrationUrl = RegistrationUrlSchema.parse(acf?.registration_url);
const registerLabel = RegisterLabelSchema.parse(acf?.register_label);
const festivalDays = FestivalDaysSchema.parse(acf?.festival_days);

// Derive month + year from opening_date (format: "YYYY-MM-DD HH:mm:ss")
const openingDateRaw: string | undefined = acf?.opening_date as
    | string
    | undefined;
const openingDate = openingDateRaw
    ? new Date(openingDateRaw.replace(" ", "T"))
    : null;
const monthYear = openingDate
    ? openingDate
          .toLocaleDateString("en-GB", { month: "short", year: "numeric" })
          .toUpperCase()
    : null;

const venue = acf?.venue as string | undefined;

// Build a compact date range string, e.g. "22–23 MAY 2026"
const ctaDates =
    festivalDays.length && monthYear
        ? `${festivalDays.map((d) => d.date).join("–")} ${monthYear}`
        : null;
---

<aside
    class:list={["cta-banner", { "cta-banner--compact": compact }]}
    id="cta"
    data-region="cta"
    aria-label="Apply to Berghs Festival"
    tabindex="-1"
>
    <a
        href={registrationUrl}
        class="cta-inner"
        aria-label={ctaDates
            ? `${registerLabel} — ${ctaDates}${venue ? ` — ${venue}` : ""}`
            : registerLabel}
    >
        <span class="cta-action" data-scramble>{registerLabel}</span>
        {
            ctaDates && (
                <span class="cta-details">
                    <span class="cta-dates" data-scramble>
                        {ctaDates}
                    </span>
                    {venue && (
                        <>
                            <span class="cta-separator" aria-hidden="true">
                                &mdash;
                            </span>
                            <span class="cta-venue" data-scramble>
                                {venue}
                            </span>
                        </>
                    )}
                </span>
            )
        }
    </a>
</aside>

<style>
    .cta-banner {
        position: fixed;
        inset-inline: 0;
        bottom: 0;
        z-index: 200;
        height: var(--cta-height);
        background: var(--color-accent-1);
        color: var(--color-text);
        border-block-start: var(--border-thick);
    }

    .cta-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        align-content: center;
        justify-content: space-between;
        max-width: var(--max-width);
        height: 100%;
        margin-inline: auto;
        padding-inline: var(--site-padding-inline);
        color: inherit;
        text-decoration: none;
        gap: var(--space-xxs) var(--space-md);
    }

    .cta-details {
        /* Full width forces details below .cta-action on mobile.
           flex-direction: column stacks dates and venue into separate lines. */
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0;
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-label);
    }

    .cta-dates,
    .cta-venue {
        white-space: nowrap;
    }

    .cta-separator {
        display: none;
    }

    /* Large phone: dates + separator + venue on one row */
    @media (min-width: 30rem) {
        .cta-details {
            flex-direction: row;
            align-items: center;
            gap: 0 var(--space-xs);
        }

        .cta-separator {
            display: inline;
        }
    }

    /* Tablet: CTA goes to 1 line — all content on a single row */
    @media (min-width: 48rem) {
        .cta-inner {
            flex-wrap: nowrap;
        }

        .cta-details {
            width: auto;
        }
    }

    .cta-action {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-label);
        line-height: 1;
        white-space: nowrap;
    }

    /* Compact variant — hide the dates/venue line below the desktop
       breakpoint. Desktop (64rem+) shows the full CTA. */
    @media (max-width: 63.999rem) {
        .cta-banner--compact .cta-details {
            display: none;
        }
    }

    /* Overlay must use the same color as CTA text, not the global default */
    [data-scramble]::before {
        color: var(--color-text);
    }

    /* Full inversion on focus — always high-contrast regardless of accent color */
    .cta-banner:has(.cta-inner:focus-visible) {
        background: var(--color-text-on-bg);
    }

    .cta-inner:focus-visible {
        outline: none;
        color: var(--color-bg);
        /* Fallback for forced-colors / high-contrast mode where background is ignored */
        box-shadow: inset 0 0 0 max(2px, 0.15em) var(--color-bg);
    }

    @media (any-hover: hover) and (any-pointer: fine) {
        .cta-inner:hover {
            color: var(--color-text-on-bg);
        }
    }
</style>
