---
---

<aside class="cta-banner" data-region="cta">
    <a href="#" class="cta-inner">
        <span class="cta-dates">14–15 MAY 2026</span>
        <span class="cta-action">Register now →</span>
    </a>
</aside>

<style>
    .cta-banner {
        position: fixed;
        inset-inline: 0;
        bottom: 0;
        z-index: 200;
        background: var(--color-accent-1);
        color: var(--color-text);
        border-block-start: 2px solid var(--color-text);
    }

    .cta-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: var(--max-width);
        margin-inline: auto;
        padding: var(--space-sm) var(--site-padding-inline);
        color: inherit;
        text-decoration: none;
        gap: var(--space-md);
    }

    @media (max-width: 40rem) {
        .cta-inner {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-xxs);
        }
    }

    .cta-dates {
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-normal);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-label);
        flex: 1;
    }

    .cta-action {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-label);
        line-height: 1;
    }

    @media (any-hover: hover) and (any-pointer: fine) {
        .cta-inner:hover .cta-action {
            opacity: 0.6;
        }
    }
</style>
