---
import { getCollection } from "astro:content";
import { z } from "astro/zod";

const RegistrationUrlSchema = z.string().optional().catch(undefined);

const FestivalDaysSchema = z
    .array(
        z.object({
            abbr: z.string(),
            date: z.string(),
            hours: z.string(),
        }),
    )
    .catch([]);

const settings = (await getCollection("settings"))[0].data;
const pages = await getCollection("pages");
const homePage = pages.find((p) => settings.pageOnFront?.id === p.data.id);
const acf = homePage?.data.acf;

const registrationUrl = RegistrationUrlSchema.parse(acf?.registration_url);
const festivalDays = FestivalDaysSchema.parse(acf?.festival_days);

// Derive month + year from opening_date (format: "YYYY-MM-DD HH:mm:ss")
const openingDateRaw: string | undefined = acf?.opening_date as
    | string
    | undefined;
const openingDate = openingDateRaw
    ? new Date(openingDateRaw.replace(" ", "T"))
    : null;
const monthYear = openingDate
    ? openingDate
          .toLocaleDateString("en-GB", { month: "short", year: "numeric" })
          .toUpperCase()
    : null;

const venue = acf?.venue as string | undefined;

// Build a compact date range string, e.g. "22–23 MAY 2026"
const ctaDates =
    festivalDays.length && monthYear
        ? `${festivalDays.map((d) => d.date).join("–")} ${monthYear}`
        : null;
---

<aside
    class="cta-banner"
    id="cta"
    data-region="cta"
    aria-label="Apply to Berghs Festival"
    tabindex="-1"
>
    <a
        href={registrationUrl}
        class="cta-inner"
        aria-label={ctaDates
            ? `Register now — ${ctaDates}${venue ? ` — ${venue}` : ""}`
            : "Register now"}
    >
        <span class="cta-action" data-scramble>Register now</span>
        {
            ctaDates && (
                <span class="cta-details">
                    <span class="cta-dates" data-scramble>{ctaDates}</span>
                    {venue && (
                        <>
                            <span class="cta-separator" aria-hidden="true">&mdash;</span>
                            <span class="cta-venue" data-scramble>{venue}</span>
                        </>
                    )}
                </span>
            )
        }
    </a>
</aside>

<style>
    .cta-banner {
        position: fixed;
        inset-inline: 0;
        bottom: 0;
        z-index: 200;
        height: var(--cta-height);
        background: var(--color-accent-1);
        color: var(--color-text);
        border-block-start: var(--border-thick);
        container-type: inline-size;
    }

    .cta-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        align-content: center;
        justify-content: space-between;
        max-width: var(--max-width);
        height: 100%;
        margin-inline: auto;
        padding-inline: var(--site-padding-inline);
        color: inherit;
        text-decoration: none;
        gap: var(--space-xxs) var(--space-md);
    }

    .cta-details {
        /* Full width forces details below .cta-action in the wrapped state,
           preventing a premature 3→2 line jump before the 27rem breakpoint. */
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0 var(--space-xs);
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-label);
    }

    .cta-dates,
    .cta-venue {
        white-space: nowrap;
    }

    .cta-separator {
        display: none;
    }

    /* 27rem: CTA goes from 3 lines to 2 lines.
       The CTA container is full-viewport-width (position: fixed; inset-inline: 0),
       so container queries here use the same values as the global viewport breakpoints. */
    @container (min-width: 27rem) {
        .cta-separator {
            display: inline;
        }

        .cta-details {
            width: auto;
            flex-wrap: nowrap;
        }
    }

    /* 50rem: CTA goes from 2 lines to 1 line. */
    @container (min-width: 50rem) {
        .cta-inner {
            flex-wrap: nowrap;
        }
    }

    .cta-action {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-label);
        line-height: 1;
        white-space: nowrap;
    }

    /* Overlay must use the same color as CTA text, not the global default */
    [data-scramble]::before {
        color: var(--color-text);
    }

    /* Full inversion on focus — always high-contrast regardless of accent color */
    .cta-banner:has(.cta-inner:focus-visible) {
        background: var(--color-text-on-bg);
    }

    .cta-inner:focus-visible {
        outline: none;
        color: var(--color-bg);
        /* Fallback for forced-colors / high-contrast mode where background is ignored */
        box-shadow: inset 0 0 0 max(2px, 0.15em) var(--color-bg);
    }

    @media (any-hover: hover) and (any-pointer: fine) {
        .cta-inner:hover {
            color: var(--color-text-on-bg);
        }
    }
</style>
