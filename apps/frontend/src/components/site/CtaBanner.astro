---
import { getCollection } from "astro:content";
import { z } from "astro/zod";

const RegistrationUrlSchema = z.string().optional().catch(undefined);

const settings = (await getCollection("settings"))[0].data;
const pages = await getCollection("pages");
const homePage = pages.find((p) => settings.pageOnFront?.id === p.data.id);
const acf = homePage?.data.acf;

const registrationUrl = RegistrationUrlSchema.parse(acf?.registration_url);
---

<aside
    class="cta-banner"
    id="cta"
    data-region="cta"
    aria-label="Apply to Berghs Festival"
    tabindex="-1"
>
    <a href={registrationUrl} class="cta-inner">
        <span class="cta-action" data-scramble>Watch the aftermovie →</span>
    </a>
</aside>

<style>
    .cta-banner {
        position: fixed;
        inset-inline: 0;
        bottom: 0;
        z-index: 200;
        height: var(--cta-height);
        background: var(
            --color-accent-1
        ); /* contrast may fall below WCAG AA 4.5:1 with some accent colors — accepted tradeoff for visual identity */
        color: var(--color-ink);
        border-block-start: var(--border);
    }

    .cta-inner {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        max-width: var(--max-width);
        height: 100%;
        margin-inline: auto;
        padding-inline: var(--site-padding-inline);
        color: inherit;
        text-decoration: none;
    }

    .cta-action {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-caps-lg);
        line-height: var(--line-height-tight);
    }

    /* Overlay must use the same color as CTA text, not the global default */
    [data-scramble] :global(.scramble-overlay) {
        color: var(--color-ink);
    }

    /* Full inversion on focus — always high-contrast regardless of accent color */
    .cta-banner:has(.cta-inner:focus-visible) {
        background: var(--color-paper);
    }

    .cta-inner:focus-visible {
        outline: none;
        color: var(--color-ink);
        /* Fallback for forced-colors / high-contrast mode where background is ignored */
        box-shadow: inset 0 0 0 max(2px, 0.15em) var(--color-ink);
    }

    @media (any-hover: hover) and (any-pointer: fine) {
        .cta-inner:hover {
            color: var(--color-paper);
        }
    }
</style>
