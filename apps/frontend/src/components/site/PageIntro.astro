---
type Props = {
    title: string;
    descriptionHtml?: string | null;
};

const { title, descriptionHtml } = Astro.props;
---

<h1 class="page-title" data-scramble>{title}</h1>

{descriptionHtml && (
    <div class="section-body intro" set:html={descriptionHtml} />
)}

<style>
    .intro {
        margin-block-end: var(--space-xl);
    }
</style>
