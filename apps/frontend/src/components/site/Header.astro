---
import { getCollection, getEntry } from "astro:content";
import Svg from "../elements/Svg.astro";
import { resolvePageLink } from "../../lib/content";

const menuLocation = await getEntry("menuLocations", "primary");
const menuItems = (
    await getCollection(
        "menuItems",
        (item) => item.data.menu === menuLocation?.data.menu,
    )
).sort((a, b) => a.data.order - b.data.order);

const pages = await getCollection("pages");
const aboutPage = pages.find(
    (p) => p.data.template === "page-about-berghs.php",
);
const aboutHref = aboutPage
    ? `/${await resolvePageLink(aboutPage)}`
    : "https://www.berghs.se/om-berghs/";
---

<!--
  MOBILE MENU — currently disabled (only one nav item).
  To re-enable when more nav items are added:

  1. Header.astro  — uncomment the <button class="menu-toggle"> block
  2. Header.astro  — uncomment the <div class="mobile-menu"> block
  3. Header.astro  — uncomment the CSS block near the bottom (marked "MOBILE MENU")
  4. header.ts     — uncomment the toggle logic block (marked "MOBILE MENU")
-->
<header>
    <nav aria-label="Site navigation">
        {
            /* <button
            class="menu-toggle"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Open menu"
        >
            <span class="bar bar-top"></span>
            <span class="bar bar-mid"></span>
            <span class="bar bar-bot"></span>
        </button> */
        }

        <ul class="nav-links">
            {
                menuItems.map((menuItem) => (
                    <li>
                        <a
                            href={menuItem.data.url}
                            aria-current={
                                Astro.url.pathname ===
                                new URL(menuItem.data.url).pathname
                                    ? "page"
                                    : undefined
                            }
                            class="nav-link"
                        >
                            <span class="nav-link-text" data-scramble>
                                {menuItem.data.title}
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>

        <a
            href={aboutHref}
            class="logo-link"
            aria-label="About Berghs School of Communication"
        >
            <Svg
                name="berghs-soc"
                alt=""
                style="width: auto; height: var(--font-size-base);"
            />
        </a>
    </nav>

    {
        /* <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
        {menuItems.map((menuItem) => (
            <a
                href={menuItem.data.url}
                aria-current={
                    Astro.url.pathname === new URL(menuItem.data.url).pathname
                        ? "page"
                        : undefined
                }
                class="nav-link"
            >
                <span class="nav-link-text">{menuItem.data.title}</span>
            </a>
        ))}
    </div> */
    }
</header>

<script src="../../scripts/header.ts"></script>

<style>
    header {
        border-block-end: var(--border-default);
        position: relative;
        z-index: 100;
    }

    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: var(--space-sm);
    }

    /* ── Hamburger button ── */

    .menu-toggle {
        --bar-w: 1.5rem;
        --bar-h: 2px;
        --bar-gap: 5px;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--bar-gap);
        width: max(44px, 2em);
        height: max(44px, 2em);
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        color: inherit;
    }

    .bar {
        display: block;
        width: var(--bar-w);
        height: var(--bar-h);
        background: currentColor;

        transform-origin: center;
        transition:
            transform 0.25s ease,
            opacity 0.15s ease;
    }

    .menu-toggle[aria-expanded="true"] .bar-top {
        transform: translateY(calc(var(--bar-gap) + var(--bar-h))) rotate(45deg);
    }

    .menu-toggle[aria-expanded="true"] .bar-mid {
        opacity: 0;
        transform: scaleX(0);
    }

    .menu-toggle[aria-expanded="true"] .bar-bot {
        transform: translateY(calc(-1 * (var(--bar-gap) + var(--bar-h))))
            rotate(-45deg);
    }

    .logo-link :global(svg) {
        fill: var(--color-text-on-bg);
    }

    /* ── Desktop nav links ── */

    .nav-links {
        display: flex;
        flex-direction: row;
        gap: var(--space-md);
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: var(--font-size-base);
        text-transform: lowercase;
    }

    .nav-link[aria-current="page"] {
        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
    }

    .nav-link:focus-visible,
    .logo-link:focus-visible {
        border-radius: 1px;
    }

    @media (min-width: 48rem) {
        .menu-toggle {
            display: none;
        }
    }

    /* MOBILE MENU: uncomment to hide nav-links on mobile */
    /*
    @media (max-width: 47.999rem) {
        .nav-links {
            display: none;
        }
    }
    */

    /* ── Mobile menu overlay ── */

    .mobile-menu {
        position: absolute;
        inset-inline: 0;
        top: 100%;
        background: var(--color-accent-1);
        color: var(--color-text);
        display: flex;
        flex-direction: column;
        padding-block: var(--space-lg);
        gap: var(--space-md);
        visibility: hidden;
        opacity: 0;
        translate: 0 calc(-1 * var(--space-xs));
        transition:
            opacity 0.2s ease,
            translate 0.2s ease,
            visibility 0s 0.2s;
    }

    .mobile-menu[aria-hidden="false"] {
        visibility: visible;
        opacity: 1;
        translate: 0 0;
        transition:
            opacity 0.2s ease,
            translate 0.2s ease,
            visibility 0s 0s;
    }

    .mobile-menu a {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        text-align: end;
    }
</style>
