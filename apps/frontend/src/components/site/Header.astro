---
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import Svg from "../elements/Svg.astro";
import { resolvePageLink } from "../../lib/content";

type MenuItem = CollectionEntry<"menuItems">["data"];
type MenuNode = MenuItem & { children: MenuItem[] };

const menuLocation = await getEntry("menuLocations", "primary");
const allItems = (
    await getCollection(
        "menuItems",
        (item) => item.data.menu === menuLocation?.data.menu,
    )
).map((entry) => entry.data);

allItems.sort((a, b) => a.order - b.order);

const tree: MenuNode[] = allItems
    .filter((item) => !item.parent)
    .map((item) => ({
        ...item,
        children: allItems.filter((child) => child.parent === String(item.id)),
    }));

const pages = await getCollection("pages");
const aboutPage = pages.find(
    (p) => p.data.template === "page-about-berghs.php",
);
const aboutHref = aboutPage
    ? `/${await resolvePageLink(aboutPage)}`
    : "https://www.berghs.se/om-berghs/";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

function menuItemPath(url: string): string {
    try {
        return new URL(url, Astro.url).pathname.replace(/\/$/, "") || "/";
    } catch {
        return url;
    }
}

---

<header>
    <nav aria-label="Site navigation">
        <button
            class="menu-toggle"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Open menu"
        >
            <span class="bar bar-top"></span>
            <span class="bar bar-mid"></span>
            <span class="bar bar-bot"></span>
        </button>

        <ul class="nav-links">
            {
                tree.map((node) => {
                    if (node.children.length > 0) {
                        const inSection = node.children.some(
                            (child) => currentPath === menuItemPath(child.url),
                        );
                        return (
                            <li class="has-submenu">
                                <button
                                    type="button"
                                    class="nav-link submenu-toggle"
                                    aria-expanded="false"
                                    aria-haspopup="true"
                                    aria-current={
                                        inSection ? "page" : undefined
                                    }
                                >
                                    <span class="nav-link-text" data-scramble>
                                        {node.title}
                                    </span>
                                    <Svg
                                        name="chevron-down"
                                        alt=""
                                        class="submenu-chevron"
                                    />
                                </button>
                                <ul class="submenu">
                                    {node.children.map((child) => (
                                        <li>
                                            <a
                                                href={child.url}
                                                class="nav-link submenu-link"
                                                aria-current={
                                                    currentPath ===
                                                    menuItemPath(child.url)
                                                        ? "page"
                                                        : undefined
                                                }
                                            >
                                                <span
                                                    class="nav-link-text"
                                                    data-scramble
                                                >
                                                    {child.title}
                                                </span>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </li>
                        );
                    }

                    return (
                        <li>
                            <a
                                href={node.url}
                                aria-current={
                                    currentPath === menuItemPath(node.url)
                                        ? "page"
                                        : undefined
                                }
                                class="nav-link"
                            >
                                <span class="nav-link-text" data-scramble>
                                    {node.title}
                                </span>
                            </a>
                        </li>
                    );
                })
            }
        </ul>

        <a
            href={aboutHref}
            class="logo-link"
            aria-label="About Berghs School of Communication"
        >
            <Svg
                name="berghs-soc"
                alt=""
                style="width: auto; height: var(--font-size-base);"
            />
        </a>
    </nav>

    <dialog
        class="mobile-menu"
        id="mobile-menu"
        aria-label="Site navigation"
        tabindex="-1"
    >
        {
            tree.map((node) => {
                if (node.children.length > 0) {
                    return node.children.map((child) => (
                        <a
                            href={child.url}
                            aria-current={
                                currentPath === menuItemPath(child.url)
                                    ? "page"
                                    : undefined
                            }
                            class="nav-link"
                        >
                            <span class="nav-link-text" data-scramble>
                                {child.title}
                            </span>
                        </a>
                    ));
                }

                return (
                    <a
                        href={node.url}
                        aria-current={
                            currentPath === menuItemPath(node.url)
                                ? "page"
                                : undefined
                        }
                        class="nav-link"
                    >
                        <span class="nav-link-text" data-scramble>
                            {node.title}
                        </span>
                    </a>
                );
            })
        }
    </dialog>
</header>

<script src="../../scripts/header.ts"></script>

<style>
    header {
        position: relative;
        z-index: 100;
        block-size: var(--header-height);
    }

    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        block-size: 100%;
    }

    /* ── Hamburger button ── */

    .menu-toggle {
        --bar-w: 1.5rem;
        --bar-h: 2px;
        --bar-gap: 5px;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--bar-gap);
        width: max(44px, 2em);
        height: max(44px, 2em);
        margin-inline-start: calc((var(--bar-w) - max(44px, 2em)) / 2);
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        color: inherit;
    }

    .bar {
        display: block;
        width: var(--bar-w);
        height: var(--bar-h);
        background: currentColor;

        transition:
            transform 0.25s ease,
            opacity 0.15s ease;
    }

    .menu-toggle[aria-expanded="true"] .bar-top {
        transform: translateY(calc(var(--bar-gap) + var(--bar-h))) rotate(45deg);
    }

    .menu-toggle[aria-expanded="true"] .bar-mid {
        opacity: 0;
        transform: scaleX(0);
    }

    .menu-toggle[aria-expanded="true"] .bar-bot {
        transform: translateY(calc(-1 * (var(--bar-gap) + var(--bar-h))))
            rotate(-45deg);
    }

    .logo-link :global(svg) {
        fill: var(--color-paper);
    }

    /* ── Desktop nav links ── */

    .nav-links {
        display: none;
        gap: var(--space-lg);
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: var(--font-size-base);
        text-transform: uppercase;
        min-width: 0;
        flex-wrap: wrap;
    }

    .submenu-toggle .nav-link-text {
        display: inline-block;
        padding-inline: 12px;
        margin-inline: -12px;
    }

    .nav-link[aria-current="page"] {
        font-weight: var(--font-weight-bold);
    }

    .submenu-link[aria-current="page"] {
        background: var(--color-paper);
        color: var(--color-ink);
    }

    .nav-link:focus-visible,
    .logo-link:focus-visible {
        border-radius: 1px;
    }

    /* ── Submenu (desktop) ── */
    .has-submenu {
        position: relative;
    }

    .submenu-toggle {
        appearance: none;
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        color: inherit;
        font: inherit;
        text-transform: inherit;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: var(--space-xxs);
    }

    .submenu-chevron {
        width: 0.75em;
        height: 0.75em;
        transition: transform 0.15s ease;
    }

    .submenu-toggle[aria-expanded="true"] .submenu-chevron {
        transform: rotate(180deg);
    }

    @media (prefers-reduced-motion: reduce) {
        .submenu-chevron {
            transition: none;
        }
    }

    .submenu {
        position: absolute;
        inset-inline-start: 0;
        inset-block-start: 100%;
        list-style: none;
        margin: 0;
        padding: var(--space-sm);
        background: var(--color-ink);
        border: var(--border);
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        min-width: max-content;
        visibility: hidden;
        opacity: 0;
        transition:
            opacity 0.15s ease,
            visibility 0s 0.15s;
    }

    .submenu-toggle[aria-expanded="true"] + .submenu {
        visibility: visible;
        opacity: 1;
        transition:
            opacity 0.15s ease,
            visibility 0s 0s;
    }

    .submenu-link {
        display: block;
        padding: var(--space-xs);
    }

    /* Tablet: hide hamburger, show full nav */
    @media (min-width: 48rem) {
        .menu-toggle {
            display: none;
        }
        .nav-links {
            display: flex;
        }
    }

    /* ── Mobile menu overlay ── */

    .mobile-menu {
        position: fixed;
        inset-inline: 0;
        top: var(--header-height);
        bottom: 0;
        inline-size: 100%;
        max-inline-size: none;
        block-size: auto;
        max-block-size: none;
        margin: 0;
        border: 0;
        background: var(--color-ink);
        color: var(--color-paper);
        padding-block: var(--space-xl);
        padding-inline: var(--site-padding-inline);
        opacity: 0;
    }

    .mobile-menu[open] {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        opacity: 1;
    }

    @starting-style {
        .mobile-menu[open] {
            opacity: 0;
        }
    }

    .mobile-menu::backdrop {
        background: transparent;
    }

    .mobile-menu:focus {
        outline: none;
    }

    .mobile-menu a {
        font-size: var(--font-size-lg);
        text-transform: uppercase;
    }

    .mobile-menu a[aria-current="page"] {
        font-weight: var(--font-weight-bold);
    }
</style>
