---
import { getCollection, getEntry } from "astro:content";
import Svg from "../elements/Svg.astro";
import { resolvePageLink } from "../../lib/content";
import { getExperiencesPage } from "../../lib/experiences";

const menuLocation = await getEntry("menuLocations", "primary");
const menuItems = (
    await getCollection(
        "menuItems",
        (item) => item.data.menu === menuLocation?.data.menu,
    )
).sort((a, b) => a.data.order - b.data.order);

const pages = await getCollection("pages");
const aboutPage = pages.find(
    (p) => p.data.template === "page-about-berghs.php",
);
const aboutHref = aboutPage
    ? `/${await resolvePageLink(aboutPage)}`
    : "https://www.berghs.se/om-berghs/";

const experiencesData = await getExperiencesPage();
const experiencesSubItems: Array<{ label: string; href: string }> =
    experiencesData
        ? [
              { label: "Schedule", href: "/experiences/schedule" },
              ...experiencesData.groups.map((group) => ({
                  label: group.title,
                  href: `/experiences/${group.slug}`,
              })),
          ]
        : [];

function isExperiencesItem(url: string): boolean {
    try {
        return (
            new URL(url).pathname.replace(/\/$/, "") === "/experiences"
        );
    } catch {
        return false;
    }
}

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header>
    <nav aria-label="Site navigation">
        <button
            class="menu-toggle"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Open menu"
        >
            <span class="bar bar-top"></span>
            <span class="bar bar-mid"></span>
            <span class="bar bar-bot"></span>
        </button>

        <ul class="nav-links">
            {
                menuItems.map((menuItem) => {
                    const isExperiences =
                        isExperiencesItem(menuItem.data.url) &&
                        experiencesSubItems.length > 0;

                    if (isExperiences) {
                        const inExperiencesSection =
                            experiencesSubItems.some(
                                (sub) => currentPath === sub.href,
                            );
                        return (
                            <li class="has-submenu">
                                <button
                                    type="button"
                                    class="nav-link submenu-toggle"
                                    aria-expanded="false"
                                    aria-haspopup="true"
                                    aria-controls="experiences-submenu"
                                    aria-current={
                                        inExperiencesSection
                                            ? "page"
                                            : undefined
                                    }
                                >
                                    <span class="nav-link-text" data-scramble>
                                        {menuItem.data.title}
                                    </span>
                                    <Svg
                                        name="chevron"
                                        alt=""
                                        class="submenu-chevron"
                                    />
                                </button>
                                <ul class="submenu" id="experiences-submenu">
                                    {experiencesSubItems.map((sub) => (
                                        <li>
                                            <a
                                                href={sub.href}
                                                class="nav-link submenu-link"
                                                aria-current={
                                                    currentPath === sub.href
                                                        ? "page"
                                                        : undefined
                                                }
                                            >
                                                <span
                                                    class="nav-link-text"
                                                    data-scramble
                                                >
                                                    {sub.label}
                                                </span>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </li>
                        );
                    }

                    return (
                        <li>
                            <a
                                href={menuItem.data.url}
                                aria-current={
                                    currentPath ===
                                    new URL(menuItem.data.url).pathname
                                        ? "page"
                                        : undefined
                                }
                                class="nav-link"
                            >
                                <span class="nav-link-text" data-scramble>
                                    {menuItem.data.title}
                                </span>
                            </a>
                        </li>
                    );
                })
            }
        </ul>

        <a
            href={aboutHref}
            class="logo-link"
            aria-label="About Berghs School of Communication"
        >
            <Svg
                name="berghs-soc"
                alt=""
                style="width: auto; height: var(--font-size-base);"
            />
        </a>
    </nav>

    <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
        {
            menuItems.map((menuItem) => {
                const isExperiences =
                    isExperiencesItem(menuItem.data.url) &&
                    experiencesSubItems.length > 0;

                if (isExperiences) {
                    const inExperiencesSection = experiencesSubItems.some(
                        (sub) => currentPath === sub.href,
                    );
                    return (
                        <div class="mobile-group">
                            <span
                                class="mobile-group-label"
                                aria-current={
                                    inExperiencesSection ? "page" : undefined
                                }
                            >
                                {menuItem.data.title}
                            </span>
                            <ul class="mobile-submenu">
                                {experiencesSubItems.map((sub) => (
                                    <li>
                                        <a
                                            href={sub.href}
                                            aria-current={
                                                currentPath === sub.href
                                                    ? "page"
                                                    : undefined
                                            }
                                            class="nav-link"
                                        >
                                            <span
                                                class="nav-link-text"
                                                data-scramble
                                            >
                                                {sub.label}
                                            </span>
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    );
                }

                return (
                    <a
                        href={menuItem.data.url}
                        aria-current={
                            currentPath ===
                            new URL(menuItem.data.url).pathname
                                ? "page"
                                : undefined
                        }
                        class="nav-link"
                    >
                        <span class="nav-link-text" data-scramble>
                            {menuItem.data.title}
                        </span>
                    </a>
                );
            })
        }
    </div>
</header>

<script src="../../scripts/header.ts"></script>

<style>
    header {
        border-block-end: var(--border-default);
        position: relative;
        z-index: 100;
        block-size: var(--header-height);
    }

    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        block-size: 100%;
    }

    /* ── Hamburger button ── */

    .menu-toggle {
        --bar-w: 1.5rem;
        --bar-h: 2px;
        --bar-gap: 5px;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--bar-gap);
        width: max(44px, 2em);
        height: max(44px, 2em);
        margin-inline-start: calc((var(--bar-w) - max(44px, 2em)) / 2);
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        color: inherit;
    }

    .bar {
        display: block;
        width: var(--bar-w);
        height: var(--bar-h);
        background: currentColor;

        transition:
            transform 0.25s ease,
            opacity 0.15s ease;
    }

    .menu-toggle[aria-expanded="true"] .bar-top {
        transform: translateY(calc(var(--bar-gap) + var(--bar-h))) rotate(45deg);
    }

    .menu-toggle[aria-expanded="true"] .bar-mid {
        opacity: 0;
        transform: scaleX(0);
    }

    .menu-toggle[aria-expanded="true"] .bar-bot {
        transform: translateY(calc(-1 * (var(--bar-gap) + var(--bar-h))))
            rotate(-45deg);
    }

    .logo-link :global(svg) {
        fill: var(--color-text-on-bg);
    }

    /* ── Desktop nav links ── */

    .nav-links {
        display: none;
        gap: var(--space-md);
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: var(--font-size-base);
        text-transform: lowercase;
    }

    .nav-link[aria-current="page"]:not(.submenu-link) {
        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
    }

    .nav-link:focus-visible,
    .logo-link:focus-visible {
        border-radius: 1px;
    }

    /* ── Submenu (desktop) ── */
    .has-submenu {
        position: relative;
    }

    .submenu-toggle {
        appearance: none;
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        color: inherit;
        font: inherit;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: var(--space-xxs);
    }

    .submenu-chevron {
        width: 0.75em;
        height: 0.75em;
        transition: transform 0.15s ease;
    }

    .submenu-toggle[aria-expanded="true"] .submenu-chevron {
        transform: rotate(180deg);
    }

    @media (prefers-reduced-motion: reduce) {
        .submenu-chevron {
            transition: none;
        }
    }

    .submenu {
        position: absolute;
        inset-inline-start: 0;
        inset-block-start: 100%;
        list-style: none;
        margin: 0;
        padding: var(--space-xs) var(--space-sm);
        background: var(--color-bg);
        border: var(--border-default);
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        min-width: max-content;
        visibility: hidden;
        opacity: 0;
        transition:
            opacity 0.15s ease,
            visibility 0s 0.15s;
    }

    .submenu-toggle[aria-expanded="true"] + .submenu {
        visibility: visible;
        opacity: 1;
        transition:
            opacity 0.15s ease,
            visibility 0s 0s;
    }

    .submenu-link {
        display: block;
        padding: var(--space-xxs) var(--space-xs);
    }

    .submenu-link[aria-current="page"] {
        background: var(--color-text-on-bg);
        color: var(--color-bg);
    }

    /* ── Mobile submenu ── */
    .mobile-group {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
    }

    .mobile-group-label {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        color: var(--color-text-muted);
        text-transform: lowercase;
    }

    .mobile-submenu {
        list-style: none;
        margin: 0;
        padding: 0;
        padding-inline-start: var(--space-md);
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
    }

    /* Tablet: hide hamburger, show full nav */
    @media (min-width: 48rem) {
        .menu-toggle {
            display: none;
        }
        .nav-links {
            display: flex;
        }
    }

    /* ── Mobile menu overlay ── */

    .mobile-menu {
        position: fixed;
        inset-inline: 0;
        top: var(--header-height);
        bottom: 0;
        background: var(--color-bg);
        color: var(--color-text-on-bg);
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        padding-block: var(--space-xl);
        padding-inline: var(--site-padding-inline);
        visibility: hidden;
        opacity: 0;
        transition:
            opacity 0.2s ease,
            visibility 0s 0.2s;
    }

    .mobile-menu[aria-hidden="false"] {
        visibility: visible;
        opacity: 1;
        transition:
            opacity 0.2s ease,
            visibility 0s 0s;
    }

    .mobile-menu a {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
    }
</style>
