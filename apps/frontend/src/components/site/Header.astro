---
import { getCollection, getEntry } from "astro:content";
import Svg from "../elements/Svg.astro";

const menuLocation = await getEntry("menuLocations", "primary");
const menuItems = (
    await getCollection(
        "menuItems",
        (item) => item.data.menu === menuLocation?.data.menu,
    )
).sort((a, b) => a.data.order - b.data.order);
---

<header>
    <nav>
        <a href="https://www.berghs.se/" target="_blank">
            <Svg name="berghs-soc" alt="" style="width: auto; height: var(--font-size-base);" />
        </a>

        {
            menuItems.map((menuItem) => (
                <a
                    href={menuItem.data.url}
                    aria-current={
                        Astro.url.pathname ===
                        new URL(menuItem.data.url).pathname
                            ? "page"
                            : undefined
                    }
                >
                    {menuItem.data.title}
                </a>
            ))
        }
    </nav>
</header>

<style>
    header {
        border-block-end: var(--border-default);
    }

    nav {
        display: flex;
        gap: var(--space-sm);
        justify-content: space-between;
        padding: var(--space-sm) var(--site-padding-inline);
    }


</style>
