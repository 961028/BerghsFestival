---
import { getCollection } from "astro:content";

import Svg from "../elements/Svg.astro";

const contact = (await getCollection("contact"))[0].data;

const { address, phone, socialServices } = contact;
---

<div class="contact">
    <div class="address">{address}</div>

    <div class="phone">
        <a href={`tel:${phone}`}>{phone}</a>
    </div>

    <ul class="social-list">
        {
            socialServices.map((service) => (
                <li>
                    <a href={service.url} title={service.label} target="_blank">
                        <Svg name={service.icon} class="social-logo" alt="" />
                    </a>
                </li>
            ))
        }
    </ul>
</div>

<style>
    .contact {
        text-align: center;
    }

    .address {
        white-space: pre-wrap;
    }

    .phone {
        margin-top: var(--space-xs);
    }

    .social-list {
        display: flex;
        justify-content: center;
        gap: var(--space-sm);
        margin-top: var(--space-xs);
    }

    .social-logo {
        display: block;
        width: 1.5rem;
        height: auto;
    }
</style>
