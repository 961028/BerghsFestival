---
import { getCollection } from "astro:content";

import Svg from "../elements/Svg.astro";

const contact = (await getCollection("contact"))[0].data;

const { address, phone, socialServices } = contact;
---

<div>
    <div class="address">{address}</div>

    <div class="phone">
        <a href={`tel:${phone}`}>{phone}</a>
    </div>

    <ul>
        {
            socialServices.map((service) => (
                <li>
                    <a href={service.url} title={service.label} target="_blank">
                        <Svg name={service.icon} class="social-logo" alt="" />
                    </a>
                </li>
            ))
        }
    </ul>
</div>

<style>
    .address {
        white-space: pre-wrap;
    }

    .social-logo {
        display: block;
        width: 2rem;
        height: auto;
    }
</style>
