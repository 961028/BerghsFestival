---
import { getCollection } from "astro:content";

import Svg from "../elements/Svg.astro";

const contact = (await getCollection("contact"))[0].data;

const { address, phone, socialServices } = contact;
---

<div>
    <div>{address}</div>

    <div>
        <a href={`tel:${phone}`}>{phone}</a>
    </div>

    <ul>
        {
            socialServices.map((service) => (
                <li>
                    <a href={service.url} title={service.label} target="_blank">
                        <Svg name={service.icon} alt="" />
                    </a>
                </li>
            ))
        }
    </ul>
</div>

<style>
    div > div:first-child {
        white-space: pre-wrap;
    }

    div > div:nth-child(2) {
        margin-block-start: var(--space-xs);
    }

    ul {
        list-style: none;
        padding: 0;
        display: flex;
        gap: var(--space-sm);
        margin-block-start: var(--space-sm);
    }

    ul :global(svg) {
        --icon-size: 1.5rem;
        display: block;
        width: var(--icon-size);
        height: auto;
        fill: currentColor;
    }
</style>
