---
import { getCollection } from "astro:content";

type Props = {
    collection: "iq" | "photoNotice";
};

const { collection } = Astro.props;
const { title, content } = (await getCollection(collection))[0].data;
---

<div class="footer-text-block">
    <h2 class="footer-label">{title}</h2>
    <div set:html={content.html} />
</div>

<style>
    .footer-text-block {
        display: grid;
        gap: var(--space-sm);
    }

    .footer-text-block > div {
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
    }
</style>
