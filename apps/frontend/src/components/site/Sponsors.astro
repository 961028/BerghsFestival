---
import { getCollection, getEntry } from "astro:content";

import WpImage from "../elements/WpImage.astro";

const BASELINE = 4; // rem — width of a square logo
const EXPONENT = 0.6;

const sponsors = (await getCollection("sponsors")).sort((a, b) => {
    if (a.data.id < b.data.id) return -1;
    if (a.data.id > b.data.id) return 1;
    return 0;
});

const sponsorLogos = await Promise.all(
    sponsors.map(async (sponsor) => {
        const media = await getEntry(sponsor.data.image);
        const w = media?.data.width;
        const h = media?.data.height;
        const ratio = w && h ? w / h : 1;
        const width = BASELINE * Math.pow(ratio, EXPONENT);
        return { sponsor, widthStyle: `${width.toFixed(3)}rem` };
    }),
);
---

<div class="sponsors">
    <ul class="sponsors-list">
        {
            sponsorLogos.map(({ sponsor, widthStyle }) => (
                <li>
                    <a
                        href={sponsor.data.url}
                        aria-label={sponsor.data.name}
                        title={sponsor.data.name}
                    >
                        <WpImage
                            class="sponsor-logo"
                            image={sponsor.data.image}
                            alt=""
                            style={`width: ${widthStyle}`}
                        />
                    </a>
                </li>
            ))
        }
    </ul>
</div>

<style>
    .sponsors-list {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--space-md);
    }

    .sponsor-logo {
        display: block;
        height: auto;
    }
</style>
