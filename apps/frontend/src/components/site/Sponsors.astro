---
import { getCollection } from "astro:content";

import WpImage from "../elements/WpImage.astro";

const sponsors = (await getCollection("sponsors")).sort((a, b) => {
    if (a.data.id < b.data.id) return -1;
    if (a.data.id > b.data.id) return 1;
    return 0;
});
---

<div class="sponsors">
    <ul class="sponsors-list">
        {
            sponsors.map((sponsor) => (
                <li>
                    <a
                        href={sponsor.data.url}
                        aria-label={sponsor.data.name}
                        title={sponsor.data.name}
                    >
                        <WpImage
                            class="sponsor-logo"
                            image={sponsor.data.image}
                            alt=""
                        />
                    </a>
                </li>
            ))
        }
    </ul>
</div>

<style>
    .sponsors-list {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--space-md);
    }

    .sponsor-logo {
        display: block;
        height: 2rem;
        width: auto;
    }
</style>
