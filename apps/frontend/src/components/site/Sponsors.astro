---
import { getImage } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import WpImage from "../elements/WpImage.astro";

const BASELINE = 6; // rem — width of a square logo
const EXPONENT = 0.6;

const sponsors = (await getCollection("sponsors")).sort((a, b) => {
    if (a.data.id < b.data.id) return -1;
    if (a.data.id > b.data.id) return 1;
    return 0;
});

const sponsorLogos = (
    await Promise.all(
        sponsors.map(async (sponsor) => {
            const image = await getEntry(sponsor.data.image);

            if (!image || !sponsor.data.url) {
                return null;
            }

            const { url, name } = sponsor.data;
            const { width, height, sourceUrl } = image.data;
            const ratio = width && height ? width / height : 1;
            const widthRem = BASELINE * Math.pow(ratio, EXPONENT);
            const scaledWidth = Math.round(widthRem * 16 * 2);
            const scaledHeight = Math.round(scaledWidth / ratio);

            const scaled = await getImage({
                src: sourceUrl,
                width: scaledWidth,
                height: scaledHeight,
            });

            return {
                url,
                name,
                src: scaled.src,
                width: scaledWidth,
                height: scaledHeight,
                widthStyle: `${widthRem.toFixed(3)}rem`,
            };
        }),
    )
).filter((s) => s !== null);
---

<ul data-sponsors>
    {
        sponsorLogos.map(({ url, name, src, width, height, widthStyle }) => (
            <li>
                <a
                    href={url}
                    aria-label={name}
                    title={name}
                    style={`max-width: ${widthStyle}; --logo-url: url(${src});`}
                >
                    <img
                        data-logo
                        src={src}
                        width={width}
                        height={height}
                        alt={name}
                    />
                </a>
            </li>
        ))
    }
</ul>

<style>
    ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--space-lg);
    }

    a {
        display: block;
        position: relative;
        max-width: 100%;
    }

    [data-logo] {
        display: block;
        width: 100%;
        height: auto;
    }

    @media (any-hover: hover) and (any-pointer: fine) {
        a::after {
            content: "";
            position: absolute;
            inset: 0;
            background: var(--color-accent-1);
            mask-image: var(--logo-url);
            mask-size: contain;
            mask-repeat: no-repeat;
            mask-position: center;
            mix-blend-mode: multiply;
            opacity: 0;
            transition: opacity 120ms;
            pointer-events: none;
        }

        a:hover::after {
            opacity: 1;
        }
    }
</style>

<script>
    import { attachRgbSplit } from "../../scripts/accents";

    document
        .querySelectorAll<HTMLElement>("[data-sponsors] a")
        .forEach((link) => {
            attachRgbSplit(link);
        });
</script>
