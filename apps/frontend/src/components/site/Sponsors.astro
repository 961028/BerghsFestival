---
import { getCollection, getEntry } from "astro:content";

const BASELINE = 4; // rem — width of a square logo
const EXPONENT = 0.6;

const sponsors = (await getCollection("sponsors")).sort((a, b) => {
    if (a.data.id < b.data.id) return -1;
    if (a.data.id > b.data.id) return 1;
    return 0;
});

const sponsorLogos = await Promise.all(
    sponsors.map(async (sponsor) => {
        const image = await getEntry(sponsor.data.image);
        const w = image?.data.width;
        const h = image?.data.height;
        const ratio = w && h ? w / h : 1;
        const widthRem = BASELINE * Math.pow(ratio, EXPONENT);

        return {
            sponsor,
            w,
            h,
            widthStyle: `${widthRem.toFixed(3)}rem`,
            src: image.data.sourceUrl,
        };
    }),
);
---

<ul>
    {
        sponsorLogos.map(({ sponsor, w, h, widthStyle, src }) => (
            <li>
                <a
                    href={sponsor.data.url}
                    aria-label={sponsor.data.name}
                    title={sponsor.data.name}
                    data-sponsor-link
                    style={`width: ${widthStyle}`}
                >
                    <div
                        class="logo"
                        style={{
                            maskImage: `url(${src})`,
                            aspectRatio: `${w} / ${h}`,
                        }}
                    />
                </a>
            </li>
        ))
    }
</ul>

<style>
    ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--space-lg);
    }

    a {
        display: block;
        color: var(--color-text-on-bg);
    }
    .logo {
        background-color: currentColor;
        mask-size: cover;
        mask-repeat: no-repeat;
        mask-position: center;
    }
</style>

<script>
    import { makeColorPicker } from "../../scripts/accents";

    const CYCLE_INTERVAL_MS = 50;
    const nextAccent = makeColorPicker(2);

    const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    document
        .querySelectorAll<HTMLAnchorElement>("[data-sponsor-link]")
        .forEach((link) => {
            let timer: ReturnType<typeof setInterval> | undefined;

            link.addEventListener("mouseenter", () => {
                link.style.color = nextAccent();
                if (!reducedMotion) {
                    timer = setInterval(() => {
                        link.style.color = nextAccent();
                    }, CYCLE_INTERVAL_MS);
                }
            });

            link.addEventListener("mouseleave", () => {
                clearInterval(timer);
                link.style.color = "";
            });
        });
</script>
