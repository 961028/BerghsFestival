---
import { getCollection } from "astro:content";

import WpImage from "../elements/WpImage.astro";

const sponsors = (await getCollection("sponsors")).sort((a, b) => {
	if (a.data.id < b.data.id) return -1;
	if (a.data.id > b.data.id) return 1;
	return 0;
});
---

<div>
	<ul>
		{
			sponsors.map((sponsor) => (
				<li>
					<a
						href={sponsor.data.url}
						aria-label={sponsor.data.name}
						title={sponsor.data.name}
					>
						<WpImage
							class="logo"
							image={sponsor.data.image}
							alt=""
						/>
					</a>
				</li>
			))
		}
	</ul>
</div>
