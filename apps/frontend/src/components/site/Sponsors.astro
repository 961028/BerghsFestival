---
import { getCollection, getEntry } from "astro:content";

const BASELINE = 4; // rem — width of a square logo
const EXPONENT = 0.6;

const sponsors = (await getCollection("sponsors")).sort((a, b) => {
    if (a.data.id < b.data.id) return -1;
    if (a.data.id > b.data.id) return 1;
    return 0;
});

const sponsorLogos = (
    await Promise.all(
        sponsors.map(async (sponsor) => {
            const image = await getEntry(sponsor.data.image);

            if (!image || !sponsor.data.url) {
                return null;
            }

            const { url, name } = sponsor.data;
            const { width, height } = image.data;
            const ratio = width && height ? width / height : 1;
            const widthRem = BASELINE * Math.pow(ratio, EXPONENT);

            return {
                url,
                name,
                width,
                height,
                widthStyle: `${widthRem.toFixed(3)}rem`,
                src: image.data.sourceUrl,
            };
        }),
    )
).filter((s) => s !== null);
---

<ul>
    {
        sponsorLogos.map(({ url, name, src, width, height, widthStyle }) => (
            <li>
                <a
                    href={url}
                    aria-label={name}
                    title={name}
                    style={`width: ${widthStyle}`}
                >
                    <img
                        data-logo
                        src={src}
                        alt={name}
                        width={width}
                        height={height}
                    />
                </a>
            </li>
        ))
    }
</ul>

<style>
    ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--space-lg);
    }

    a {
        display: block;
    }

    [data-logo] {
        display: block;
        width: 100%;
        height: auto;
        filter: grayscale(1);
    }

    a:hover [data-logo] {
        filter: grayscale(0);
    }
</style>
