---
import { getCollection, getEntry } from "astro:content";

const BASELINE = 4; // rem — width of a square logo
const EXPONENT = 0.6;

const sponsors = (await getCollection("sponsors")).sort((a, b) => {
    if (a.data.id < b.data.id) return -1;
    if (a.data.id > b.data.id) return 1;
    return 0;
});

const sponsorLogos = (
    await Promise.all(
        sponsors.map(async (sponsor) => {
            const image = await getEntry(sponsor.data.image);

            if (!image) {
                return null;
            }

            const { url, name } = sponsor.data;

            if (!url) {
                return null;
            }

            const { width, height } = image.data;
            const ratio = width && height ? width / height : 1;
            const widthRem = BASELINE * Math.pow(ratio, EXPONENT);

            return {
                url,
                name,
                width,
                height,
                widthStyle: `${widthRem.toFixed(3)}rem`,
                src: image.data.sourceUrl,
            };
        }),
    )
).filter((s) => s !== null);
---

<ul>
    {
        sponsorLogos.map(({ url, name, width, height, widthStyle, src }) => (
            <li>
                <a
                    href={url}
                    aria-label={name}
                    title={name}
                    data-sponsor-link
                    style={`width: ${widthStyle}`}
                >
                    <div
                        class="logo"
                        style={{
                            maskImage: `url(${src})`,
                            aspectRatio: `${width} / ${height}`,
                        }}
                    />
                </a>
            </li>
        ))
    }
</ul>

<style>
    ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--space-lg);
    }

    a {
        display: block;
        color: var(--color-text-on-bg);
    }
    .logo {
        background-color: currentColor;
        mask-size: contain;
        mask-repeat: no-repeat;
        mask-position: center;
    }
</style>

<script>
    import { makeColorPicker, CYCLE_INTERVAL_MS } from "../../scripts/accents";

    const nextAccent = makeColorPicker(2);

    const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    document
        .querySelectorAll<HTMLAnchorElement>("[data-sponsor-link]")
        .forEach((link) => {
            let timer: ReturnType<typeof setInterval> | undefined;

            link.addEventListener("mouseenter", () => {
                link.style.color = nextAccent();
                if (!reducedMotion) {
                    timer = setInterval(() => {
                        link.style.color = nextAccent();
                    }, CYCLE_INTERVAL_MS);
                }
            });

            link.addEventListener("mouseleave", () => {
                clearInterval(timer);
                link.style.color = "";
            });
        });
</script>
