---
import { getCollection, getEntry } from "astro:content";

const BASELINE = 4; // rem — width of a square logo
const EXPONENT = 0.6;

const sponsors = (await getCollection("sponsors")).sort((a, b) => {
    if (a.data.id < b.data.id) return -1;
    if (a.data.id > b.data.id) return 1;
    return 0;
});

const sponsorLogos = await Promise.all(
    sponsors.map(async (sponsor) => {
        const media = await getEntry(sponsor.data.image);
        const w = media?.data.width;
        const h = media?.data.height;
        const ratio = w && h ? w / h : 1;
        const widthRem = BASELINE * Math.pow(ratio, EXPONENT);

        const svgRaw = await fetch(media!.data.sourceUrl).then((r) => r.text());
        // Strip XML declaration, hardcoded fill/color attrs, width/height attrs on root <svg>
        const svg = svgRaw
            .replace(/<\?xml[^>]*\?>\s*/g, "")
            .replace(/\s(fill|color)="[^"]*"/g, "")
            .replace(/(<svg[^>]*)\s(width|height)="[^"]*"/g, "$1")
            .replace(/(<svg[^>]*)>/, '$1 aria-hidden="true" focusable="false">');

        return { sponsor, widthStyle: `${widthRem.toFixed(3)}rem`, svg };
    }),
);
---

<ul>
    {sponsorLogos.map(({ sponsor, widthStyle, svg }) => (
        <li>
            <a
                href={sponsor.data.url}
                aria-label={sponsor.data.name}
                title={sponsor.data.name}
                data-sponsor-link
                style={`width: ${widthStyle}`}
            >
                <Fragment set:html={svg} />
            </a>
        </li>
    ))}
</ul>

<style>
    ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--space-lg);
    }

    a {
        display: block;
        color: var(--color-text-on-bg);
    }

    a :global(svg) {
        display: block;
        width: 100%;
        height: auto;
        fill: currentColor;
    }
</style>

<script>
    import { makeColorPicker } from "../../scripts/accents";

    const CYCLE_INTERVAL_MS = 50;
    const nextAccent = makeColorPicker(2);

    document.querySelectorAll<HTMLAnchorElement>("[data-sponsor-link]").forEach((link) => {
        let timer: ReturnType<typeof setInterval> | undefined;

        link.addEventListener("mouseenter", () => {
            timer = setInterval(() => {
                link.style.color = nextAccent();
            }, CYCLE_INTERVAL_MS);
        });

        link.addEventListener("mouseleave", () => {
            clearInterval(timer);
            link.style.color = "";
        });
    });
</script>
