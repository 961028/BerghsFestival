---
import { getCollection, getEntry } from "astro:content";
import WpImage from "../elements/WpImage.astro";

const BASELINE = 6; // rem — width of a square logo
const EXPONENT = 0.6;

const sponsors = (await getCollection("sponsors")).sort((a, b) => {
    if (a.data.id < b.data.id) return -1;
    if (a.data.id > b.data.id) return 1;
    return 0;
});

const sponsorLogos = (
    await Promise.all(
        sponsors.map(async (sponsor) => {
            const image = await getEntry(sponsor.data.image);

            if (!image || !sponsor.data.url) {
                return null;
            }

            const { url, name } = sponsor.data;
            const { width, height, sourceUrl } = image.data;
            const ratio = width && height ? width / height : 1;
            const widthRem = BASELINE * Math.pow(ratio, EXPONENT);

            return {
                url,
                name,
                image,
                sourceUrl,
                widthStyle: `${widthRem.toFixed(3)}rem`,
            };
        }),
    )
).filter((s) => s !== null);
---

<ul data-sponsors>
    {
        sponsorLogos.map(({ url, name, image, sourceUrl, widthStyle }) => (
            <li>
                <a
                    href={url}
                    aria-label={name}
                    title={name}
                    style={`width: ${widthStyle}; --logo-url: url(${sourceUrl});`}
                >
                    <WpImage data-logo image={image} alt={name} />
                </a>
            </li>
        ))
    }
</ul>

<style>
    ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--space-lg);
    }

    a {
        display: block;
        position: relative;
    }

    [data-logo] {
        display: block;
        width: 100%;
        height: auto;
    }

    @media (any-hover: hover) and (any-pointer: fine) {
        a::after {
            content: "";
            position: absolute;
            inset: 0;
            background: var(--color-accent-1);
            mask-image: var(--logo-url);
            mask-size: contain;
            mask-repeat: no-repeat;
            mask-position: center;
            mix-blend-mode: multiply;
            opacity: 0;
            transition: opacity 120ms;
            pointer-events: none;
        }

        a:hover::after {
            opacity: 1;
        }
    }
</style>

<script>
    import { makeColorPicker, CYCLE_INTERVAL_MS } from "../../scripts/accents";

    const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;
    const nextAccent = makeColorPicker(2);

    document
        .querySelectorAll<HTMLElement>("[data-sponsors] a")
        .forEach((link) => {
            let timer: ReturnType<typeof setInterval> | undefined;

            link.addEventListener("mouseenter", () => {
                link.style.setProperty("--color-accent-1", nextAccent());
                if (!reducedMotion) {
                    timer = setInterval(() => {
                        link.style.setProperty(
                            "--color-accent-1",
                            nextAccent(),
                        );
                    }, CYCLE_INTERVAL_MS);
                }
            });

            link.addEventListener("mouseleave", () => {
                clearInterval(timer);
                link.style.removeProperty("--color-accent-1");
            });
        });
</script>
