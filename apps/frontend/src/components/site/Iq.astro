---
import { getCollection } from "astro:content";

const { title, content } = (await getCollection("iq"))[0].data;
---

<div class="iq">
    <h2 class="footer-label">{title}</h2>
    <div set:html={content.html} />
</div>

<style>
    .iq {
        display: grid;
        gap: var(--space-sm);
    }

    .iq > div {
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
    }
</style>
