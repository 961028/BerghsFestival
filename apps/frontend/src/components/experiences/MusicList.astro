---
import WpImage from "../elements/WpImage.astro";
import type { MusicItem } from "../../lib/experience-pages";

interface Props {
    items: MusicItem[];
    scheduleDays: string[];
}

const { items, scheduleDays } = Astro.props;

// Group items by day in schedule order. Items without a day, and items whose
// day no longer matches a schedule day, fall into a single trailing bucket.
const knownDays = new Set(scheduleDays);

const buckets: { label: string | null; items: MusicItem[] }[] = [
    ...scheduleDays.map((day) => ({
        label: day,
        items: items.filter((item) => item.day === day),
    })),
    {
        label: null,
        items: items.filter(
            (item) => !item.day || !knownDays.has(item.day),
        ),
    },
].filter((bucket) => bucket.items.length > 0);

function slugify(value: string): string {
    return value
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/(^-|-$)/g, "");
}
---

<div class="music">
    {buckets.map((bucket) => (
        <section
            class="day"
            id={bucket.label ? slugify(bucket.label) : undefined}
        >
            {bucket.label && <h2 class="day-heading">{bucket.label}</h2>}
            <ul>
                {bucket.items.map((item) => (
                    <li id={item.slug}>
                        {item.image ? (
                            <WpImage
                                image={item.image}
                                width={600}
                                height={750}
                                alt={item.name}
                            />
                        ) : (
                            <div class="thumb-placeholder" aria-hidden="true" />
                        )}
                        <div class="text">
                            <p class="name">{item.name}</p>
                            {(item.startTime || item.location) && (
                                <p class="meta">
                                    {item.startTime && (
                                        <span class="time">{item.startTime}</span>
                                    )}
                                    {item.location && (
                                        <span class="location">{item.location}</span>
                                    )}
                                </p>
                            )}
                            <div
                                class="description"
                                set:html={item.description.html}
                            />
                            {(item.url || item.socialUrl) && (
                                <div class="links">
                                    {item.url && (
                                        <a
                                            class="btn"
                                            data-color-hover
                                            href={item.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            Website
                                        </a>
                                    )}
                                    {item.socialUrl && (
                                        <a
                                            class="btn"
                                            data-color-hover
                                            href={item.socialUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            Social
                                        </a>
                                    )}
                                </div>
                            )}
                        </div>
                    </li>
                ))}
            </ul>
        </section>
    ))}
</div>

<style>
    .day + .day:has(> .day-heading) {
        margin-block-start: var(--space-xl);
    }

    .day-heading {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        line-height: var(--line-height-tight);
        letter-spacing: var(--letter-spacing-tight);
        margin: 0 0 var(--space-sm);
    }

    /* ── Music rows ──────────────────────────────────────────────────
       Mobile: image full-width on top, text below.
       ≥40rem: thumb left fixed, text right. Border + padding rhythm
       matches schedule rows. */
    ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    li {
        display: grid;
        gap: var(--space-md);
        padding-block: var(--space-md);
        border-block-start: var(--border-default);
        align-items: start;
    }

    @media (min-width: 40rem) {
        li {
            grid-template-columns: var(--music-thumb-w) 1fr;
            align-items: start;
        }

        .text {
            height: var(--music-thumb-h);
            overflow: hidden;
        }
    }

    @media (min-width: 64rem) {
        li {
            padding-block: var(--space-lg);
        }
    }

    li :global(img),
    .thumb-placeholder {
        display: block;
        width: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
    }

    @media (min-width: 40rem) {
        li :global(img),
        .thumb-placeholder {
            width: var(--music-thumb-w);
            height: var(--music-thumb-h);
        }
    }

    .thumb-placeholder {
        border: var(--border-default);
    }

    .text {
        display: flex;
        flex-direction: column;
        gap: var(--space-xxs);
        min-width: 0;
    }

    .name {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-bold);
        line-height: var(--line-height-tight);
        letter-spacing: var(--letter-spacing-tight);
        margin: 0;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-xs);
        margin: 0;
    }

    .time {
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-bold);
        color: var(--color-text-muted);
        line-height: var(--line-height-tight);
        letter-spacing: var(--letter-spacing-tight);
        font-variant-numeric: tabular-nums;
    }

    .location {
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-bold);
        color: var(--color-text-muted);
        line-height: var(--line-height-tight);
        letter-spacing: var(--letter-spacing-tight);
    }

    @media (min-width: 40rem) {
        .name {
            font-size: var(--font-size-lg);
        }

        .time,
        .location {
            font-size: var(--font-size-base);
        }
    }

    .description {
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
        color: var(--color-text-muted);
        margin-block-start: var(--space-xs);
    }

    .description :global(p:last-child) {
        margin-block-end: 0;
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin-block-start: auto;
        padding-block-start: var(--space-sm);
    }

    .btn {
        display: inline-flex;
        align-items: center;
        background-color: var(--color-text-on-bg);
        color: var(--color-text);
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-bold);
        padding: var(--space-sm) var(--space-md);
        text-decoration: none;
        min-block-size: max(44px, 2em);
        line-height: 1;
        transition: background-color 0.08s;
    }
</style>

<script>
    import { makeColorPicker, CYCLE_INTERVAL_MS } from "../../scripts/accents";

    document
        .querySelectorAll<HTMLElement>("[data-color-hover]")
        .forEach((btn) => {
            const nextAccent = makeColorPicker(2);
            const reducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            btn.addEventListener("mouseenter", () => {
                btn.style.backgroundColor = nextAccent();
                if (!reducedMotion) {
                    const interval = setInterval(() => {
                        btn.style.backgroundColor = nextAccent();
                    }, CYCLE_INTERVAL_MS);
                    btn.dataset.colorInterval = String(interval);
                }
            });

            btn.addEventListener("mouseleave", () => {
                clearInterval(Number(btn.dataset.colorInterval));
                btn.style.backgroundColor = "";
            });
        });
</script>
