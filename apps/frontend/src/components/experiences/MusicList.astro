---
import WpImage from "../elements/WpImage.astro";
import type { Artist, Slot } from "../../lib/experience-pages";

interface Props {
    artists: Artist[];
    scheduleDays: string[];
}

const { artists, scheduleDays } = Astro.props;

type DayGroup = { label: string | null; slots: Slot[] };

function groupSlotsByDay(slots: Slot[]): DayGroup[] {
    const byDay = new Map<string, Slot[]>();
    const unscheduled: Slot[] = [];

    for (const slot of slots) {
        if (slot.day) {
            const list = byDay.get(slot.day) ?? [];
            list.push(slot);
            byDay.set(slot.day, list);
        } else {
            unscheduled.push(slot);
        }
    }

    const sortByTime = (a: Slot, b: Slot) =>
        (a.startTime || "").localeCompare(b.startTime || "");

    const groups: DayGroup[] = [];

    for (const day of scheduleDays) {
        const list = byDay.get(day);
        if (list) {
            groups.push({ label: day, slots: [...list].sort(sortByTime) });
            byDay.delete(day);
        }
    }

    for (const [day, list] of byDay) {
        groups.push({ label: day, slots: [...list].sort(sortByTime) });
    }

    if (unscheduled.length > 0) {
        groups.push({ label: null, slots: [...unscheduled].sort(sortByTime) });
    }

    return groups;
}

function formatTimeRange(slot: Slot): string {
    if (slot.startTime && slot.endTime) {
        return `${slot.startTime}—${slot.endTime}`;
    }
    return slot.startTime || slot.endTime || "";
}
---

<div class="music">
    <ul role="list">
        {
            artists.map((artist) => (
                <li id={artist.slug}>
                    {artist.image ? (
                        <WpImage
                            image={artist.image}
                            width={600}
                            height={750}
                            alt=""
                        />
                    ) : (
                        <div
                            class="thumb-placeholder"
                            aria-hidden="true"
                        />
                    )}
                    <div class="text">
                        <h2 class="name heading-display">{artist.name}</h2>
                        <div
                            class="description section-body"
                            set:html={artist.description.html}
                        />
                        {artist.slots.length > 0 && (
                            <div class="slot-days">
                                {groupSlotsByDay(artist.slots).map((group) => (
                                    <div class="slot-day">
                                        {group.label && (
                                            <h3 class="day">{group.label}</h3>
                                        )}
                                        <ul class="slots" role="list">
                                            {group.slots.map((slot) => {
                                                const range = formatTimeRange(slot);
                                                return (
                                                    <li class="slot">
                                                        {range && (
                                                            <span class="time">
                                                                {range}
                                                            </span>
                                                        )}
                                                        {slot.location && (
                                                            <span class="location">
                                                                {slot.location}
                                                            </span>
                                                        )}
                                                    </li>
                                                );
                                            })}
                                        </ul>
                                    </div>
                                ))}
                            </div>
                        )}
                        {(artist.url || artist.socialUrl) && (
                            <div class="links">
                                {artist.url && (
                                    <a
                                        class="btn"
                                        data-color-hover
                                        href={artist.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label={`${artist.name} website`}
                                    >
                                        Website
                                    </a>
                                )}
                                {artist.socialUrl && (
                                    <a
                                        class="btn"
                                        data-color-hover
                                        href={artist.socialUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label={`${artist.name} social media`}
                                    >
                                        Social
                                    </a>
                                )}
                            </div>
                        )}
                    </div>
                </li>
            ))
        }
    </ul>
</div>

<style>
    /* ── Music rows ──────────────────────────────────────────────────
       Mobile: image full-width on top, text below.
       ≥40rem: thumb left fixed, text right. Border + padding rhythm
       matches schedule rows. */
    ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    li {
        display: grid;
        gap: var(--space-md);
        padding-block: var(--space-md);
        border-block-start: var(--border);
        align-items: start;
        scroll-margin-top: var(--header-height);
    }

    @media (min-width: 40rem) {
        li {
            grid-template-columns: var(--music-thumb-w) 1fr;
            align-items: start;
        }
    }

    @media (min-width: 64rem) {
        li {
            padding-block: var(--space-lg);
        }
    }

    li :global(img),
    .thumb-placeholder {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 5;
        object-fit: cover;
    }

    @media (min-width: 40rem) {
        li :global(img),
        .thumb-placeholder {
            width: var(--music-thumb-w);
            height: var(--music-thumb-h);
        }
    }

    .thumb-placeholder {
        border: var(--border);
    }

    .text {
        display: flex;
        flex-direction: column;
        gap: var(--space-xxs);
        min-width: 0;
    }

    .slot-days {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
        margin-block-start: var(--space-md);
    }

    .slot-day {
        display: flex;
        flex-direction: column;
        gap: var(--space-xxs);
    }

    .day {
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-normal);
        text-transform: uppercase;
        line-height: var(--line-height-tight);
        letter-spacing: var(--letter-spacing-caps-sm);
        margin: 0;
    }

    .slots {
        display: flex;
        flex-direction: column;
        gap: var(--space-xxs);
        margin: 0;
        padding: 0;
    }

    .slots li {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        padding: 0;
        border: 0;
    }

    .time,
    .location {
        font-size: var(--font-size-sm);
        color: var(--color-paper);
        line-height: var(--line-height-tight);
    }

    .time {
        font-weight: var(--font-weight-bold);
        font-variant-numeric: tabular-nums;
    }

    .location {
        font-weight: var(--font-weight-normal);
    }

    @media (min-width: 40rem) {
        .day,
        .time,
        .location {
            font-size: var(--font-size-base);
        }
    }

    .description {
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
        color: var(--color-paper);
        margin-block-start: var(--space-xs);
    }

    .description :global(p:last-child) {
        margin-block-end: 0;
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin-block-start: auto;
        padding-block-start: var(--space-sm);
    }

    .btn {
        display: inline-flex;
        align-items: center;
        background-color: var(--color-paper);
        color: var(--color-ink);
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-bold);
        padding: var(--space-sm) var(--space-md);
        text-decoration: none;
        min-block-size: max(44px, 2em);
        line-height: var(--line-height-none);
        transition: background-color 0.08s;
    }
</style>
