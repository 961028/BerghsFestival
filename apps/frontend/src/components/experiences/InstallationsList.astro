---
import WpImage from "../elements/WpImage.astro";
import type { ReferenceDataEntry } from "astro:content";

interface Props {
    items: {
        name: string;
        location: string | null;
        image: ReferenceDataEntry<"media"> | null;
        description: { html: string };
        url: string | null;
    }[];
}

const { items } = Astro.props;
---

<ul role="list">
    {
        items.map((item) => (
            <li>
                {item.image && (
                    <WpImage
                        data-installation-symbol
                        image={item.image}
                        width={1200}
                        height={600}
                        alt=""
                    />
                )}
                <div class="text">
                    <h2 class="name heading-display">{item.name}</h2>
                    {item.location && <p class="meta">{item.location}</p>}
                    <div
                        class="description section-body"
                        set:html={item.description.html}
                    />
                    {item.url && (
                        <div class="links">
                            <a
                                class="btn"
                                data-color-hover
                                href={item.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`${item.name} website`}
                            >
                                Website
                            </a>
                        </div>
                    )}
                </div>
            </li>
        ))
    }
</ul>

<script>
    import { runRgbSplitIntense } from "../../scripts/accents";

    const symbols = document.querySelectorAll<HTMLElement>(
        "[data-installation-symbol]",
    );
    symbols.forEach((el) => runRgbSplitIntense(el, 0.3));
</script>

<style>
    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        container-type: inline-size;
    }

    li {
        display: grid;
        gap: var(--space-sm);
        padding-block: var(--space-lg);
        border-block-start: var(--border);
        align-items: start;
    }

    @container (min-width: 48rem) {
        li:has(img) {
            grid-template-columns: var(--installation-img-w) 1fr;
            gap: var(--space-md);
        }

        li:has(img[data-installation-symbol]) {
            grid-template-columns: var(--installation-symbol-size) 1fr;
            gap: var(--space-xl);
            padding-block: var(--space-xl);
            align-items: center;
        }
    }

    li :global(img) {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
        object-fit: cover;
    }

    li :global(img[data-installation-symbol]) {
        width: var(--installation-symbol-size);
        height: var(--installation-symbol-size);
        aspect-ratio: auto;
        object-fit: contain;
    }

    @container (min-width: 48rem) {
        li :global(img) {
            width: var(--installation-img-w);
            height: var(--installation-img-w);
        }

        li :global(img[data-installation-symbol]) {
            width: var(--installation-symbol-size);
            height: var(--installation-symbol-size);
        }
    }

    .text {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        min-width: 0;
    }

    .meta {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-bold);
        color: var(--color-paper);
        line-height: var(--line-height-tight);
    }

    .description {
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
        color: var(--color-paper);
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin-block-start: var(--space-sm);
    }

    .btn {
        display: inline-flex;
        align-items: center;
        background-color: var(--color-paper);
        color: var(--color-ink);
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-bold);
        padding: var(--space-sm) var(--space-md);
        text-decoration: none;
        min-block-size: max(44px, 2em);
        line-height: var(--line-height-none);
        transition: background-color 0.08s;
    }
</style>
