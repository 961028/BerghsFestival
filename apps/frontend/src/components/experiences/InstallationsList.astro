---
import WpImage from "../elements/WpImage.astro";
import type { ReferenceDataEntry } from "astro:content";

interface Props {
    items: {
        name: string;
        image: ReferenceDataEntry<"media"> | null;
        description: { html: string };
    }[];
}

const { items } = Astro.props;
---

<ul>
    {
        items.map((item) => (
            <li>
                {item.image && (
                    <WpImage
                        image={item.image}
                        width={1200}
                        height={600}
                        alt={item.name}
                    />
                )}
                <div class="text">
                    <p class="name">{item.name}</p>
                    <div class="description" set:html={item.description.html} />
                </div>
            </li>
        ))
    }
</ul>

<style>
    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        container-type: inline-size;
    }

    li {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-sm);
        padding-block: var(--space-lg);
        border-block-start: var(--border-default);
        align-items: start;
    }

    /* Wide phone+: image left, text right — matches MusicList rhythm */
    @container (min-width: 30rem) {
        li {
            grid-template-columns: 40% 1fr;
            gap: var(--space-md);
        }
    }

    li :global(img) {
        display: block;
        width: 100%;
        aspect-ratio: 2 / 1;
        object-fit: cover;
    }

    .text {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        min-width: 0;
    }

    .name {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        line-height: var(--line-height-tight);
        letter-spacing: var(--letter-spacing-tight);
    }

    .description {
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
        color: var(--color-text-muted);
    }
</style>
