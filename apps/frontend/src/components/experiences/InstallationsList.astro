---
import WpImage from "../elements/WpImage.astro";
import type { ReferenceDataEntry } from "astro:content";

interface Props {
    items: {
        name: string;
        location: string | null;
        image: ReferenceDataEntry<"media"> | null;
        description: { html: string };
        url: string | null;
    }[];
}

const { items } = Astro.props;
---

<ul>
    {
        items.map((item) => (
            <li>
                {item.image && (
                    <WpImage
                        image={item.image}
                        width={1200}
                        height={600}
                        alt={item.name}
                    />
                )}
                <div class="text">
                    <p class="name">{item.name}</p>
                    {item.location && (
                        <p class="meta">{item.location}</p>
                    )}
                    <div class="description" set:html={item.description.html} />
                    {item.url && (
                        <div class="links">
                            <a
                                class="btn"
                                data-color-hover
                                href={item.url}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Website
                            </a>
                        </div>
                    )}
                </div>
            </li>
        ))
    }
</ul>

<style>
    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        container-type: inline-size;
    }

    li {
        display: grid;
        gap: var(--space-sm);
        padding-block: var(--space-lg);
        border-block-start: var(--border-default);
        align-items: start;
    }

    @container (min-width: 48rem) {
        li:has(img) {
            grid-template-columns: var(--installation-img-w) 1fr;
            gap: var(--space-md);
        }
    }

    li :global(img) {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
        object-fit: cover;
    }

    @container (min-width: 48rem) {
        li :global(img) {
            width: var(--installation-img-w);
            height: var(--installation-img-w);
        }
    }

    .text {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        min-width: 0;
    }

    .meta {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-bold);
        color: var(--color-text-muted);
        line-height: var(--line-height-tight);
        letter-spacing: var(--letter-spacing-tight);
    }

    .name {
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        line-height: var(--line-height-tight);
        letter-spacing: var(--letter-spacing-tight);
    }

    .description {
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
        color: var(--color-text-muted);
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin-block-start: var(--space-sm);
    }

    .btn {
        display: inline-flex;
        align-items: center;
        background-color: var(--color-text-on-bg);
        color: var(--color-text);
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-bold);
        padding: var(--space-sm) var(--space-md);
        text-decoration: none;
        min-block-size: max(44px, 2em);
        line-height: 1;
        transition: background-color 0.08s;
    }
</style>

<script>
    import { makeColorPicker, CYCLE_INTERVAL_MS } from "../../scripts/accents";

    document
        .querySelectorAll<HTMLElement>("[data-color-hover]")
        .forEach((btn) => {
            const nextAccent = makeColorPicker(2);
            const reducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            btn.addEventListener("mouseenter", () => {
                btn.style.backgroundColor = nextAccent();
                if (!reducedMotion) {
                    const interval = setInterval(() => {
                        btn.style.backgroundColor = nextAccent();
                    }, CYCLE_INTERVAL_MS);
                    btn.dataset.colorInterval = String(interval);
                }
            });

            btn.addEventListener("mouseleave", () => {
                clearInterval(Number(btn.dataset.colorInterval));
                btn.style.backgroundColor = "";
            });
        });
</script>
