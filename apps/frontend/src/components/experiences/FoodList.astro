---
import WpImage from "../elements/WpImage.astro";
import type { FoodItem } from "../../lib/experience-pages";

interface Props {
    items: FoodItem[];
}

const { items } = Astro.props;
---

<div class="food">
    <ul>
        {
            items.map((item) => (
                <li>
                    {item.image ? (
                        <WpImage
                            image={item.image}
                            width={600}
                            height={750}
                            alt=""
                        />
                    ) : (
                        <div class="thumb-placeholder" aria-hidden="true" />
                    )}
                    <div class="text">
                        <h2 class="name heading-display">{item.name}</h2>
                        {item.locations.length > 0 && (
                            <p class="meta">{item.locations.join(", ")}</p>
                        )}
                        <div
                            class="description section-body"
                            set:html={item.description.html}
                        />
                    </div>
                </li>
            ))
        }
    </ul>
</div>

<style>
    ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    li {
        display: grid;
        gap: var(--space-md);
        padding-block: var(--space-md);
        border-block-start: var(--border);
        align-items: start;
    }

    @media (min-width: 40rem) {
        li {
            grid-template-columns: var(--music-thumb-w) 1fr;
            align-items: start;
        }
    }

    @media (min-width: 64rem) {
        li {
            padding-block: var(--space-lg);
        }
    }

    li :global(img),
    .thumb-placeholder {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 5;
        object-fit: cover;
    }

    @media (min-width: 40rem) {
        li :global(img),
        .thumb-placeholder {
            width: var(--music-thumb-w);
            height: var(--music-thumb-h);
        }
    }

    .thumb-placeholder {
        border: var(--border);
    }

    .text {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        min-width: 0;
    }

    .meta {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-bold);
        color: var(--color-paper);
        line-height: var(--line-height-tight);
    }

    .description {
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
        color: var(--color-paper);
    }
</style>
