---
interface Props {
    video: string;
    title?: string;
    class?: string;
    [key: string]: unknown;
}

const {
    video,
    title = "Project video",
    class: className,
    ...attrs
} = Astro.props;

function getVimeoId(url: string): string | null {
    // Handle formats:
    // https://vimeo.com/123456789
    // https://vimeo.com/channels/channel/123456789
    // https://vimeo.com/groups/group/videos/123456789
    // https://player.vimeo.com/video/123456789
    // 123456789 (raw ID)
    const match = url.match(
        /(?:vimeo\.com\/(?:video\/|channels\/[^/]+\/|groups\/[^/]+\/videos\/)?|^)(\d+)(?:[/?#]|$)/,
    );

    return match ? match[1] : null;
}

const videoId = getVimeoId(video);

const embedUrl = videoId
    ? `https://player.vimeo.com/video/${videoId}?dnt=1&title=0&byline=0&portrait=0`
    : null;
---

<div class:list={["outer", className]} {...attrs}>
    {
        embedUrl ? (
            <iframe
                class="iframe"
                src={embedUrl}
                allow="fullscreen; picture-in-picture"
                allowfullscreen
                title={title}
            />
        ) : (
            <div class="error">
                <p>Invalid Vimeo Video: {video}</p>
            </div>
        )
    }
</div>

<style>
    .outer {
        aspect-ratio: 16 / 9;
        display: grid;
    }

    .iframe {
        border: 0;
        width: 100%;
        height: 100%;
    }

    .error {
        display: grid;
        place-items: center;
    }
</style>
