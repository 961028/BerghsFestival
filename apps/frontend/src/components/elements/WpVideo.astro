---
interface Props {
    video: string;
    title?: string;
    class?: string;
    [key: string]: unknown;
}

const {
    video,
    title = "Project video",
    class: className,
    ...attrs
} = Astro.props;

function getVimeoId(url: string): string | null {
    // Handle formats:
    // https://vimeo.com/123456789
    // https://vimeo.com/channels/channel/123456789
    // https://vimeo.com/groups/group/videos/123456789
    // https://player.vimeo.com/video/123456789
    // 123456789 (raw ID)
    const match = url.match(
        /(?:vimeo\.com\/(?:video\/|channels\/[^/]+\/|groups\/[^/]+\/videos\/)?|^)(\d+)(?:[/?#]|$)/,
    );

    return match ? match[1] : null;
}

const videoId = getVimeoId(video);

const embedUrl = videoId
    ? `https://player.vimeo.com/video/${videoId}?dnt=1&title=0&byline=0&portrait=0&transparent=0`
    : null;
---

{
    embedUrl ? (
        <iframe
            class:list={["iframe", className]}
            src={embedUrl}
            allow="fullscreen; picture-in-picture"
            allowfullscreen
            title={title}
            {...attrs}
        />
    ) : (
        <div class:list={["error", className]} {...attrs}>
            <p>Invalid Vimeo Video: {video}</p>
        </div>
    )
}

<style>
    .iframe {
        border: 0;
        width: 100%;
        aspect-ratio: 16 / 9;
        display: block;
        background: #000;
    }

    .error {
        aspect-ratio: 16 / 9;
        display: grid;
        place-items: center;
        background: #000;
    }
</style>
