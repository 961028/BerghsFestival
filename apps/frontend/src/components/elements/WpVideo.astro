---
interface Props {
    video?: string;
    title?: string;
    class?: string;
    [key: string]: unknown;
}

const {
    video: _video,
    title: _title = "Project video",
    class: className,
    ...attrs
} = Astro.props;

const src = "/temp-video.mp4";
---

<div class:list={["player", className]} data-wp-video {...attrs}>
    <video
        class="video"
        src={src}
        controls
        playsinline
        preload="metadata"
        data-video
    ></video>
    <button
        type="button"
        class="overlay"
        data-toggle
        aria-label="Play video"
    >
        <span class="icon-wrap">
            <span class="glitch-wrap" data-icon-play>
                <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                >
                    <polygon points="6,4 20,12 6,20" fill="currentColor" />
                </svg>
            </span>
        </span>
    </button>
</div>

<script>
    import { attachRgbSplitFilter } from "../../scripts/accents";

    const players = document.querySelectorAll<HTMLElement>("[data-wp-video]");

    players.forEach((wrapper) => {
        const video = wrapper.querySelector<HTMLVideoElement>("[data-video]");
        const button =
            wrapper.querySelector<HTMLButtonElement>("[data-toggle]");

        if (!video || !button) return;

        const playWrap = wrapper.querySelector<HTMLElement>("[data-icon-play]");
        if (playWrap) attachRgbSplitFilter(playWrap, button);

        const sync = () => {
            wrapper.dataset.playing = video.paused ? "false" : "true";
        };

        button.addEventListener("click", () => {
            video.play().catch((err) => {
                console.error("Video play failed", err);
            });
        });

        video.addEventListener("play", sync);
        video.addEventListener("pause", sync);
        video.addEventListener("ended", sync);
        sync();
    });
</script>

<style>
    .player {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        background: var(--color-ink);
    }

    .video {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }

    .overlay {
        position: absolute;
        inset: 0;
        z-index: 1;
        display: grid;
        place-items: center;
        background: transparent;
        border: 0;
        padding: 0;
        margin: 0;
        color: var(--color-paper);
        cursor: pointer;
    }

    .player[data-playing="true"] .overlay {
        display: none;
    }

    .icon-wrap {
        background: var(--color-ink);
        padding: var(--space-xs);
        display: inline-flex;
    }

    .glitch-wrap {
        display: inline-flex;
    }

    .icon {
        width: 4rem;
        height: 4rem;
        display: block;
    }
</style>
