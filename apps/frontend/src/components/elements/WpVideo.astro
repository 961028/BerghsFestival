---
interface Props {
    video: string;
    title?: string;
    class?: string;
    [key: string]: unknown;
}

const {
    video,
    title = "Project video",
    class: className,
    ...attrs
} = Astro.props;

function getVimeoId(url: string): string | null {
    const match = url.match(
        /(?:vimeo\.com\/(?:video\/|channels\/[^/]+\/|groups\/[^/]+\/videos\/)?|^)(\d+)(?:[/?#]|$)/,
    );

    return match ? match[1] : null;
}

const videoId = getVimeoId(video);

const embedUrl = videoId
    ? `https://player.vimeo.com/video/${videoId}?dnt=1&title=0&byline=0&portrait=0&transparent=0&controls=1&autopause=0`
    : null;

const embedUrlNoControls = videoId
    ? `https://player.vimeo.com/video/${videoId}?dnt=1&title=0&byline=0&portrait=0&transparent=0&controls=0&autopause=0`
    : null;

---

{
    embedUrl ? (
        <div
            class:list={["player", className]}
            data-wp-video
            {...attrs}
        >
            <iframe
                class="iframe"
                src={embedUrlNoControls}
                data-src-fallback={embedUrl}
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                title={title}
            />
            <noscript>
                <iframe
                    class="iframe"
                    src={embedUrl}
                    allow="autoplay; fullscreen; picture-in-picture"
                    allowfullscreen
                    title={title}
                />
            </noscript>
            <button
                type="button"
                class="toggle"
                data-toggle
                aria-label="Play video"
            >
                <svg
                    class="icon icon-play"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                >
                    <polygon points="6,4 20,12 6,20" fill="currentColor" />
                </svg>
                <svg
                    class="icon icon-pause"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                >
                    <rect x="6" y="4" width="4" height="16" fill="currentColor" />
                    <rect x="14" y="4" width="4" height="16" fill="currentColor" />
                </svg>
            </button>
        </div>
    ) : (
        <div class:list={["error", className]} {...attrs}>
            <p>Invalid Vimeo Video: {video}</p>
        </div>
    )
}

<script>
    import Player from "@vimeo/player";

    const players = document.querySelectorAll<HTMLElement>("[data-wp-video]");

    players.forEach((wrapper) => {
        const iframe = wrapper.querySelector("iframe");
        const button =
            wrapper.querySelector<HTMLButtonElement>("[data-toggle]");

        if (!iframe || !button) return;

        const player = new Player(iframe);

        player.ready().catch((err) => {
            console.error("Vimeo init failed — restoring native controls", err);
            const fallbackSrc = iframe.getAttribute("data-src-fallback");
            if (fallbackSrc) {
                iframe.setAttribute("src", fallbackSrc);
            }
            button.hidden = true;
        });

        button.addEventListener("click", () => {
            const playing = wrapper.dataset.playing === "true";
            const action = playing ? player.pause() : player.play();
            action.catch((err) => {
                console.error("Vimeo toggle failed", err);
            });
        });

        player.on("play", () => {
            wrapper.dataset.playing = "true";
            button.setAttribute("aria-label", "Pause video");
        });

        player.on("pause", () => {
            wrapper.dataset.playing = "false";
            button.setAttribute("aria-label", "Play video");
        });

        player.on("ended", () => {
            wrapper.dataset.playing = "false";
            button.setAttribute("aria-label", "Play video");
        });
    });
</script>

<style>
    .player {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        background: var(--color-ink);
    }

    .iframe {
        border: 0;
        width: 100%;
        height: 100%;
        display: block;
    }

    .toggle {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        background: transparent;
        border: 0;
        padding: 0;
        margin: 0;
        color: var(--color-paper);
        cursor: pointer;
        transition: opacity 0.2s ease;
    }

    .icon {
        grid-area: 1 / 1;
        width: 4rem;
        height: 4rem;
        display: block;
        transition: transform 0.2s ease;
    }

    .icon-pause {
        display: none;
    }

    .player[data-playing="true"] .icon-play {
        display: none;
    }

    .player[data-playing="true"] .icon-pause {
        display: block;
    }

    .player[data-playing="true"] .toggle {
        opacity: 0;
    }

    .player[data-playing="true"] .toggle:hover,
    .player[data-playing="true"] .toggle:focus-visible {
        opacity: 1;
    }

    .toggle:hover .icon,
    .toggle:focus-visible .icon {
        transform: scale(1.1);
    }

    .error {
        aspect-ratio: 16 / 9;
        display: grid;
        place-items: center;
        background: var(--color-ink);
    }
</style>
