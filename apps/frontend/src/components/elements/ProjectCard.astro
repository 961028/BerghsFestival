---
import { Image } from "astro:assets";

interface Props {
    company: string;
    title?: string;
    image: { url: string } | null;
    teamMembers: { name: string; class: string }[];
    type?: "group" | "individual";
    href?: string;
}

const { company, title, image, teamMembers, href } = Astro.props;

const studentCount = teamMembers.length;

const Tag = href ? "a" : "div";
---

<Tag
    class="project-card"
    {href}
    aria-label={href ? `${company}${title ? ` — ${title}` : ""}` : undefined}
>
    <div class="thumb">
        {image && <Image src={image.url} alt="" loading="lazy" inferSize />}
    </div>

    <div class="meta">
        <p class="company label-caps">{company}</p>
        {title && <p class="title heading-display">{title}</p>}
        {
            studentCount > 0 && (
                <p class="student-count">
                    {studentCount} {studentCount === 1 ? "student" : "students"}
                </p>
            )
        }
    </div>
</Tag>

<style>
    .project-card {
        display: grid;
        gap: var(--space-sm);
        padding-block-end: var(--space-sm);
        color: var(--color-paper);
        text-decoration: none;
    }

    @media (min-width: 64rem) {
        .project-card {
            padding-block-end: var(--space-md);
        }
    }

    .thumb {
        aspect-ratio: 3 / 2;
        overflow: hidden;
        background-color: var(--color-ink);
    }

    .thumb :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .meta {
        display: grid;
        gap: var(--space-xxs);
    }

    .title {
        text-wrap: balance;
    }

    .student-count {
        font-size: var(--font-size-sm);
        letter-spacing: var(--letter-spacing-caps-sm);
        text-transform: uppercase;
    }
</style>
