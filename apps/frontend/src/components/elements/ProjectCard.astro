---
import type { ReferenceDataEntry } from "astro:content";
import WpImage from "./WpImage.astro";

interface Props {
    company: string;
    title: string;
    image: ReferenceDataEntry<"media"> | null;
    teamMembers: { name: string; class: string }[];
    href?: string;
}

const { company, title, image, teamMembers, href } = Astro.props;

const Tag = href ? "a" : "div";
---

<Tag class="project-card" {href}>
    <div>
        {image && <WpImage image={image} alt={title} />}
    </div>

    <div>
        <p>{company}</p>
        <p>{title}</p>
    </div>

    <ul>
        {
            teamMembers.map((member) => (
                <li>
                    <span>{member.name}</span>
                    <span>{member.class}</span>
                </li>
            ))
        }
    </ul>
</Tag>

<style>
    .project-card {
        background: var(--color-accent-1);
        color: var(--color-text);
        display: grid;
        gap: var(--space-xs);
        padding: var(--space-sm);
        width: 100%;
        text-decoration: none;
        isolation: isolate;
    }

    /* thumbnail */
    .project-card > div:first-child {
        aspect-ratio: 3 / 2;
        background-color: color-mix(in oklch, var(--color-accent-1) 40%, #000000);
        overflow: hidden;
    }

    .project-card > div:first-child :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* meta */
    .project-card > div:nth-child(2) {
        padding-block: var(--space-xs);
    }

    .project-card > div:nth-child(2) p:first-child {
        font-size: var(--font-size-xs);
    }

    .project-card > div:nth-child(2) p:last-child {
        font-size: var(--font-size-lg);
        line-height: var(--line-height-tight);
        text-wrap: balance;
    }

    /* members */
    .project-card ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
    }

    .project-card li {
        display: grid;
    }

    .project-card li span:first-child {
        font-size: var(--font-size-base);
    }

    .project-card li span:last-child {
        font-size: var(--font-size-xs);
    }

</style>
