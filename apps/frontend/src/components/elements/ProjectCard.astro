---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Project = CollectionEntry<"projects">["data"];

interface Props {
    project: Project;
}

const { project } = Astro.props;

const { slug, title, company, image, teamMembers } = project;

let label;
if (title && company) {
    label = `${company} — ${title}`;
} else {
    label = title || company;
}

const studentCount = teamMembers.length;
---

<a class="project-card" href={`/projects/${slug}`} aria-label={label}>
    <div class="thumb">
        {image && <Image src={image.url} alt="" loading="lazy" inferSize />}
    </div>

    <div class="meta">
        <p class="company label-caps">{company || title}</p>
        {
            studentCount > 0 && (
                <p class="student-count">
                    {studentCount} {studentCount === 1 ? "student" : "students"}
                </p>
            )
        }
    </div>
</a>

<style>
    .project-card {
        display: grid;
        gap: var(--space-sm);
        padding-block-end: var(--space-sm);
        color: var(--color-paper);
        text-decoration: none;
    }

    @media (min-width: 64rem) {
        .project-card {
            padding-block-end: var(--space-md);
        }
    }

    .thumb {
        aspect-ratio: 3 / 2;
        overflow: hidden;
        background-color: var(--color-ink);
    }

    .thumb :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .meta {
        display: grid;
        gap: var(--space-xxs);
    }

    .title {
        text-wrap: balance;
    }

    .student-count {
        font-size: var(--font-size-sm);
        letter-spacing: var(--letter-spacing-caps-sm);
        text-transform: uppercase;
    }
</style>
