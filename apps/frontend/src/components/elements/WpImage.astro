---
import { Image } from "astro:assets";
import type { ComponentProps } from "astro/types";
import { getEntry } from "astro:content";
import type { ReferenceDataEntry } from "astro:content";

type ImageProps = ComponentProps<typeof Image>;

type Props = Omit<
    ImageProps,
    "src" | "alt" | "inferSize" | "width" | "height" | "densities"
> & {
    image: ReferenceDataEntry<"media">;
    alt?: string;
};

let { image: imageRef, alt, ...attrs } = Astro.props;

const image = await getEntry(imageRef);

if (!image) {
    return;
}

if (image.data.type !== "image") {
    throw new Error(
        `Media ${imageRef.id} type is ${image.data.type}, must be image.`,
    );
}

const explicitAlt = alt !== undefined;
alt ??= image.data.altText;

// No alt text from caller or CMS — treat as decorative.
const isDecorative = !explicitAlt && !alt;
const resolvedAlt = isDecorative ? "" : (alt as string);

const src = image.data.sourceUrl;
const width = image.data.width;
const height = image.data.height;
---

{
    width && height ? (
        <Image src={src} alt={resolvedAlt} aria-hidden={isDecorative || undefined} width={width} height={height} {...attrs} />
    ) : (
        <Image src={src} alt={resolvedAlt} aria-hidden={isDecorative || undefined} inferSize {...attrs} />
    )
}
