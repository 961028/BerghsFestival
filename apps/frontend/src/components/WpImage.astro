---
import { Image } from "astro:assets";
import type { ComponentProps } from "astro/types";
import { getEntry } from "astro:content";

type ImageProps = ComponentProps<typeof Image>;

type Props = Omit<
	ImageProps,
	"src" | "alt" | "inferSize" | "width" | "height" | "densities"
> & {
	image: number;
	alt?: string;
};

let { image: imageId, alt, ...attrs } = Astro.props;

const image = await getEntry("media", String(imageId));

if (!image) {
	return;
}

if (image.data.type !== "image") {
	throw new Error(
		`Media ${imageId} type is ${image.data.type}, must be image.`,
	);
}

alt ??= image.data.altText;

const src = image.data.sourceUrl;
---

<Image src={src} alt={alt} inferSize {...attrs} />
