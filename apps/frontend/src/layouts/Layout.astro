---
import Contact from "../components/site/Contact.astro";
import CtaBanner from "../components/site/CtaBanner.astro";
import Header from "../components/site/Header.astro";
import Iq from "../components/site/Iq.astro";
import Sponsors from "../components/site/Sponsors.astro";
import { getCollection } from "astro:content";

import "../styles/global.css";

type Props = {
    title: string;
    metaTitle?: string;
};

const settings = (await getCollection("settings"))[0].data;

const { title, metaTitle } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{metaTitle ?? `${title} | ${settings.title}`}</title>
    </head>
    <body>
        <div class="wrapper">
            <div data-region="header"><Header /></div>
            <main data-region="main">
                <slot />
            </main>
            <footer data-region="footer">
                <div class="footer-row footer-row--sponsors">
                    <span class="footer-label">Sponsors</span>
                    <Sponsors />
                </div>
                <div class="footer-row footer-row--info">
                    <div class="footer-col">
                        <Iq />
                    </div>
                    <div class="footer-col">
                        <span class="footer-label">Contact</span>
                        <Contact />
                    </div>
                </div>
            </footer>
        </div>
        <CtaBanner />
    </body>
</html>

<script>
    import "../scripts/scramble";
    import { ACCENTS, pickTriple, makeColorPicker, type Triple } from "../scripts/accents";

    // ── Effect A: per-region accent colors ────────────────────────────────────
    // The page is split into three independent regions (header, main, footer).
    // Each region gets its own randomly chosen triple on every page load.
    // To disable this effect entirely, replace the forEach at the bottom with a
    // single setColors call using one fixed triple, or remove it.
    //
    // sessionStorage ensures the primary color never repeats in the same region
    // on consecutive page loads. To allow repeats, remove the sessionStorage
    // calls in assignRegion.
    function prevKey(region: string) {
        return `text-accent-${region}`;
    }

    function assignRegion(region: string): Triple {
        const prev = sessionStorage.getItem(prevKey(region)) ?? "";
        const triple = pickTriple(prev);
        sessionStorage.setItem(prevKey(region), triple.primary);
        return triple;
    }

    // Applies a color triple to a region element. All CSS custom properties
    // that reference color tokens are overridden on the element so that
    // var(--color-accent-1), var(--color-accent-2), var(--color-accent-3), etc.
    // resolve to the correct accent colors inside the region subtree.
    //
    // When applied to the "main" region, also dispatches a "regioncolors" custom
    // event on the element so page-specific scripts (e.g. PageExperiences) can
    // react to each flash and update their own elements in sync.
    // The event detail includes { primary, secondary, tertiary, fourth } where
    // `fourth` is the one ACCENTS color not present in the triple.
    function setColors(
        el: HTMLElement,
        { primary, secondary, tertiary }: Triple,
    ) {
        el.style.setProperty("--color-accent-1", primary);
        el.style.setProperty("--color-accent-2", secondary);
        el.style.setProperty("--color-accent-3", tertiary);
        if (el.dataset["region"] === "main") {
            const fourth = ACCENTS.find(
                (c) => c !== primary && c !== secondary && c !== tertiary,
            )!;
            el.dispatchEvent(
                new CustomEvent("regioncolors", {
                    detail: { primary, secondary, tertiary, fourth },
                    bubbles: true,
                }),
            );
        }
    }

    // ── Effect B: strobe on page load ─────────────────────────────────────────
    // Each region rapidly cycles through random color triples before snapping to
    // its final assigned triple. On every flash, all three colors (primary,
    // secondary, tertiary) change simultaneously and independently.
    //
    // To disable the strobe and just apply the final colors immediately, remove
    // the setTimeout(() => strobe(...)) call in the forEach below and keep only
    // setColors(el, triple).
    //
    // To adjust speed: change `interval` (ms between flashes, min 334ms = 3 Hz).
    // To adjust duration: change `duration` (ms before snapping to final colors).
    function strobe(
        el: HTMLElement,
        finalTriple: Triple,
        duration = 600,
        interval = 50,
    ) {
        setColors(el, finalTriple);

        const nextPrimary = makeColorPicker(2);
        const timer = setInterval(() => {
            const next = pickTriple(nextPrimary());
            setColors(el, next);
        }, interval);

        setTimeout(() => {
            clearInterval(timer);
            setColors(el, finalTriple);
        }, duration);
    }

    // ── Effect C: staggered region strobes ────────────────────────────────────
    // The three regions start their strobes slightly out of phase with each
    // other, so they are never in sync. This creates additional visual chaos.
    // To remove the stagger, set all staggerMs values to 0.
    // To remove per-region independence entirely, apply a single triple to
    // document.documentElement instead of targeting each region separately.
    // Track header height so child components can reference it via CSS
    const headerEl = document.querySelector<HTMLElement>("[data-region='header']");
    if (headerEl) {
        const updateHeaderHeight = () => {
            document.documentElement.style.setProperty(
                "--header-height",
                `${headerEl.offsetHeight}px`,
            );
        };
        updateHeaderHeight();
        new ResizeObserver(updateHeaderHeight).observe(headerEl);
    }

    // Track CTA banner height so body padding-bottom stays in sync
    const ctaEl = document.querySelector<HTMLElement>("[data-region='cta']");
    if (ctaEl) {
        const updateCtaHeight = () => {
            const h = `${ctaEl.offsetHeight}px`;
            document.body.style.setProperty("padding-bottom", h);
            document.documentElement.style.setProperty("--cta-height", h);
        };
        updateCtaHeight();
        new ResizeObserver(updateCtaHeight).observe(ctaEl);
    }

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ── Effect D: continuously cycle selection highlight color ────────────────
    // Safari doesn't repaint ::selection when a CSS custom property changes,
    // so we rewrite a <style> tag with a literal color value each tick instead.
    const selectionStyle = document.createElement("style");
    document.head.appendChild(selectionStyle);
    const selectionTextColor = getComputedStyle(document.documentElement).getPropertyValue("--color-text").trim();
    const nextSelectionColor = makeColorPicker(2);
    if (!reducedMotion) {
        setInterval(() => {
            const color = nextSelectionColor();
            selectionStyle.textContent = `::selection { background: ${color} !important; color: ${selectionTextColor} !important; }`;
        }, 150);
    }

    const regions = ["header", "main", "footer", "cta"] as const;
    const staggerMs = [0, 80, 160, 240];

    regions.forEach((region, i) => {
        const el = document.querySelector<HTMLElement>(
            `[data-region="${region}"]`,
        );
        if (!el) return;

        const triple = assignRegion(region);
        setColors(el, triple); // applied immediately to avoid flash on load

        if (!reducedMotion) {
            setTimeout(() => strobe(el, triple), staggerMs[i]);
        }

        if (region === "cta" && !reducedMotion) {
            setInterval(() => {
                const newTriple = pickTriple(triple.primary);
                strobe(el, newTriple);
            }, 8000);
        }
    });
</script>

<style>
    .wrapper {
        max-width: var(--max-width);
        margin-inline: auto;
        padding-inline: var(--site-padding-inline);
        display: grid;
        grid-template-rows: auto 1fr auto;
        min-height: 100dvh;
    }

    [data-region="header"] {
        border-block-end: var(--border-default);
    }

    main {
        container-type: inline-size;
        padding: 0;
    }

    footer {
        border-block-start: var(--border-default);
        font-size: var(--font-size-base);
    }

    .footer-row {
        padding-block: var(--space-lg);
    }

    .footer-row--sponsors {
        display: grid;
        grid-template-columns: var(--section-label-width) 1fr;
        gap: 0 var(--space-xl);
        align-items: start;
    }

    .footer-row--info {
        border-block-start: var(--border-default);
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
        gap: 1px;
        background: var(--color-border);
        padding-block: 0; /* cells carry their own padding */
    }

    .footer-col {
        display: grid;
        gap: var(--space-sm);
        background: var(--color-bg);
        padding-block: var(--space-lg);
        padding-inline-end: var(--space-lg);
    }
</style>
