---
import Contact from "../components/site/Contact.astro";
import Header from "../components/site/Header.astro";
import Iq from "../components/site/Iq.astro";
import Sponsors from "../components/site/Sponsors.astro";

type Props = {
	title: string;
};

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="wrapper">
			<Header />
			<slot />
			<Sponsors />
			<Iq />
			<Contact />
		</div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	.wrapper {
		max-width: 64rem;
		margin: 0 auto;
	}
</style>
