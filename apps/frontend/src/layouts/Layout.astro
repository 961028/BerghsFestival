---
import Contact from "../components/site/Contact.astro";
import CtaBanner from "../components/site/CtaBanner.astro";
import Header from "../components/site/Header.astro";
import FooterTextBlock from "../components/site/FooterTextBlock.astro";
import Sponsors from "../components/site/Sponsors.astro";
import { getCollection, type ReferenceDataEntry } from "astro:content";

import "../styles/global.css";
import { Font, getImage } from "astro:assets";
import { getEntry } from "astro:content";

type Props = {
    title: string;
    metaDescription?: string;
    ogType?: string;
    ogImage?: ReferenceDataEntry<"media"> | null;
    ctaCompact?: boolean;
};

const settings = (await getCollection("settings"))[0].data;
const seo = (await getCollection("seo"))[0].data;

const { title, ogType, ctaCompact = false } = Astro.props;

const metaTitle = title ? `${title} | ${settings.title}` : settings.title;
const metaDescription =
    Astro.props.metaDescription || seo.metaDescription || settings.description;
const ogImageRef = Astro.props.ogImage || seo.ogImage;

let ogImage;
let ogImageUrl;
if (ogImageRef) {
    const ogImageEntry = await getEntry(ogImageRef);

    if (ogImageEntry) {
        ogImage = await getImage({
            src: ogImageEntry.data.sourceUrl,
            width: 1200,
            height: 630,
            format: "webp",
        });
        ogImageUrl = new URL(ogImage.src, Astro.url).href;
    }
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{metaTitle}</title>
        {
            metaDescription && (
                <meta name="description" content={metaDescription} />
            )
        }
        <meta property="og:title" content={title || settings.title} />
        <meta property="og:type" content={ogType || "article"} />
        <meta property="og:url" content={Astro.url} />
        {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
        {
            ogImage?.attributes.width && (
                <meta
                    property="og:image:width"
                    content={`${ogImage.attributes.width}`}
                />
            )
        }
        {
            ogImage?.attributes.height && (
                <meta
                    property="og:image:height"
                    content={`${ogImage.attributes.height}`}
                />
            )
        }
        {ogImage && <meta property="og:image:type" content={`image/webp`} />}
        <Font cssVariable="--font-inter" />
    </head>
    <body class:list={[{ "has-compact-cta": ctaCompact }]}>
        <a href="#main-content" class="skip-link">Skip to main content</a>
        <a href="#cta" class="skip-link">Skip to apply</a>
        <div class="wrapper">
            <div data-region="header"><Header /></div>
            <!-- tabindex="-1" lets the skip-link target main for focus. -->
            <main id="main-content" data-region="main" tabindex="-1">
                <slot />
            </main>
            <footer data-region="footer" aria-label="Site footer">
                <div class="footer-row footer-row--sponsors">
                    <h2 class="footer-label">Sponsors</h2>
                    <Sponsors />
                </div>
                <div class="footer-row footer-row--info">
                    <div class="footer-col">
                        <FooterTextBlock collection="iq" />
                    </div>
                    <div class="footer-col">
                        <FooterTextBlock collection="photoNotice" />
                    </div>
                </div>
                <div class="footer-row footer-row--contact">
                    <Contact />
                </div>
            </footer>
        </div>
        <CtaBanner compact={ctaCompact} />
    </body>
</html>

<script>
    import "../scripts/scramble";
    import {
        ACCENTS,
        pickTriple,
        makeColorPicker,
        attachRgbSplit,
        attachRgbSplitFilter,
        type Triple,
    } from "../scripts/accents";

    // ── Global link RGB split ─────────────────────────────────────────────────
    // Attach hover effects to all links not already handled by component scripts.
    // nav-link spans → header.ts; sponsor logos → Sponsors.astro; logo → header.ts.
    // Text links get text-shadow split; icon-only links (containing SVG, no text)
    // get drop-shadow filter split applied to the <svg>.
    const EXCLUDED = [
        ".nav-link",        // handled in header.ts
        "nav > a",          // logo link — handled in header.ts
        "[data-sponsors] a",// sponsor links — logos handled separately
    ].join(", ");

    document.querySelectorAll<HTMLAnchorElement>("a").forEach((a) => {
        if (a.matches(EXCLUDED) || a.closest("[data-sponsors]")) return;

        const svg = a.querySelector("svg");
        const hasText = a.textContent?.trim().length ?? 0 > 0;

        if (svg && !hasText) {
            // Icon-only link: apply filter split to the SVG element
            attachRgbSplitFilter(svg);
        } else {
            // Text link (may also contain SVG alongside text)
            attachRgbSplit(a);
        }
    });

    // ── Effect A: per-region accent colors ────────────────────────────────────
    // The page is split into three independent regions (header, main, footer).
    // Each region gets its own randomly chosen triple on every page load.
    // To disable this effect entirely, replace the forEach at the bottom with a
    // single setColors call using one fixed triple, or remove it.
    //
    // sessionStorage ensures the primary color never repeats in the same region
    // on consecutive page loads. To allow repeats, remove the sessionStorage
    // calls in assignRegion.
    function prevKey(region: string) {
        return `text-accent-${region}`;
    }

    function assignRegion(region: string): Triple {
        const prev = sessionStorage.getItem(prevKey(region)) ?? "";
        const triple = pickTriple(prev);
        sessionStorage.setItem(prevKey(region), triple.primary);
        return triple;
    }

    // Applies a color triple to a region element. All CSS custom properties
    // that reference color tokens are overridden on the element so that
    // var(--color-accent-1), var(--color-accent-2), var(--color-accent-3), etc.
    // resolve to the correct accent colors inside the region subtree.
    //
    // When applied to the "main" region, also dispatches a "regioncolors" custom
    // event on the element so page-specific scripts can react to each flash
    // and update their own elements in sync.
    // The event detail includes { primary, secondary, tertiary, fourth } where
    // `fourth` is the one ACCENTS color not present in the triple.
    function setColors(
        el: HTMLElement,
        { primary, secondary, tertiary }: Triple,
    ) {
        el.style.setProperty("--color-accent-1", primary);
        el.style.setProperty("--color-accent-2", secondary);
        el.style.setProperty("--color-accent-3", tertiary);
        if (el.dataset["region"] === "main") {
            const fourth = ACCENTS.find(
                (c) => c !== primary && c !== secondary && c !== tertiary,
            )!;
            el.dispatchEvent(
                new CustomEvent("regioncolors", {
                    detail: { primary, secondary, tertiary, fourth },
                    bubbles: true,
                }),
            );
        }
    }

    // ── Effect B: strobe on page load ─────────────────────────────────────────
    // Each region rapidly cycles through random color triples before snapping to
    // its final assigned triple. On every flash, all three colors (primary,
    // secondary, tertiary) change simultaneously and independently.
    //
    // To disable the strobe and just apply the final colors immediately, remove
    // the setTimeout(() => strobe(...)) call in the forEach below and keep only
    // setColors(el, triple).
    //
    // To adjust speed: change `interval` (ms between flashes, min 334ms = 3 Hz).
    // To adjust duration: change `duration` (ms before snapping to final colors).
    function strobe(
        el: HTMLElement,
        finalTriple: Triple,
        duration = 600,
        interval = 50,
    ) {
        setColors(el, finalTriple);

        const nextPrimary = makeColorPicker(2);
        const timer = setInterval(() => {
            const next = pickTriple(nextPrimary());
            setColors(el, next);
        }, interval);

        setTimeout(() => {
            clearInterval(timer);
            setColors(el, finalTriple);
        }, duration);
    }

    // ── Effect C: staggered region strobes ────────────────────────────────────
    // The three regions start their strobes slightly out of phase with each
    // other, so they are never in sync. This creates additional visual chaos.
    // To remove the stagger, set all staggerMs values to 0.
    // To remove per-region independence entirely, apply a single triple to
    // document.documentElement instead of targeting each region separately.

    const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    // ── Effect D: continuously cycle selection highlight color ────────────────
    // Safari doesn't repaint ::selection when a CSS custom property changes,
    // so we rewrite a <style> tag with a literal color value each tick instead.
    const selectionStyle = document.createElement("style");
    document.head.appendChild(selectionStyle);
    const selectionTextColor = getComputedStyle(document.documentElement)
        .getPropertyValue("--color-ink")
        .trim();
    const nextSelectionColor = makeColorPicker(2);
    if (!reducedMotion) {
        setInterval(() => {
            const color = nextSelectionColor();
            selectionStyle.textContent = `::selection { background: ${color} !important; color: ${selectionTextColor} !important; }`;
        }, 150);
    }

    const regions = ["header", "main", "footer", "cta"] as const;
    const staggerMs = [0, 80, 160, 240];

    regions.forEach((region, i) => {
        const el = document.querySelector<HTMLElement>(
            `[data-region="${region}"]`,
        );
        if (!el) return;

        const triple = assignRegion(region);
        setColors(el, triple); // applied immediately to avoid flash on load

        if (!reducedMotion) {
            setTimeout(() => strobe(el, triple), staggerMs[i]);
        }

        if (region === "cta" && !reducedMotion) {
            setInterval(() => {
                const newTriple = pickTriple(triple.primary);
                strobe(el, newTriple);
            }, 8000);
        }
    });
</script>

<style>
    .skip-link {
        position: fixed;
        top: var(--space-sm);
        left: var(--space-sm);
        z-index: 9999;
        padding: var(--space-xs) var(--space-sm);
        background: var(--color-paper);
        color: var(--color-ink);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-bold);
        letter-spacing: var(--letter-spacing-caps-sm);
        text-transform: uppercase;
        text-decoration: none;
        /* Visually hidden but readable by screen readers.
           Do NOT use overflow:hidden or width/height:1px — those suppress AT. */
        clip-path: inset(50%);
        white-space: nowrap;
    }

    .skip-link:focus-visible {
        clip-path: none;
        white-space: normal;
        outline: max(2px, 0.15em) solid currentColor;
        outline-offset: 0.15em;
    }

    .wrapper {
        max-width: var(--max-width);
        margin-inline: auto;
        padding-inline: var(--site-padding-inline);
        display: grid;
        grid-template-rows: auto 1fr auto;
        min-height: 100dvh;
    }

    [data-region="header"] {
        border-block-end: var(--border);
        position: sticky;
        top: -1px;
        padding-block-start: 1px;
        z-index: 100;
        background: var(--color-ink);
    }

    main {
        padding: 0;
        padding-block-end: var(--space-xl);
    }

    footer {
        border-block-start: var(--border);
        font-size: var(--font-size-base);
    }

    .footer-row {
        padding-block: var(--space-lg);
    }

    .footer-row--sponsors {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-md);
    }

    .footer-row--sponsors .footer-label {
        align-self: flex-start;
    }

    .footer-row--contact {
        border-block-start: var(--border);
    }

    .footer-row--info {
        border-block-start: var(--border);
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
        gap: 1px;
        background: var(--color-paper);
        padding-block: 0; /* cells carry their own padding */
    }

    .footer-col {
        display: grid;
        align-content: start;
        gap: var(--space-sm);
        background: var(--color-ink);
        padding-block: var(--space-lg);
    }

    /* Add inner padding when footer cols are side by side.
       34.5625rem = 2 × 16rem + 1px gap + 2 × 1.25rem site padding (mobile). */
    @media (min-width: 34.5625rem) {
        .footer-col:first-child {
            padding-inline-end: var(--space-lg);
        }

        .footer-col:last-child {
            padding-inline-start: var(--space-lg);
        }
    }
</style>
