---
import Contact from "../components/site/Contact.astro";
import Header from "../components/site/Header.astro";
import Iq from "../components/site/Iq.astro";
import Sponsors from "../components/site/Sponsors.astro";
import { getCollection } from "astro:content";

import "../styles/global.css";

type Props = {
    title: string;
};

const settings = (await getCollection("settings"))[0].data;

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{title} | {settings.title}</title>
    </head>
    <body>
        <div class="wrapper">
            <Header />

            <main>
                <slot />
            </main>

            <footer class="site-footer">
                <Sponsors />
                <Iq />
                <Contact />
            </footer>
        </div>
    </body>
</html>

<style>
    .wrapper {
        max-width: var(--max-width);
        margin: 0 auto;
    }

    main {
        padding: var(--space-xl) var(--site-padding-inline);
    }

    .site-footer {
        border-top: var(--border-default);
        padding: var(--space-lg) var(--site-padding-inline);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-md);
        font-size: var(--font-size-lg);
    }
</style>
