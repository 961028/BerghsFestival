---
import { getCollection } from "astro:content";

import { resolvePageLink } from "../lib/content";

import Page from "../templates/Page.astro";

export async function getStaticPaths() {
    const settings = (await getCollection("settings"))[0].data;

    const pages = await getCollection("pages");

    return await Promise.all(
        pages
            .filter((page) => page.id !== settings.homePage.id)
            .map(async (page) => ({
                params: { link: await resolvePageLink(page) },
                props: {
                    page,
                },
            })),
    );
}

const { page } = Astro.props;
---

<Page page={page} />
