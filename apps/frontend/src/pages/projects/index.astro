---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/elements/ProjectCard.astro";
import { getProjectsPage } from "../../lib/experience-pages";

const allProjects = (await getCollection("projects")).map(
    (entry) => entry.data,
);

const projectsPage = await getProjectsPage();
const title = projectsPage?.data.title ?? "Projects";
const metaDescription = projectsPage?.data.metaDescription;
const ogImage = projectsPage?.data.image;
const description = projectsPage?.data.content;
---

<Layout title={title} metaDescription={metaDescription} ogImage={ogImage} ctaCompact>
    <h1 class="page-title" data-scramble>{title}</h1>

    <section>
        {description && (
            <div class="section-body intro" set:html={description.html} />
        )}

        <div>
            <button data-filter="all" aria-pressed="true">All Projects</button>
            <button data-filter="group" aria-pressed="false">Group</button>
            <button data-filter="individual" aria-pressed="false">Individual</button>
        </div>

        <ul>
            {
                allProjects.map((project) => (
                    <li data-type={project.type}>
                        <ProjectCard
                            company={project.company}
                            title={project.title}
                            image={project.image}
                            teamMembers={project.teamMembers}
                            href={`/projects/${project.slug}`}
                        />
                    </li>
                ))
            }
        </ul>
    </section>
</Layout>

<script>
    const buttons =
        document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const items = document.querySelectorAll<HTMLLIElement>("ul li");

    buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
            buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
            btn.setAttribute("aria-pressed", "true");

            const filterType = btn.dataset.filter;
            items.forEach((item) => {
                const show =
                    filterType === "all" || item.dataset.type === filterType;
                item.hidden = !show;
            });
        });
    });
</script>

<style>
    section {
        padding-block-end: var(--space-xl);
    }

    .intro {
        margin-block-end: var(--space-xl);
    }

    div {
        display: flex;
        gap: var(--space-xs);
        margin-block-end: var(--space-sm);
    }

    [data-filter] {
        background: none;
        border: none;
        padding: var(--space-xs) var(--space-sm);
        font-size: var(--font-size-base);
        font-family: inherit;
        color: inherit;
        cursor: pointer;
    }

    [data-filter][aria-pressed="true"] {
        background-color: var(--color-accent-3);
        color: var(--color-ink);
    }

    @media (any-hover: hover) and (any-pointer: fine) {
        [data-filter]:not([aria-pressed="true"]):hover {
            background-color: var(--color-accent-3);
            color: var(--color-ink);
        }
    }

    ul {
        --col-min: 20rem;
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(
            auto-fill,
            minmax(min(100%, var(--col-min)), 1fr)
        );
        gap: var(--space-sm);
    }

    li[hidden] {
        display: none;
    }
</style>
