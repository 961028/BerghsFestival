---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/elements/ProjectCard.astro";

const projects = (await getCollection("projects")).map((entry) => entry.data);
---

<Layout title="Projects">
    <div class="filters">
        <button class="filter-btn active" data-filter="all">All Projects</button>
        <button class="filter-btn" data-filter="group">Group</button>
        <button class="filter-btn" data-filter="individual">Individual</button>
    </div>

    <ul class="list">
        {
            projects.map((project) => (
                <li data-team-size={project.teamMembers.length > 1 ? "group" : "individual"}>
                    <ProjectCard
                        company={project.company}
                        title={project.title}
                        image={project.image}
                        teamMembers={project.teamMembers}
                        href={`/projects/${project.slug}`}
                    />
                </li>
            ))
        }
    </ul>
</Layout>

<script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const items = document.querySelectorAll<HTMLLIElement>(".list li");

    buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
            buttons.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");

            const filter = btn.dataset.filter;
            items.forEach((item) => {
                const show = filter === "all" || item.dataset.teamSize === filter;
                item.hidden = !show;
            });
        });
    });
</script>

<style>
    .filters {
        display: flex;
        gap: var(--space-xs);
        margin-bottom: var(--space-sm);
    }

    .filter-btn {
        background: none;
        border: var(--border-default);
        padding: var(--space-xs) var(--space-sm);
        cursor: pointer;
        color: var(--color-text);
        font-size: var(--font-size-base);
        font-family: inherit;
    }

    .filter-btn.active {
        background-color: var(--color-text);
        color: var(--color-bg);
    }

    @media (any-hover: hover) and (any-pointer: fine) {
        .filter-btn:not(.active):hover {
            opacity: 0.6;
        }
    }

    .list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
        gap: var(--space-sm);
    }

    .list li[hidden] {
        display: none;
    }
</style>
