---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/elements/ProjectCard.astro";

const projects = (await getCollection("projects")).map((entry) => entry.data);
---

<Layout title="Projects">
    <div>
        <button data-filter="all" aria-pressed="true">All Projects</button>
        <button data-filter="group" aria-pressed="false">Group</button>
        <button data-filter="individual" aria-pressed="false">Individual</button>
    </div>

    <ul>
        {
            projects.map((project) => (
                <li data-team-size={project.teamMembers.length > 1 ? "group" : "individual"}>
                    <ProjectCard
                        company={project.company}
                        title={project.title}
                        image={project.image}
                        teamMembers={project.teamMembers}
                        href={`/projects/${project.slug}`}
                    />
                </li>
            ))
        }
    </ul>
</Layout>

<script>
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const items = document.querySelectorAll<HTMLLIElement>("ul li");

    buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
            buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
            btn.setAttribute("aria-pressed", "true");

            const filter = btn.dataset.filter;
            items.forEach((item) => {
                const show = filter === "all" || item.dataset.teamSize === filter;
                item.hidden = !show;
            });
        });
    });
</script>

<style>
    div {
        display: flex;
        gap: var(--space-xs);
        margin-block-end: var(--space-sm);
    }

    [data-filter] {
        background: none;
        border: none;
        padding: var(--space-xs) var(--space-sm);
        font-size: var(--font-size-base);
        font-family: inherit;
        color: inherit;
        cursor: pointer;
    }

    [data-filter][aria-pressed="true"] {
        background-color: var(--color-accent-3);
        color: var(--color-text);
    }

    @media (any-hover: hover) and (any-pointer: fine) {
        [data-filter]:not([aria-pressed="true"]):hover {
            background-color: var(--color-accent-3);
            color: var(--color-text);
        }
    }

    ul {
        --col-min: 20rem;
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--col-min)), 1fr));
        gap: var(--space-sm);
    }

    li[hidden] {
        display: none;
    }
</style>
