---
import { getCollection } from "astro:content";

import WpImage from "../../components/elements/WpImage.astro";
import WpVideo from "../../components/elements/WpVideo.astro";
import ProjectCard from "../../components/elements/ProjectCard.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => ({
        params: { slug: project.data.slug },
        props: {
            project: project.data,
            allProjects: projects.map((p) => p.data),
        },
    }));
}

const { project, allProjects } = Astro.props;

const {
    slug,
    title,
    metaDescription,
    image,
    company,
    teamMembers,
    contentSections,
    video,
} = project;

const relatedProjects = allProjects
    .filter((p) => p.slug !== slug)
    .sort(() => Math.random() - 0.5)
    .slice(0, 3);
---

<Layout title={title} metaDescription={metaDescription} ogImage={image}>
    <article class="project">
        <header class="project-hero">
            {
                video ? (
                    <WpVideo video={video} title={`${title} — case film`} />
                ) : (
                    image && (
                        <WpImage image={image} loading="eager" alt={title} />
                    )
                )
            }
        </header>

        <div class="project-body">
            <h1 class="project-company">{company}</h1>

            {
                contentSections.map((section, i) => (
                    <section
                        class="project-section"
                        aria-labelledby={`project-section-${i}`}
                    >
                        <h2 id={`project-section-${i}`}>{section.title}</h2>
                        <div set:html={section.content.html} />
                    </section>
                ))
            }

            {
                teamMembers.length > 0 && (
                    <section class="project-credits" aria-labelledby="project-credits-heading">
                        <h2 id="project-credits-heading">Contributors</h2>
                        <ul class="project-team">
                            {teamMembers.map((member) => (
                                <li>
                                    <span class="team-class">
                                        {member.class}
                                    </span>
                                    <span class="team-name">{member.name}</span>
                                </li>
                            ))}
                        </ul>
                    </section>
                )
            }
        </div>
    </article>

    <ul class="related-projects">
        {
            relatedProjects.map((related) => (
                <li>
                    <ProjectCard
                        company={related.company}
                        image={related.image}
                        teamMembers={related.teamMembers}
                        href={`/projects/${related.slug}`}
                    />
                </li>
            ))
        }
    </ul>
</Layout>

<style>
    .project-hero {
        margin-block-start: var(--space-xl);
        margin-block-end: var(--space-md);
    }

    .project-hero :global(img) {
        width: 100%;
        height: auto;
        display: block;
    }

    .project-body {
        max-width: 60rem;
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }

    .project-company {
        line-height: var(--line-height-tight);
    }

    .project-section h2 {
        margin-block-end: var(--space-sm);
    }

    .project-credits {
        text-align: center;
        margin-block-start: var(--space-xl);
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
    }

    .project-team {
        list-style: none;
        padding: 0;
        margin: 0 auto;
        max-width: 40rem;
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
    }

    .project-team li {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: var(--space-sm);
        align-items: baseline;
    }

    .team-class {
        text-align: right;
    }

    .team-name {
        text-align: left;
        font-weight: var(--font-weight-bold);
    }

    .related-projects {
        --col-min: 16rem;
        list-style: none;
        margin-block-start: calc(var(--space-xl) * 2);
        padding: 0;
        display: grid;
        grid-template-columns: repeat(
            auto-fill,
            minmax(min(100%, var(--col-min)), 1fr)
        );
        gap: var(--space-sm);
    }
</style>
