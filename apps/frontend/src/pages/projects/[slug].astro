---
import { getCollection } from "astro:content";

import WpImage from "../../components/elements/WpImage.astro";
import WpVideo from "../../components/elements/WpVideo.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => ({
        params: { slug: project.data.slug },
        props: { project: project.data },
    }));
}

const { project } = Astro.props;
---

<Layout title={project.title}>
    <article class="article">
        {
            !project.image || (
                <WpImage class="image" image={project.image} loading="eager" />
            )
        }

        <div class="meta">
            <div class="company">{project.company}</div>
            <h1 class="page-title">{project.title}</h1>

            <ul class="team-members">
                {
                    project.teamMembers.map((teamMember) => (
                        <li class="team-member">
                            <div class="team-member__name">{teamMember.name}</div>
                            <div class="team-member__class">{teamMember.class}</div>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div class="content">
            {
                project.contentSections.map((contentSection) => (
                    <>
                        <h2 class="content-title">{contentSection.title}</h2>

                        <div
                            class="content-wrapper"
                            set:html={contentSection.content.html}
                        />
                    </>
                ))
            }
        </div>

        {!project.video || <WpVideo class="video" video={project.video} />}
    </article>
</Layout>

<style>
    .image,
    .video {
        display: block;
        max-width: 100%;
        height: auto;
    }
</style>
