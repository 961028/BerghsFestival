---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import ProjectCard from "../../components/elements/ProjectCard.astro";
import Layout from "../../layouts/Layout.astro";
import { classLabel } from "../../lib/projects";
import ExternalVideo from "../../components/elements/ExternalVideo.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => ({
        params: { slug: project.data.slug },
        props: {
            project: project.data,
            allProjects: projects.map((p) => p.data),
        },
    }));
}

const { project, allProjects } = Astro.props;

const {
    slug,
    title,
    metaDescription,
    image,
    company,
    teamMembers,
    contentSections,
    video,
} = project;

const relatedProjects = allProjects
    .filter((p) => p.slug !== slug)
    .sort(() => Math.random() - 0.5)
    .slice(0, 3);
---

<Layout title={title} metaDescription={metaDescription}>
    <article class="project">
        <header class="project-hero">
            {
                video ? (
                    <ExternalVideo
                        videoSrc={video}
                        posterSrc={image?.url}
                        title={`${title} — case film`}
                    />
                ) : (
                    image && (
                        <Image
                            src={image.url}
                            alt={title}
                            loading="eager"
                            inferSize
                        />
                    )
                )
            }
        </header>

        <div class="project-body">
            <header class="project-heading">
                <h1 class="project-title">{title}</h1>
                {company && <p class="project-company">{company}</p>}
            </header>

            {
                contentSections
                    .filter((section) => section.content.html)
                    .map((section, i) => (
                        <section
                            class="project-section"
                            aria-labelledby={`project-section-${i}`}
                        >
                            <h2 id={`project-section-${i}`}>{section.title}</h2>
                            <div set:html={section.content.html} />
                        </section>
                    ))
            }

            {
                teamMembers.length > 0 && (
                    <section
                        class="project-credits"
                        aria-labelledby="project-credits-heading"
                    >
                        <h2 id="project-credits-heading">Contributors</h2>
                        <ul class="project-team">
                            {teamMembers.map((member) => (
                                <li>
                                    <span class="team-class">
                                        {classLabel(member.class)}
                                    </span>
                                    <span class="team-name">{member.name}</span>
                                </li>
                            ))}
                        </ul>
                    </section>
                )
            }
        </div>
    </article>

    <ul class="related-projects">
        {
            relatedProjects.map((related) => (
                <li>
                    <ProjectCard
                        company={related.company}
                        image={related.image}
                        teamMembers={related.teamMembers}
                        href={`/projects/${related.slug}`}
                    />
                </li>
            ))
        }
    </ul>
</Layout>

<style>
    .project-hero {
        margin-block-start: var(--space-xl);
        margin-block-end: var(--space-md);
    }

    .project-hero :global(img) {
        width: 100%;
        height: auto;
        display: block;
    }

    .project-body {
        max-width: 60rem;
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
    }

    .project-heading {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
    }

    .project-title {
        line-height: var(--line-height-tight);
    }

    .project-company {
        margin: 0;
    }

    .project-section h2 {
        margin-block-end: var(--space-sm);
    }

    .project-credits {
        text-align: center;
        margin-block-start: var(--space-xl);
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
    }

    .project-team {
        list-style: none;
        padding: 0;
        margin: 0 auto;
        max-width: 40rem;
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
    }

    .project-team li {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: var(--space-sm);
        align-items: baseline;
    }

    .team-class {
        text-align: right;
    }

    .team-name {
        text-align: left;
        font-weight: var(--font-weight-bold);
    }

    .related-projects {
        --col-min: 16rem;
        list-style: none;
        margin-block-start: calc(var(--space-xl) * 2);
        padding: 0;
        display: grid;
        grid-template-columns: repeat(
            auto-fill,
            minmax(min(100%, var(--col-min)), 1fr)
        );
        gap: var(--space-sm);
    }
</style>
