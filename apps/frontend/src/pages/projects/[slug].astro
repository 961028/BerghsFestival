---
import { getCollection } from "astro:content";

import WpImage from "../../components/elements/WpImage.astro";
import WpVideo from "../../components/elements/WpVideo.astro";
import ProjectCard from "../../components/elements/ProjectCard.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => ({
        params: { slug: project.data.slug },
        props: {
            project: project.data,
            allProjects: projects.map((p) => p.data),
        },
    }));
}

const { project, allProjects } = Astro.props;

const relatedProjects = allProjects
    .filter((p) => p.slug !== project.slug)
    .sort(() => Math.random() - 0.5)
    .slice(0, 3);
---

<Layout title={project.title}>
    <article>
        {
            !project.image || (
                <div class="project-hero">
                    <WpImage
                        image={project.image}
                        loading="eager"
                        alt={project.title}
                    />
                </div>
            )
        }

        <div class="project-body">
            <div>
                <div>{project.company}</div>
                <h1 class="page-title">{project.title}</h1>

                <ul>
                    {
                        project.teamMembers.map((teamMember) => (
                            <li>
                                <div>{teamMember.name}</div>
                                <div>{teamMember.class}</div>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div>
                {
                    project.contentSections.map((contentSection) => (
                        <>
                            <h2>{contentSection.title}</h2>
                            <div set:html={contentSection.content.html} />
                        </>
                    ))
                }
            </div>
        </div>

        {!project.video || <WpVideo video={project.video} />}
    </article>

    <ul class="related-projects">
        {
            relatedProjects.map((related) => (
                <li>
                    <ProjectCard
                        company={related.company}
                        title={related.title}
                        image={related.image}
                        teamMembers={related.teamMembers}
                        href={`/projects/${related.slug}`}
                    />
                </li>
            ))
        }
    </ul>
</Layout>

<style>
    /* hero */
    .project-hero {
        aspect-ratio: 3 / 2;
        overflow: hidden;
    }

    .project-hero :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* video */
    article :global(.outer) {
        width: 100%;
    }

    /* body */
    .project-body {
        --body-col-min: 18rem;
        display: grid;
        grid-template-columns: repeat(
            auto-fit,
            minmax(min(100%, var(--body-col-min)), 1fr)
        );
        gap: var(--space-sm);
    }

    /* related */
    .related-projects {
        --col-min: 16rem;
        list-style: none;
        margin-block-start: var(--space-sm);
        padding: 0;
        display: grid;
        grid-template-columns: repeat(
            auto-fill,
            minmax(min(100%, var(--col-min)), 1fr)
        );
        gap: var(--space-sm);
    }
</style>
